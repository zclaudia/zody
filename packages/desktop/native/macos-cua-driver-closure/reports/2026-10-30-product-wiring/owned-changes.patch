+    // owner.revoke 成功会同步触发 onRevocation→scope.invalidate(owner-revoked)，随后可能再来
+    // 一次同 ref 的幂等 revoke。已发生的同 owner revoked 事实必须如实返回，避免 adapter 把
+    // 成功清理误报成 authority_revoke_failed。
+    if (
+      result.status === "revoked" &&
