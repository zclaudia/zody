+function cString(value) {
+  let escaped = "";
+  for (const character of String(value)) {
+    const code = character.codePointAt(0);
+    switch (character) {
+      case "\\":
+        escaped += "\\\\";
+        break;
+      case '"':
+        escaped += '\\"';
+        break;
+      case "\n":
+        escaped += "\\n";
+        break;
+      case "\r":
+        escaped += "\\r";
+        break;
+      case "\t":
+        escaped += "\\t";
+        break;
+      default:
+        if (code < 0x20 || code > 0x7e) {
+          throw new ProductWiringBuildError(
+            "pin-encoding",
+            "pin values must stay printable ASCII",
+            {
+              value,
+            },
+          );
+        }
+        escaped += character;
+    }
+  }
+  return escaped;
+}
