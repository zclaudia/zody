+  };
+  for (const name of r11Names) {
+    await verifyBaseline(`round11/src/${name}`, join(r11Src, name));
+  }
+  for (const name of r10Names) {
+    await verifyBaseline(`r10/src/${name}`, join(r10Src, name));
+  }
