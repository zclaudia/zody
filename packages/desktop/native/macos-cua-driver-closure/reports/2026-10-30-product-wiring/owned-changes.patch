+async function readEvents(path: string): Promise<LoggedEvent[]> {
+  try {
+    const text = await readFile(path, "utf8");
+    return text
+      .split("\n")
+      .filter((line) => line.length > 0)
+      .map((line) => JSON.parse(line) as LoggedEvent);
+  } catch {
+    return [];
+  }
