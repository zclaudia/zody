+/** shutdown 是不可恢复的 owner 撤销，不能走 normal close 语义。 */
+export function invalidateCuaSubmissionTurnScopeOnDispose(this: AgentRuntimeInternal): void {
+  this.cuaSubmissionTurnScope?.invalidate("owner-revoked");
