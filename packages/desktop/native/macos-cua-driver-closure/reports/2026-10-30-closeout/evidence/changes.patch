+    chunks.push(buffer.subarray(0, bytesRead));
+    total += bytesRead;
+    if (total > maxBytes) {
+      throw new Error("cua_node_repl_server_size_out_of_bounds");
+    }
+  }
+  return Buffer.concat(chunks, total);
+}
