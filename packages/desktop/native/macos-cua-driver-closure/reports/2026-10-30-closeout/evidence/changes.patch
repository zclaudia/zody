+    label: "cua-narrow Helper executable",
+    expectedIdentifier: PINNED_HELPER_IDENTIFIER,
+    expectedDesignatedRequirement: pins.designatedRequirement,
+    expectedLeafSha256: pins.leafSha256,
+    expectedLeafSha1: pins.leafSha1,
+    deps,
