+      async (buffer) => {
+        const { bytesRead } = await handle.read(buffer, 0, buffer.length, null);
+        return bytesRead;
+      },
+      maxBytes,
+    );
+    if (bytes.length === 0) {
+      throw new Error("cua_node_repl_server_size_out_of_bounds");
+    }
