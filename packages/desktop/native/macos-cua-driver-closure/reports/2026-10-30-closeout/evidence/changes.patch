+      "cua-narrow Helper Info.plist is not the fixed desktop-session assembly",
+      {
+        bundleIdentifier: info.CFBundleIdentifier,
+        executable: info.CFBundleExecutable,
+        minimumMacOSVersion: info.LSMinimumSystemVersion,
+      },
+    );
+  }
