+            CompletionOutcome::DroppedCanceled
+        );
+        assert_eq!(coordinator.in_flight(), 2);
+        assert_eq!(
+            coordinator.release_callback(first.id()),
+            CallbackReleaseOutcome::Released
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        assert!(coordinator.reserve(expected()).is_ok());
+    }
+
+    #[test]
