+//! Pure link/start probe. This program never enumerates a window or captures.
+
+use cua_macos_visual::{
+    native_bridge_link_diagnostic, request_window_capture, CaptureRequest, VisualError,
+    WindowBounds,
+};
+
+fn main() {
+    let diagnostic = native_bridge_link_diagnostic();
+    assert_eq!(diagnostic, "cua-macos-visual/r9-swift-completion");
+    let request = CaptureRequest::new(11, 4242, 0, WindowBounds::new(100.0, 580.0, 500.0, 500.0));
+    assert_eq!(
+        request_window_capture(&request),
+        Err(VisualError::HostNotApproved)
+    );
+    println!("diagnostic={diagnostic}");
+    println!("public_capture=HostNotApproved");
+    println!("native_capture_invoked=false");
+}
