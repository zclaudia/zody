+
+    fn reserved(coordinator: &CaptureCoordinator) -> CaptureObservation {
+        coordinator.reserve(expected()).expect("reserve")
+    }
+
+    #[test]
+    fn cancel_before_admission_never_starts_capture_and_releases_on_callback() {
+        let coordinator = CaptureCoordinator::new(2);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        observation.cancel();
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Canceled
