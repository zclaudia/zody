+        assert_eq!(raw.dimensions.width, 2);
+        assert_eq!(raw.dimensions.height, 3);
+        assert_eq!(raw.rgba.len(), 24);
+        coordinator.release_callback(id);
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn bad_payload_error_is_terminal_and_releases_on_payload_released() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        let completion = NativeCompletion {
+            status: CompletionStatus::Success,
+            facts: Some(expected()),
+            dimensions: Some(PixelDimensions {
+                width: 2,
+                height: 2,
+            }),
+            rgba: vec![0; 15],
+            payload_error: None,
+        };
+        assert_eq!(
+            coordinator.complete(id, completion),
+            CompletionOutcome::Delivered
+        );
+        coordinator.release_callback(id);
+        assert!(matches!(
+            observation.wait(),
+            Err(VisualError::RgbaLengthMismatch { .. })
+        ));
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn wait_is_one_shot_and_final_check_observes_late_cancel() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        assert_eq!(
+            coordinator.complete(id, success_completion(2, 2)),
+            CompletionOutcome::Delivered
+        );
+        observation.wait().expect("first consume");
+        assert_eq!(observation.wait(), Err(VisualError::CaptureAlreadyConsumed));
+        observation.cancel();
+        assert_eq!(observation.ensure_open(), Err(VisualError::CaptureCanceled));
+        coordinator.release_callback(id);
+    }
+
+    #[test]
+    fn release_before_completion_is_a_terminal_protocol_error() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        assert_eq!(
+            coordinator.release_callback(id),
+            CallbackReleaseOutcome::Released
+        );
+        assert!(matches!(
+            observation.wait(),
+            Err(VisualError::NativeCapture(_))
+        ));
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn duplicate_admission_is_rejected_without_releasing_the_first_capture() {
+        // 竞态依据：框架重复 enumeration callback 不能第二次进入 admission，
+        // 也不能因为第二个 Rejected 提前结束仍在途的第一次 capture。Rust 侧
+        // 用 phase 拒绝重复 admission，slot 仍由第一个 completion 的
+        // payload_released 释放。
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Rejected
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(
+            coordinator.complete(id, success_completion(1, 1)),
+            CompletionOutcome::Delivered
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(observation.wait().expect("first completion").rgba.len(), 4);
+        assert_eq!(
+            coordinator.release_callback(id),
+            CallbackReleaseOutcome::Released
+        );
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn cancel_handle_wakes_a_thread_blocked_in_wait_and_keeps_the_slot() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        let cancel = observation.cancel_handle();
+        let coordinator_for_waiter = coordinator.clone();
+        let barrier = Arc::new(Barrier::new(2));
+        let waiter_barrier = Arc::clone(&barrier);
+        let waiter = thread::spawn(move || {
+            waiter_barrier.wait();
+            observation.wait()
+        });
+
+        barrier.wait();
+        let mut spins = 0_u32;
+        while coordinator_for_waiter.waiters(id) == 0 {
+            assert!(spins < 100_000, "wait did not become blocked");
+            spins += 1;
+            thread::yield_now();
+        }
+        cancel.cancel();
+        assert_eq!(
+            waiter.join().expect("wait thread"),
+            Err(VisualError::CaptureCanceled)
+        );
+
+        // Cancellation wakes the receiver but does not release in-flight
+        // capacity; only the Swift payload_released notification may do that.
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(
+            coordinator.complete(id, success_completion(1, 1)),
+            CompletionOutcome::DroppedCanceled
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        coordinator.release_callback(id);
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+}
