+                log.borrow_mut().push("final-check");
+                if canceled.get() {
+                    Err(VisualError::CaptureCanceled)
+                } else {
+                    Ok(())
+                }
+            },
+        );
+        assert_eq!(result, Err(VisualError::CaptureCanceled));
+        assert_eq!(
+            log.into_inner(),
+            vec!["after", "encode", "final-check"],
+            "final delivery check must run after PNG encoding"
+        );
+    }
 }
