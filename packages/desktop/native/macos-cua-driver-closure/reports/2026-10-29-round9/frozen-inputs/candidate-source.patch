index 0000000..2d2070d
--- /dev/null
+++ b/crates/cua-macos-visual-link-probe/build.rs
@@ -0,0 +1,113 @@
+//! Final-consumer link closure for the Swift visual bridge.
+//!
+//! This crate owns its Swift autolink search path and `/usr/lib/swift` runtime
+//! rpath. It does not rely on an rlib to carry either. The build fails unless
+//! the consumer is compiled for the fixed macOS 14.2 deployment target. The
+//! final link is pinned to the same installed SDK that compiled the Swift
+//! object, so the Mach-O `sdk` field is real evidence rather than host default.
+
+use std::env;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+const SDK_SELECTOR: &str = "macosx27.0";
+const DEPLOYMENT_TARGET: &str = "14.2";
+
+fn main() {
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-env-changed=DEVELOPER_DIR");
+    println!("cargo:rerun-if-env-changed=TOOLCHAINS");
+    println!("cargo:rerun-if-env-changed=MACOSX_DEPLOYMENT_TARGET");
+
+    if env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("macos") {
+        return;
+    }
+    let deployment = env::var("MACOSX_DEPLOYMENT_TARGET").unwrap_or_default();
+    if deployment != DEPLOYMENT_TARGET {
+        panic!(
+            "cua-macos-visual-link-probe requires MACOSX_DEPLOYMENT_TARGET={DEPLOYMENT_TARGET}, got {deployment:?}; run from this crate directory so .cargo/config.toml applies"
+        );
+    }
+    match env::var("CARGO_CFG_TARGET_ARCH").as_deref() {
+        Ok("aarch64") | Ok("x86_64") => {}
+        other => panic!("unsupported probe target architecture: {other:?}"),
+    }
+
+    let compiler = parse_xcrun(&["--find", "swiftc"], "swiftc");
+    let sdk = parse_xcrun(&["--sdk", SDK_SELECTOR, "--show-sdk-path"], "SDK");
+    if !sdk.is_dir() {
+        panic!("xcrun returned a non-directory SDK path: {}", sdk.display());
+    }
+    if swift_lib_dir_from_compiler(&compiler).is_none() {
+        panic!(
+            "xcrun returned {}, which is not <toolchain>/usr/bin/swiftc",
+            compiler.display()
+        );
+    }
+    // The Swift object's real LC_LINKER_OPTION entries reference swiftCore,
+    // swift_Concurrency, swiftMetal and other system overlays, and carry no
+    // libswiftCompatibility56/Packs force-load. Resolve those entries from the
+    // same explicitly selected SDK used for the Swift compile.
+    let sdk_swift_lib = sdk.join("usr/lib/swift");
+    if !sdk_swift_lib.join("libswiftCore.tbd").is_file() {
+        panic!(
+            "{} does not contain the Swift autolink stubs used by the bridge",
+            sdk_swift_lib.display()
+        );
+    }
+
+    println!("cargo:rustc-link-search=native={}", sdk_swift_lib.display());
+    println!("cargo:rustc-link-arg=-Wl,-rpath,/usr/lib/swift");
+    // The consumer explicitly links against the same selected SDK as the
+    // Swift object instead of relying on the host's default SDK.
+    println!("cargo:rustc-link-arg=-Wl,-syslibroot,{}", sdk.display());
+}
+
+fn parse_xcrun(arguments: &[&str], label: &str) -> PathBuf {
+    let output = Command::new("/usr/bin/xcrun")
+        .args(arguments)
+        .output()
+        .unwrap_or_else(|error| panic!("failed to run /usr/bin/xcrun: {error}"));
+    if !output.status.success() {
+        panic!(
+            "/usr/bin/xcrun {arguments:?} failed with {}: {}",
+            output.status,
+            String::from_utf8_lossy(&output.stderr)
+        );
+    }
+    parse_single_path(&output.stdout)
+        .unwrap_or_else(|error| panic!("invalid xcrun {label} output: {error}"))
+}
+
+fn parse_single_path(stdout: &[u8]) -> Result<PathBuf, &'static str> {
+    let value = std::str::from_utf8(stdout).map_err(|_| "output is not UTF-8")?;
+    let value = value.trim();
+    if value.is_empty() {
+        return Err("output is empty");
+    }
+    let mut lines = value.lines();
+    let line = lines.next().ok_or("output is empty")?;
+    if lines.next().is_some() {
+        return Err("output contains more than one line");
+    }
+    let path = Path::new(line);
+    if !path.is_absolute() {
+        return Err("path is not absolute");
+    }
+    Ok(path.to_path_buf())
+}
+
+fn swift_lib_dir_from_compiler(compiler: &Path) -> Option<PathBuf> {
+    if !compiler.is_absolute() || compiler.file_name()? != "swiftc" {
+        return None;
+    }
+    let bin = compiler.parent()?;
+    if bin.file_name()? != "bin" {
+        return None;
+    }
+    let usr = bin.parent()?;
+    if usr.file_name()? != "usr" {
+        return None;
+    }
+    Some(usr.join("lib/swift/macosx"))
+}
