+                            assert_eq!(running.claim_actuator(), Err("native_process_quarantined"));
+                            assert_eq!(pending.start_worker(), Err("native_process_quarantined"));
+                            let receipt = crate::sealed_native::execute(running);
+                            assert_eq!(receipt.report().objects_created, 0);
