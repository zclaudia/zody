new file mode 100644
index 0000000..70b7212
--- /dev/null
+++ b/crates/cua-macos-visual/src/error.rs
@@ -0,0 +1,160 @@
+//! Errors raised by the narrow visual observation crate.
+
+use std::fmt;
+
+/// Stage at which a window identity was re-derived.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DriftStage {
+    /// CGWindowList facts read immediately before the SCK request.
+    BeforeCapture,
+    /// The exact window selected out of SCShareableContent.
+    SelectedWindow,
+    /// CGWindowList facts read again after the SCK frame was returned.
+    AfterCapture,
+}
+
+impl fmt::Display for DriftStage {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::BeforeCapture => f.write_str("before capture"),
+            Self::SelectedWindow => f.write_str("selected SCK window"),
+            Self::AfterCapture => f.write_str("after capture"),
+        }
+    }
+}
+
+/// Failure modes for pure validation and the crate-private native path.
+#[derive(Debug, Clone, PartialEq)]
+pub enum VisualError {
+    /// No trusted Helper approval integration owns this observation yet.
+    HostNotApproved,
+    /// The internal observer closed result reception before completion.
+    ///
+    /// This is not a native stop, fence, drain or process-exit assertion.
+    CaptureCanceled,
+    /// The one-shot observation result was already consumed.
+    CaptureAlreadyConsumed,
+    /// The bounded in-flight table has no free native-callback slot.
+    CaptureCapacityExhausted { limit: usize },
+    /// The request is structurally unusable before any native call.
+    InvalidRequest(&'static str),
+    /// A raw CGWindowList fact is missing or cannot be represented exactly.
+    InvalidWindowFact { field: &'static str },
+    /// An identity is internally invalid even when compared with itself.
+    InvalidIdentity { field: &'static str },
+    /// WindowServer no longer lists the requested CGWindowID.
+    WindowNotFound { window_id: u32 },
+    /// PID, layer, bounds or window id changed at the given stage.
+    WindowDrift { window_id: u32, stage: DriftStage },
+    /// Capture pixels are not a coherent 1x/2x representation of the bounds.
+    FrameMismatch {
+        window_id: u32,
+        bounds_width: f64,
+        bounds_height: f64,
+        capture_width: u32,
+        capture_height: u32,
+        scale_x: f64,
+        scale_y: f64,
+    },
+    /// A side or the aggregate pixel budget was exceeded.
+    PixelBudgetExceeded {
+        width: u32,
+        height: u32,
+        pixels: u64,
+        max_pixels: u64,
+    },
+    /// A raw extent was zero, non-finite or outside the configured side limit.
+    DimensionRejected { label: &'static str, value: f64 },
+    /// RGBA byte length does not equal width*height*4.
+    RgbaLengthMismatch {
+        width: u32,
+        height: u32,
+        expected: u64,
+        actual: u64,
+    },
+    /// PNG parsing or encoding failed.
+    PngEncoding(String),
+    /// Encoded PNG dimensions do not match the capture dimensions.
+    PngMismatch {
+        expected_width: u32,
+        expected_height: u32,
+        actual_width: u32,
+        actual_height: u32,
+    },
+    /// A native CG/SCK call failed or returned facts we refuse.
+    NativeCapture(String),
+}
+
+impl fmt::Display for VisualError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::HostNotApproved => f.write_str("capture requires a trusted Helper approval"),
+            Self::CaptureCanceled => f.write_str("capture observation closed"),
+            Self::CaptureAlreadyConsumed => {
+                f.write_str("capture observation result already consumed")
+            }
+            Self::CaptureCapacityExhausted { limit } => {
+                write!(f, "capture in-flight capacity {limit} is exhausted")
+            }
+            Self::InvalidRequest(reason) => write!(f, "invalid capture request: {reason}"),
+            Self::InvalidWindowFact { field } => {
+                write!(f, "invalid CGWindowList fact: {field}")
+            }
+            Self::InvalidIdentity { field } => write!(f, "invalid window identity: {field}"),
+            Self::WindowNotFound { window_id } => {
+                write!(f, "WindowServer does not list window id {window_id}")
+            }
+            Self::WindowDrift { window_id, stage } => {
+                write!(f, "window id {window_id} changed identity {stage}")
+            }
+            Self::FrameMismatch {
+                window_id,
+                bounds_width,
+                bounds_height,
+                capture_width,
+                capture_height,
+                scale_x,
+                scale_y,
+            } => write!(
+                f,
+                "window id {window_id}: capture {capture_width}x{capture_height} is not a 1x/2x \
+                 match for bounds {bounds_width}x{bounds_height} (scale {scale_x:.4}/{scale_y:.4})"
+            ),
+            Self::PixelBudgetExceeded {
+                width,
+                height,
+                pixels,
+                max_pixels,
+            } => write!(
+                f,
+                "capture {width}x{height} needs {pixels} pixels, over the {max_pixels} pixel budget"
+            ),
+            Self::DimensionRejected { label, value } => {
+                write!(f, "rejected capture {label}: {value}")
+            }
+            Self::RgbaLengthMismatch {
+                width,
+                height,
+                expected,
+                actual,
+            } => write!(
+                f,
+                "RGBA byte length {actual} != {width}*{height}*4 ({expected})"
+            ),
+            Self::PngEncoding(reason) => write!(f, "PNG failure: {reason}"),
+            Self::PngMismatch {
+                expected_width,
+                expected_height,
+                actual_width,
+                actual_height,
+            } => write!(
+                f,
+                "encoded PNG is {actual_width}x{actual_height}, expected \
+                 {expected_width}x{expected_height}"
+            ),
+            Self::NativeCapture(reason) => write!(f, "native capture failure: {reason}"),
+        }
+    }
+}
+
+impl std::error::Error for VisualError {}
diff --git b/crates/cua-macos-visual/src/geometry.rs b/crates/cua-macos-visual/src/geometry.rs
new file mode 100644
index 0000000..ffab80e
--- /dev/null
+++ b/crates/cua-macos-visual/src/geometry.rs
@@ -0,0 +1,390 @@
+//! Pure window geometry, identity, raw-fact parsing and request validation.
+
+use crate::error::{DriftStage, VisualError};
+
+/// Hard per-side ceiling for one observation.
+pub const MAX_CAPTURE_SIDE: u32 = 8192;
+/// Aggregate pixel ceiling for one observation (128 MiB of RGBA).
+///
+/// 旧的单边 16384 上限允许 16384x16384，即 1 GiB RGBA。这里同时约束
+/// 单边和总像素，避免只检查单边仍能放大分配。
+pub const MAX_CAPTURE_PIXELS: u64 = 33_554_432;
+/// Aggregate RGBA byte ceiling derived from [`MAX_CAPTURE_PIXELS`].
+pub const MAX_RGBA_BYTES: u64 = MAX_CAPTURE_PIXELS * 4;
+
+/// WindowServer bounds in logical points.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct WindowBounds {
+    pub x: f64,
+    pub y: f64,
+    pub width: f64,
+    pub height: f64,
+}
+
+impl WindowBounds {
+    pub const fn new(x: f64, y: f64, width: f64, height: f64) -> Self {
+        Self {
+            x,
+            y,
+            width,
+            height,
+        }
+    }
+
+    /// A frame is usable only when every component is finite and it has area.
+    pub fn is_usable(&self) -> bool {
+        self.x.is_finite()
+            && self.y.is_finite()
+            && self.width.is_finite()
+            && self.height.is_finite()
+            && self.width > 0.0
+            && self.height > 0.0
+    }
+
+    fn same_bits(&self, other: &Self) -> bool {
+        self.x.to_bits() == other.x.to_bits()
+            && self.y.to_bits() == other.y.to_bits()
+            && self.width.to_bits() == other.width.to_bits()
+            && self.height.to_bits() == other.height.to_bits()
+    }
+}
+
+/// One observation's exact WindowServer identity.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct WindowIdentity {
+    pub window_id: u32,
+    pub pid: i32,
+    pub layer: i32,
+    pub bounds: WindowBounds,
+}
+
+impl WindowIdentity {
+    pub const fn new(window_id: u32, pid: i32, layer: i32, bounds: WindowBounds) -> Self {
+        Self {
+            window_id,
+            pid,
+            layer,
+            bounds,
+        }
+    }
+}
+
+/// Raw values read from one CGWindowList dictionary before validation.
+///
+/// Every field stays optional so a missing key is a refusal rather than a
+/// fabricated `0`. Parsing this struct never touches CoreFoundation or the OS;
+/// the native reader limits its query to on-screen windows, but this parser
+/// cannot independently prove visibility.
+#[derive(Debug, Clone, Copy, PartialEq, Default)]
+pub(crate) struct RawWindowFact {
+    pub window_id: Option<i64>,
+    pub pid: Option<i64>,
+    pub layer: Option<i64>,
+    pub x: Option<f64>,
+    pub y: Option<f64>,
+    pub width: Option<f64>,
+    pub height: Option<f64>,
+}
+
+/// Convert a raw window number to a nonzero `u32`; overflow is not truncated.
+pub(crate) fn checked_window_id(value: Option<i64>) -> Option<u32> {
+    value
+        .and_then(|value| u32::try_from(value).ok())
+        .filter(|window_id| *window_id != 0)
+}
+
+/// Parse one exact layer-0 on-screen window fact.
+///
+/// Missing, non-finite, non-positive or out-of-range fields fail. This round
+/// does not support off-Space, minimized or accessory/overlay windows. The
+/// native reader queries only on-screen windows; this pure parser does not
+/// prove visibility and never treats a missing fact as a valid default.
+pub(crate) fn parse_window_identity(raw: &RawWindowFact) -> Result<WindowIdentity, VisualError> {
+    let window_id = checked_window_id(raw.window_id)
+        .ok_or(VisualError::InvalidWindowFact { field: "window_id" })?;
+    let pid = raw
+        .pid
+        .and_then(|value| i32::try_from(value).ok())
+        .filter(|pid| *pid > 0)
+        .ok_or(VisualError::InvalidWindowFact { field: "pid" })?;
+    let layer = raw
+        .layer
+        .and_then(|value| i32::try_from(value).ok())
+        .filter(|layer| *layer == 0)
+        .ok_or(VisualError::InvalidWindowFact { field: "layer" })?;
+    let x = required_finite(raw.x, "x")?;
+    let y = required_finite(raw.y, "y")?;
+    let width = required_positive(raw.width, "width")?;
+    let height = required_positive(raw.height, "height")?;
+    Ok(WindowIdentity::new(
+        window_id,
+        pid,
+        layer,
+        WindowBounds::new(x, y, width, height),
+    ))
+}
+
+fn required_finite(value: Option<f64>, field: &'static str) -> Result<f64, VisualError> {
+    value
+        .filter(|value| value.is_finite())
+        .ok_or(VisualError::InvalidWindowFact { field })
+}
+
+fn required_positive(value: Option<f64>, field: &'static str) -> Result<f64, VisualError> {
+    required_finite(value, field).and_then(|value| {
+        if value > 0.0 {
+            Ok(value)
+        } else {
+            Err(VisualError::InvalidWindowFact { field })
+        }
+    })
+}
+
+/// Validate an identity even when it will be compared with itself.
+pub(crate) fn validate_window_identity(identity: &WindowIdentity) -> Result<(), VisualError> {
+    if identity.window_id == 0 {
+        return Err(VisualError::InvalidIdentity { field: "window_id" });
+    }
+    if identity.pid <= 0 {
+        return Err(VisualError::InvalidIdentity { field: "pid" });
+    }
+    if identity.layer != 0 {
+        return Err(VisualError::InvalidIdentity { field: "layer" });
+    }
+    if !identity.bounds.is_usable() {
+        return Err(VisualError::InvalidIdentity { field: "bounds" });
+    }
+    Ok(())
+}
+
+/// Validated pixel dimensions.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct PixelDimensions {
+    pub width: u32,
+    pub height: u32,
+}
+
+/// Validate one pixel extent and the aggregate budget.
+pub fn checked_pixel_dimensions(width: u32, height: u32) -> Result<PixelDimensions, VisualError> {
+    if width == 0 || height == 0 {
+        return Err(VisualError::DimensionRejected {
+            label: "pixel dimensions",
+            value: 0.0,
+        });
+    }
+    if width > MAX_CAPTURE_SIDE || height > MAX_CAPTURE_SIDE {
+        return Err(VisualError::DimensionRejected {
+            label: "pixel side",
+            value: f64::from(width.max(height)),
+        });
+    }
+    let pixels = u64::from(width) * u64::from(height);
+    if pixels > MAX_CAPTURE_PIXELS {
+        return Err(VisualError::PixelBudgetExceeded {
+            width,
+            height,
+            pixels,
+            max_pixels: MAX_CAPTURE_PIXELS,
+        });
+    }
+    Ok(PixelDimensions { width, height })
+}
+
+/// Round a positive finite point/pixel extent into the side limit.
+pub fn checked_pixel_extent(value: f64, label: &'static str) -> Result<u32, VisualError> {
+    if !value.is_finite() || value <= 0.0 {
+        return Err(VisualError::DimensionRejected { label, value });
+    }
+    let rounded = value.round();
+    if rounded < 1.0 || rounded > f64::from(MAX_CAPTURE_SIDE) {
+        return Err(VisualError::DimensionRejected {
+            label,
+            value: rounded,
+        });
+    }
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+    Ok(rounded as u32)
+}
+
+/// Check that an RGBA buffer exactly matches width*height*4 and the budget.
+pub fn checked_rgba_len(width: u32, height: u32, actual: usize) -> Result<u64, VisualError> {
+    let dims = checked_pixel_dimensions(width, height)?;
+    let expected = u64::from(dims.width) * u64::from(dims.height) * 4;
+    if actual as u64 != expected {
+        return Err(VisualError::RgbaLengthMismatch {
+            width,
+            height,
+            expected,
+            actual: actual as u64,
+        });
+    }
+    Ok(expected)
+}
+
+/// Validate that capture pixels and bounds describe one 1x/2x frame.
+pub fn validate_capture_frame(
+    window_id: u32,
+    bounds: &WindowBounds,
+    capture_px_w: u32,
+    capture_px_h: u32,
+) -> Result<f64, VisualError> {
+    if !bounds.is_usable() {
+        return Err(VisualError::WindowNotFound { window_id });
+    }
+    checked_pixel_dimensions(capture_px_w, capture_px_h)?;
+    let scale_x = f64::from(capture_px_w) / bounds.width;
+    let scale_y = f64::from(capture_px_h) / bounds.height;
+    let nearest = if (scale_x - 1.0).abs() <= (scale_x - 2.0).abs() {
+        1.0
+    } else {
+        2.0
+    };
+    let coherent = scale_x.is_finite()
+        && scale_y.is_finite()
+        && (scale_x - scale_y).abs() <= 0.03
+        && (scale_x - nearest).abs() <= 0.03
+        && (scale_y - nearest).abs() <= 0.03;
+    if coherent {
+        Ok(nearest)
+    } else {
+        Err(VisualError::FrameMismatch {
+            window_id,
+            bounds_width: bounds.width,
+            bounds_height: bounds.height,
+            capture_width: capture_px_w,
+            capture_height: capture_px_h,
+            scale_x,
+            scale_y,
+        })
+    }
+}
+
+/// Reject any PID, layer, bounds or window-id change. No reselection.
+///
+/// Values are validated before comparison, so two identical invalid identities
+/// are refused, and bounds compare by IEEE bit pattern rather than `==`
+/// (notably `0.0` vs `-0.0`).
+pub fn validate_identity(
+    expected: &WindowIdentity,
+    actual: &WindowIdentity,
+    stage: DriftStage,
+) -> Result<(), VisualError> {
+    validate_window_identity(expected)?;
+    validate_window_identity(actual)?;
+    if expected.window_id != actual.window_id
+        || expected.pid != actual.pid
+        || expected.layer != actual.layer
+        || !expected.bounds.same_bits(&actual.bounds)
+    {
+        return Err(VisualError::WindowDrift {
+            window_id: expected.window_id,
+            stage,
+        });
+    }
+    Ok(())
+}
+
+/// One exact window observation request. No permission is carried here.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct CaptureRequest {
+    pub window_id: u32,
+    pub expected_pid: i32,
+    pub expected_layer: i32,
+    pub expected_bounds: WindowBounds,
+}
+
+impl CaptureRequest {
+    pub const fn new(
+        window_id: u32,
+        expected_pid: i32,
+        expected_layer: i32,
+        expected_bounds: WindowBounds,
+    ) -> Self {
+        Self {
+            window_id,
+            expected_pid,
+            expected_layer,
+            expected_bounds,
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), VisualError> {
+        if self.window_id == 0 {
+            return Err(VisualError::InvalidRequest(
+                "window_id must not be the CG null window id",
+            ));
+        }
+        if self.expected_pid <= 0 {
+            return Err(VisualError::InvalidRequest(
+                "expected_pid must be a positive process id",
+            ));
+        }
+        if self.expected_layer != 0 {
+            return Err(VisualError::InvalidRequest(
+                "only layer-0 on-screen windows are supported in this round",
+            ));
+        }
+        if !self.expected_bounds.is_usable() {
+            return Err(VisualError::InvalidRequest(
+                "expected bounds must be finite, positive and have area",
+            ));
+        }
+        Ok(())
+    }
+
+    pub fn expected_identity(&self) -> WindowIdentity {
+        WindowIdentity::new(
+            self.window_id,
+            self.expected_pid,
+            self.expected_layer,
+            self.expected_bounds,
+        )
+    }
+}
+
+/// A successful observation is only formed with non-empty encoded bytes.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CapturedFrame {
+    window_id: u32,
+    dimensions: PixelDimensions,
+    png: Vec<u8>,
+}
+
+impl CapturedFrame {
+    pub(crate) fn new(
+        window_id: u32,
+        dimensions: PixelDimensions,
+        png: Vec<u8>,
+    ) -> Result<Self, VisualError> {
+        if png.is_empty() {
+            return Err(VisualError::InvalidRequest(
+                "refusing to form an empty successful capture",
+            ));
+        }
+        Ok(Self {
+            window_id,
+            dimensions,
+            png,
+        })
+    }
+
+    pub fn window_id(&self) -> u32 {
+        self.window_id
+    }
+
+    pub fn width(&self) -> u32 {
+        self.dimensions.width
+    }
+
+    pub fn height(&self) -> u32 {
+        self.dimensions.height
+    }
+
+    pub fn png(&self) -> &[u8] {
+        &self.png
+    }
+
+    pub fn into_png(self) -> Vec<u8> {
+        self.png
+    }
+}
