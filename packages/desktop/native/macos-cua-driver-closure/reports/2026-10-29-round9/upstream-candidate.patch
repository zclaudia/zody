diff --git b/crates/platform-macos/src/zody_dev_no_input.rs b/crates/platform-macos/src/zody_dev_no_input.rs
new file mode 100644
index 0000000..23f6642
--- /dev/null
+++ b/crates/platform-macos/src/zody_dev_no_input.rs
@@ -0,0 +1,61 @@
+//! Development-only hook before original body; actual tool recursion uses the same ToolState.
+use async_trait::async_trait;
+use cua_driver_core::{
+    protocol::ToolResult,
+    tool::{
+        derive_native_child, scope_native_child, take_native_worker, ChildEdge,
+        NativeWorkerCapability,
+    },
+};
+use serde_json::Value;
+use std::sync::Arc;
+#[async_trait]
+pub trait DevelopmentRunner: Send + Sync {
+    async fn run(&self, cap: NativeWorkerCapability) -> ToolResult;
+    fn mode(&self) -> Mode;
+}
+#[derive(Clone, Copy)]
+pub enum Mode {
+    Leaf,
+    ClickChild,
+    DragRecursion,
+    PanicBeforeWorker,
+}
+tokio::task_local! {static RUNNER:Arc<dyn DevelopmentRunner>;}
+pub async fn with_runner<F: std::future::Future>(r: Arc<dyn DevelopmentRunner>, f: F) -> F::Output {
+    RUNNER.scope(r, f).await
+}
+pub async fn dispatch(name: &str, args: Value, state: Arc<crate::tools::ToolState>) -> ToolResult {
+    let Ok(r) = RUNNER.try_with(Arc::clone) else {
+        return ToolResult::error("development_runner_required");
+    };
+    // Only first entry derives; a child takes the leaf worker capability.
+    let depth = crate::tools::development_capability_depth();
+    let edge = match (r.mode(), name, depth) {
+        (Mode::ClickChild, "click", 0) => Some(ChildEdge::ClickLeaf),
+        (Mode::DragRecursion, "drag", 0) => Some(ChildEdge::DragRecursion),
+        _ => None,
+    };
+    if let Some(edge) = edge {
+        let child = match derive_native_child(edge, name, &args) {
+            Ok(c) => c,
+            Err(e) => return e,
+        };
+        return match Box::pin(scope_native_child(
+            child,
+            crate::tools::development_invoke_native_leaf(name, args, state),
+        ))
+        .await
+        {
+            Ok(out) => out,
+            Err(e) => e,
+        };
+    }
+    if matches!(r.mode(), Mode::PanicBeforeWorker) {
+        panic!("synthetic platform entry panic before worker take");
+    }
+    match take_native_worker(name, &args) {
+        Ok(cap) => r.run(cap).await,
+        Err(e) => e,
+    }
+}
