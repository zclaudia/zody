+fn plan(cap: &NativeWorkerCapability) -> Result<Vec<Step>, &'static str> {
+    let a = cap.arguments();
+    if a["delivery_mode"].as_str() != Some("foreground") {
+        return Err("unsupported_delivery");
+    }
+    let number = |k: &str| {
+        a[k].as_f64()
+            .filter(|v| v.is_finite())
+            .ok_or("invalid_coordinate")
+    };
+    let point = if cap.name() == "drag" {
+        [number("from_x")?, number("from_y")?]
+    } else {
+        [number("x")?, number("y")?]
+    };
+    let mut out = vec![];
+    let mut held = vec![];
+    if let Some(m) = a.get("modifier") {
+        for value in m.as_array().ok_or("unsupported_modifier")? {
+            let k = value
+                .as_str()
+                .filter(|k| modifier(k).is_some())
+                .ok_or("unsupported_modifier")?;
+            if !held.iter().any(|v| v == k) {
+                held.push(k.to_owned());
+                out.push(Step {
+                    kind: Kind::ModifierDown(k.into()),
+                    point,
+                    flags: flags(&held),
+                    delta: [0, 0],
+                });
+            }
+        }
+    }
+    let mut push = |kind, p, delta| {
+        out.push(Step {
+            kind,
+            point: p,
+            flags: flags(&held),
+            delta,
+        })
+    };
+    match cap.name() {
+        "click" => {
+            if a.get("count").is_some_and(|v| v.as_u64() != Some(1))
+                || a.get("button").is_some_and(|v| v.as_str() != Some("left"))
+            {
+                return Err("unsupported_click");
+            }
+            push(Kind::Move, point, [0, 0]);
+            push(Kind::Down, point, [0, 0]);
+        }
+        "drag" => {
+            let to = [number("to_x")?, number("to_y")?];
+            for (k, p) in foreground_drag_plan(point, to, 4) {
+                let kind = match k.as_str() {
+                    "Move" => Kind::Move,
+                    "Down" => Kind::Down,
+                    "Dragged" => Kind::Dragged,
+                    "Up" => continue,
+                    _ => return Err("unsupported_drag"),
+                };
+                push(kind, p, [0, 0]);
+            }
+        }
+        "scroll" => {
+            if a["by"].as_str() != Some("line") {
+                return Err("unsupported_scroll_unit");
+            }
+            let ticks = a["amount"]
+                .as_u64()
+                .filter(|v| *v > 0 && *v <= 5)
+                .ok_or("unsupported_scroll_amount")?;
+            // Explicit candidate convention, not an assertion of upstream/product scroll units.
+            let delta = match a["direction"].as_str() {
+                Some("down") => [-1, 0],
+                Some("up") => [1, 0],
+                Some("left") => [0, 1],
+                Some("right") => [0, -1],
+                _ => return Err("unsupported_direction"),
+            };
+            for _ in 0..ticks {
+                push(Kind::Tick, point, delta);
+            }
+        }
+        _ => return Err("unsupported_tool"),
+    }
+    Ok(out)
+}
+fn arm(ledger: &mut Ledger, step: &Step) {
+    ledger.last = step.point;
+    match &step.kind {
+        Kind::Down => ledger.button = true,
+        Kind::ModifierDown(k) => ledger.modifiers.push(k.clone()),
+        _ => {}
+    }
+}
+fn rollback(ledger: &mut Ledger, step: &Step) {
+    match &step.kind {
+        Kind::Down => ledger.button = false,
+        Kind::ModifierDown(_) => {
+            ledger.modifiers.pop();
+        }
+        _ => {}
+    }
+}
+// Creation and dispatch have separate fences. No lock is held over a port call or real sleep.
+fn send(
+    cap: &NativeWorkerCapability,
+    b: &dyn Boundary,
+    binding: &Binding,
+    source: &CGEventSource,
+    step: &Step,
+    n: usize,
+    release: bool,
+    ledger: &mut Ledger,
+    guard: &mut Guard,
+    r: &mut Report,
+) -> Result<(), &'static str> {
+    if !release {
+        cap.reserve_event().map_err(|_| "cancelled")?;
+    }
+    checkpoint(b, Phase::BeforeCreate, n, release).map_err(|_| "creation_checkpoint_failed")?;
+    window_fence(guard, b, Phase::BeforeCreate, n, release)?;
+    guard.point(step.point, release)?;
+    if !release && !cap.active() {
+        return Err("cancelled");
+    }
+    let event = create(source, step, b, n, release).map_err(|_| "native_creation_failed")?;
+    r.objects_created += 1;
+    checkpoint(b, Phase::AfterCreate, n, release).map_err(|_| "after_creation_failed")?;
+    checkpoint(b, Phase::BeforeDispatch, n, release).map_err(|_| "before_dispatch_failed")?;
+    window_fence(guard, b, Phase::BeforeDispatch, n, release)?;
+    if !release && !cap.active() {
+        return Err("cancelled");
+    }
+    // 修复依据：post 可 panic/unknown；派发前记可能 down，只有明确 NotSent 才回滚。
+    let prior_point = ledger.last;
+    if !release {
+        arm(ledger, step);
+    }
+    r.dispatch_attempts += 1;
+    let obs = observe(&event, step, cap, n, release);
+    ledger.in_flight += 1;
+    let posted = catch_unwind(AssertUnwindSafe(|| {
+        binding.handoff(b, &event, &obs, guard, cap)
+    }))
+    .unwrap_or(Err(Failure::Unknown));
+    ledger.in_flight -= 1;
+    if posted == Err(Failure::NotSent) {
+        if !release {
+            rollback(ledger, step);
+            // 明确未派发的 move/drag 不得改变释放位置；否则 mouse-up 会带来额外位移。
+            ledger.last = prior_point;
+        }
+        return Err("dispatch_not_sent");
+    }
+    if posted.is_err() {
+        return Err("dispatch_unknown");
+    }
+    checkpoint(b, Phase::AfterDispatch, n, release).map_err(|_| "after_dispatch_unknown")?;
+    Ok(())
+}
+fn delay(
+    cap: &NativeWorkerCapability,
+    b: &dyn Boundary,
+    n: usize,
+    guard: &mut Guard,
+    r: &mut Report,
+) -> Result<(), &'static str> {
+    checkpoint(b, Phase::DelayBefore, n, false).map_err(|_| "delay_fault")?;
+    window_fence(guard, b, Phase::DelayBefore, n, false)?;
+    for _ in 0..2 {
+        window_fence(guard, b, Phase::DelaySlice, n, false)?;
+        if !cap.active() {
+            return Err("cancelled");
+        }
+        let start = Instant::now();
+        std::thread::sleep(Duration::from_millis(2));
+        r.slept_micros += start.elapsed().as_micros();
+        r.delay_slices += 1;
+        checkpoint(b, Phase::DelaySlice, n, false).map_err(|_| "delay_fault")?;
+        window_fence(guard, b, Phase::DelaySlice, n, false)?;
+        if !cap.active() {
+            return Err("cancelled");
+        }
+    }
+    Ok(())
+}
+/// Capability must already have started on the actual blocking closure. The caller consumes it to finish.
+fn execute_inner(
+    cap: &NativeWorkerCapability,
+    b: &dyn Boundary,
+    scenario: Option<Scenario>,
+) -> Report {
+    let mut r = Report {
+        action: cap.action_id(),
+        window_guard: None,
+        ledger_verified: false,
+        cancelled: false,
+        error: None,
+        cleanup_debt: vec![],
+        objects_created: 0,
+        dispatch_attempts: 0,
+        delay_slices: 0,
+        slept_micros: 0,
+    };
+    if crate::native_capability::process_quarantined() {
+        r.error = Some("native_process_quarantined".into());
+        r.cancelled = true;
+        return r;
+    }
+    if cap.claim_actuator().is_err() {
+        r.error = Some("actuator_already_claimed_or_not_running".into());
+        return r;
+    }
+    let steps = match plan(cap) {
+        Ok(v) => v,
+        Err(e) => {
+            r.error = Some(e.into());
+            return r;
+        }
+    };
+    if !cap.active() {
+        r.cancelled = true;
+        r.error = Some("cancelled".into());
+        return r;
+    }
+    let required = steps.len()
+        + steps
+            .iter()
+            .filter(|s| matches!(s.kind, Kind::ModifierDown(_) | Kind::Down))
+            .count();
+    if required > 64 {
+        r.error = Some("full_event_budget_exceeded".into());
+        return r;
+    }
+    let binding = match Binding::bind() {
+        Ok(v) => v,
+        Err(e) => {
+            r.error = Some(e.into());
+            return r;
+        }
+    };
+
+    let mut guard = match Guard::new(cap, scenario) {
+        Ok(g) => g,
+        Err(e) => {
+            r.error = Some(e.into());
+            return r;
+        }
+    };
+    if let Err(e) = guard.check(Phase::Source, 0, false) {
+        r.error = Some(e.into());
+        r.window_guard = Some(guard.report());
+        return r;
+    }
+    if checkpoint(b, Phase::Source, 0, false).is_err() {
+        r.error = Some("source_checkpoint_failed".into());
+        return r;
+    }
+    if !cap.active() {
+        r.cancelled = true;
+        r.error = Some("cancelled".into());
+        return r;
+    }
+    let source_result = if b.fail_constructor(true, 0, false) {
+        Err(())
+    } else {
+        CGEventSource::new(CGEventSourceStateID::Private)
+    };
+    let source = match source_result {
+        Ok(v) => v,
+        Err(_) => {
+            r.error = Some("native_source_creation_failed".into());
+            return r;
+        }
+    };
+    let mut ledger = Ledger::default();
+    let mut n = 0;
+    let expected_steps = steps.len();
+    let mut finished_steps = 0;
+    let body = catch_unwind(AssertUnwindSafe(|| {
+        for step in steps {
+            n += 1;
+            send(
+                cap,
+                b,
+                &binding,
+                &source,
+                &step,
+                n,
+                false,
+                &mut ledger,
+                &mut guard,
+                &mut r,
+            )?;
+            delay(cap, b, n, &mut guard, &mut r)?;
+            finished_steps += 1;
+        }
+        Ok::<(), &'static str>(())
+    }));
+    let error = match body {
+        Ok(Ok(())) => None,
+        Ok(Err(e)) => Some(e),
+        Err(_) => Some("actuator_unwind"),
+    };
+    r.error = error.map(str::to_owned);
+    r.cancelled = !cap.active() || error == Some("cancelled");
+    // Cleanup authority is private and derives only from the ledger; no ordinary path can mint it.
+    if ledger.button {
+        n += 1;
+        let step = Step {
+            kind: Kind::Up,
+            point: ledger.last,
+            flags: flags(&ledger.modifiers),
+            delta: [0, 0],
+        };
+        let result = catch_unwind(AssertUnwindSafe(|| {
+            send(
+                cap,
+                b,
+                &binding,
+                &source,
+                &step,
+                n,
+                true,
+                &mut ledger,
+                &mut guard,
+                &mut r,
+            )
+        }));
+        if !matches!(result, Ok(Ok(()))) {
+            r.cleanup_debt.push("mouse_up_unconfirmed".into());
+        }
+        ledger.button = false; // Attempt exactly once; no automatic retry even if not-sent.
+    }
+    let mut possibly_held = CGEventFlags::CGEventFlagNull;
+    while let Some(k) = ledger.modifiers.pop() {
+        n += 1;
+        let step = Step {
+            kind: Kind::ModifierUp(k.clone()),
+            point: ledger.last,
+            flags: flags(&ledger.modifiers) | possibly_held,
+            delta: [0, 0],
+        };
+        let result = catch_unwind(AssertUnwindSafe(|| {
+            send(
+                cap,
+                b,
+                &binding,
+                &source,
+                &step,
+                n,
+                true,
+                &mut ledger,
+                &mut guard,
+                &mut r,
+            )
+        }));
+        if !matches!(result, Ok(Ok(()))) {
+            r.cleanup_debt.push(format!("modifier_up_unconfirmed:{k}"));
+            // 失败释放可能仍按住：后续释放不把该flag误记为已清零。
+            possibly_held |= modifier(&k).unwrap().1;
+        }
+    }
+    r.cancelled |= !cap.active();
+    r.window_guard = Some(guard.report());
+    r.ledger_verified = !guard.report().revoked
+        && finished_steps == expected_steps
+        && ledger.in_flight == 0
+        && !ledger.button
+        && ledger.modifiers.is_empty()
+        && r.error.is_none()
+        && !r.cancelled
+        && r.cleanup_debt.is_empty();
+    r
+}
