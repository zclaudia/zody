+    pub static kCGColorSpaceGenericRGBLinear: CFStringRef;
+    /// The generic CMYK color space.
+    pub static kCGColorSpaceGenericCMYK: CFStringRef;
+    /// The XYZ color space, as defined by the CIE 1931 standard.
