+//! Crate-private ownership for one native capture completion.
+//!
+//! This module owns only result reception and in-flight capacity. It does not
+//! own Helper approval, submission, leases, frame publication or input rights.
+//! Cancelling an observation closes its receiver monotonically; it does not
+//! stop ScreenCaptureKit and is not evidence of native `Fenced`/`Drained`.
+
+use std::collections::BTreeMap;
+use std::sync::{Arc, Condvar, Mutex, MutexGuard, OnceLock};
+
+use crate::error::{DriftStage, VisualError};
+use crate::geometry::{
+    checked_rgba_len, validate_identity, validate_window_identity, PixelDimensions, WindowIdentity,
+};
+use crate::observe::RawFrame;
+
+/// At most this many native completions may be outstanding at once.
+pub(crate) const MAX_IN_FLIGHT_CAPTURES: usize = 4;
+
+static GLOBAL: OnceLock<CaptureCoordinator> = OnceLock::new();
+
+/// The only mutable state owned by one in-flight native request.
+struct Signal {
+    state: Mutex<SignalState>,
+    changed: Condvar,
+}
+
+struct SignalState {
+    canceled: bool,
+    terminal: Option<Result<RawFrame, VisualError>>,
+    waiters: usize,
+}
+
+impl Signal {
+    fn new() -> Self {
+        Self {
+            state: Mutex::new(SignalState {
+                canceled: false,
+                terminal: None,
+                waiters: 0,
+            }),
+            changed: Condvar::new(),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Phase {
+    Enumerating,
+    Capturing,
+}
+
+struct Entry {
+    expected: WindowIdentity,
+    phase: Phase,
+    selected: Option<WindowIdentity>,
+    admission_error: Option<VisualError>,
+    callback_delivered: bool,
+    signal: Arc<Signal>,
+}
+
+struct Registry {
+    next_id: u64,
+    capacity: usize,
+    entries: BTreeMap<u64, Entry>,
+}
+
+/// Single owner of bounded in-flight metadata for this process.
+#[derive(Clone)]
+pub(crate) struct CaptureCoordinator {
+    registry: Arc<Mutex<Registry>>,
+}
+
+/// Decision returned to the Swift bridge after window enumeration.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum AdmissionDecision {
+    Proceed,
+    Canceled,
+    Rejected,
+}
+
+/// Native completion class. No field represents authorization.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CompletionStatus {
+    Success,
+    Canceled,
+    AdmissionRejected,
+    WindowNotFound,
+    NativeFailure(i32),
+}
+
+/// Owned completion data. Pixels are copied during the C callback only.
+#[derive(Debug)]
+pub(crate) struct NativeCompletion {
+    pub status: CompletionStatus,
+    pub facts: Option<WindowIdentity>,
+    pub dimensions: Option<PixelDimensions>,
+    pub rgba: Vec<u8>,
+    pub payload_error: Option<VisualError>,
+}
+
+/// Accounting result for tests and diagnostics.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CompletionOutcome {
+    Delivered,
+    DroppedCanceled,
+    DuplicateIgnored,
+}
+
+/// Result of the Swift bridge's `payload_released` notification. It is sent
+/// only after the bridge-owned pixel storage and borrow have been handed back.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CallbackReleaseOutcome {
+    Released,
+    DuplicateIgnored,
+}
+
+/// One observer's handle to a native callback that may still be alive.
+///
+/// Dropping this handle intentionally does not remove the registry entry. The
+/// entry is released only by the native completion (or by a synchronous native
+/// start failure), so a never-calling native path keeps its bounded slot.
+pub(crate) struct CaptureObservation {
+    id: u64,
+    signal: Arc<Signal>,
+    registry: Arc<Mutex<Registry>>,
+    consumed: bool,
+}
+
+/// Internal cloneable close handle for the same observation.
+///
+/// It is not an authorization token, lease, submission, identity or owner. It
+/// only lets an already-authorized internal caller close result reception while
+/// another thread is blocked in [`CaptureObservation::wait`].
+#[derive(Clone)]
+pub(crate) struct CaptureCancelHandle {
+    signal: Arc<Signal>,
+    registry: Arc<Mutex<Registry>>,
+}
+
+impl CaptureObservation {
+    pub(crate) fn id(&self) -> u64 {
+        self.id
+    }
+
+    /// Monotonically closes result reception. Safe to call repeatedly. This is
+    /// not native stop: an already-admitted OS capture may still complete.
+    pub(crate) fn cancel(&self) {
+        self.cancel_handle().cancel();
+    }
+
+    /// Clone the close path without transferring observation ownership.
+    pub(crate) fn cancel_handle(&self) -> CaptureCancelHandle {
+        CaptureCancelHandle {
+            signal: Arc::clone(&self.signal),
+            registry: Arc::clone(&self.registry),
+        }
+    }
+
+    /// Alias used by tests and future internal callers for idempotent shutdown.
+    #[allow(dead_code)]
+    pub(crate) fn close(&mut self) {
+        self.cancel();
+    }
+
+    /// Recheck cancellation immediately before final result delivery.
+    pub(crate) fn ensure_open(&self) -> Result<(), VisualError> {
+        if lock_signal(&self.signal).canceled {
+            Err(VisualError::CaptureCanceled)
+        } else {
+            Ok(())
+        }
+    }
+
+    /// Wait until native completion or cancellation. There is deliberately no
+    /// timeout: an absent callback keeps the slot and this observer pending.
+    /// Cancellation closes reception only; it does not prove native stop.
+    pub(crate) fn wait(&mut self) -> Result<RawFrame, VisualError> {
+        if self.consumed {
+            return Err(VisualError::CaptureAlreadyConsumed);
+        }
+        self.consumed = true;
+        let mut state = lock_signal(&self.signal);
+        state.waiters += 1;
+        loop {
+            if state.canceled {
+                state.waiters -= 1;
+                return Err(VisualError::CaptureCanceled);
+            }
+            if let Some(result) = state.terminal.take() {
+                state.waiters -= 1;
+                return result;
+            }
+            state = self
+                .signal
+                .changed
+                .wait(state)
+                .unwrap_or_else(|poisoned| poisoned.into_inner());
+        }
+    }
+}
+
+impl CaptureCancelHandle {
+    pub(crate) fn cancel(&self) {
+        // Keep the registry -> signal lock order used by admission/completion.
+        let _registry = lock_registry(&self.registry);
+        let mut state = lock_signal(&self.signal);
+        state.canceled = true;
+        // A result already deposited but not consumed is now late material and
+        // must not become a frame after the close linearization point.
+        state.terminal = None;
+        self.signal.changed.notify_all();
+    }
+}
+
+impl Drop for CaptureObservation {
+    fn drop(&mut self) {
+        // 竞态修复依据：observer 退出也必须单调关闭接收，否则枚举回调随后
+        // 仍可通过 admission 并启动截图。取消不清 slot；slot 只由 Swift 的
+        // payload_released 通知或同步 native 启动失败释放；它不是 OS callback
+        // 线程退出、Fenced 或 Drained 证据。
+        self.cancel();
+    }
+}
+
+impl CaptureCoordinator {
+    pub(crate) fn new(capacity: usize) -> Self {
+        assert!(capacity > 0, "capture capacity must be positive");
+        Self {
+            registry: Arc::new(Mutex::new(Registry {
+                next_id: 1,
+                capacity,
+                entries: BTreeMap::new(),
+            })),
+        }
+    }
+
+    /// Reserve one bounded slot before any native operation starts.
+    pub(crate) fn reserve(
+        &self,
+        expected: WindowIdentity,
+    ) -> Result<CaptureObservation, VisualError> {
+        let mut registry = lock_registry(&self.registry);
+        if registry.entries.len() >= registry.capacity {
+            return Err(VisualError::CaptureCapacityExhausted {
+                limit: registry.capacity,
+            });
+        }
+        let id = registry.next_id;
+        registry.next_id = id.checked_add(1).ok_or_else(|| {
+            VisualError::NativeCapture("capture operation id space exhausted".to_owned())
+        })?;
+        let signal = Arc::new(Signal::new());
+        registry.entries.insert(
+            id,
+            Entry {
+                expected,
+                phase: Phase::Enumerating,
+                selected: None,
+                admission_error: None,
+                callback_delivered: false,
+                signal: Arc::clone(&signal),
+            },
+        );
+        Ok(CaptureObservation {
+            id,
+            signal,
+            registry: Arc::clone(&self.registry),
+            consumed: false,
+        })
+    }
+
+    /// Linearization point between enumeration and screenshot start.
+    pub(crate) fn admit(&self, id: u64, actual: WindowIdentity) -> AdmissionDecision {
+        let mut registry = lock_registry(&self.registry);
+        let Some(entry) = registry.entries.get_mut(&id) else {
+            return AdmissionDecision::Rejected;
+        };
+        if entry.phase != Phase::Enumerating {
+            return AdmissionDecision::Rejected;
+        }
+        if let Err(error) = validate_window_identity(&actual) {
+            entry.admission_error = Some(error);
+            return AdmissionDecision::Rejected;
+        }
+        if let Err(error) = validate_identity(&entry.expected, &actual, DriftStage::SelectedWindow)
+        {
+            entry.admission_error = Some(error);
+            return AdmissionDecision::Rejected;
+        }
+        let state = lock_signal(&entry.signal);
+        if state.canceled {
+            return AdmissionDecision::Canceled;
+        }
+        drop(state);
+        entry.selected = Some(actual);
+        entry.phase = Phase::Capturing;
+        AdmissionDecision::Proceed
+    }
+
+    /// Record exactly one native completion without claiming native stop,
+    /// callback-thread exit, Fenced or Drained. The slot is not released here.
+    ///
+    /// The bounded slot stays occupied until Swift calls
+    /// [`Self::release_callback`] after the C callback and its pixel borrow have
+    /// returned. A duplicate callback is ignored and cannot release the slot or
+    /// deposit a second result.
+    pub(crate) fn complete(&self, id: u64, completion: NativeCompletion) -> CompletionOutcome {
+        let mut registry = lock_registry(&self.registry);
+        let Some(entry) = registry.entries.get_mut(&id) else {
+            return CompletionOutcome::DuplicateIgnored;
+        };
+        if entry.callback_delivered {
+            return CompletionOutcome::DuplicateIgnored;
+        }
+        entry.callback_delivered = true;
+        let signal = Arc::clone(&entry.signal);
+        let mut state = lock_signal(&signal);
+        if state.canceled {
+            state.terminal = Some(Err(VisualError::CaptureCanceled));
+            signal.changed.notify_all();
+            return CompletionOutcome::DroppedCanceled;
+        }
+
+        let result = terminal_result(entry, completion);
+        state.terminal = Some(result);
+        signal.changed.notify_all();
+        CompletionOutcome::Delivered
+    }
+
+    /// Release capacity only after Swift reports, via `payload_released`, that
+    /// its bridge-owned pixel storage and borrow were handed back. This is not
+    /// evidence that the OS callback thread has returned or that SCK is idle.
+    pub(crate) fn release_callback(&self, id: u64) -> CallbackReleaseOutcome {
+        let mut registry = lock_registry(&self.registry);
+        let Some(entry) = registry.entries.remove(&id) else {
+            return CallbackReleaseOutcome::DuplicateIgnored;
+        };
+        if !entry.callback_delivered {
+            let signal = Arc::clone(&entry.signal);
+            let mut state = lock_signal(&signal);
+            state.terminal = Some(Err(VisualError::NativeCapture(
+                "Swift sent payload_released before delivering completion".to_owned(),
+            )));
+            signal.changed.notify_all();
+        }
+        CallbackReleaseOutcome::Released
+    }
+
+    /// A synchronous native start failure guarantees no callback will follow.
+    pub(crate) fn abort_before_native(&self, id: u64, error: VisualError) -> CompletionOutcome {
+        let mut registry = lock_registry(&self.registry);
+        let Some(entry) = registry.entries.remove(&id) else {
+            return CompletionOutcome::DuplicateIgnored;
+        };
+        let signal = Arc::clone(&entry.signal);
+        let mut state = lock_signal(&signal);
+        if state.canceled {
+            state.terminal = Some(Err(VisualError::CaptureCanceled));
+            signal.changed.notify_all();
+            return CompletionOutcome::DroppedCanceled;
+        }
+        state.terminal = Some(Err(error));
+        signal.changed.notify_all();
+        CompletionOutcome::Delivered
+    }
+
+    #[cfg(test)]
+    fn in_flight(&self) -> usize {
+        lock_registry(&self.registry).entries.len()
+    }
+
+    #[cfg(test)]
+    fn waiters(&self, id: u64) -> usize {
+        let registry = lock_registry(&self.registry);
+        registry
+            .entries
+            .get(&id)
+            .map_or(0, |entry| lock_signal(&entry.signal).waiters)
+    }
+}
+
+fn terminal_result(entry: &Entry, completion: NativeCompletion) -> Result<RawFrame, VisualError> {
+    match completion.status {
+        CompletionStatus::Canceled => Err(VisualError::CaptureCanceled),
+        CompletionStatus::AdmissionRejected => {
+            Err(entry.admission_error.clone().unwrap_or_else(|| {
+                VisualError::NativeCapture("native admission rejected the window".to_owned())
+            }))
+        }
+        CompletionStatus::WindowNotFound => Err(VisualError::WindowNotFound {
+            window_id: entry.expected.window_id,
+        }),
+        CompletionStatus::NativeFailure(code) => Err(VisualError::NativeCapture(format!(
+            "native capture completion failed with status {code}"
+        ))),
+        CompletionStatus::Success => {
+            let Some(facts) = completion.facts else {
+                return Err(VisualError::NativeCapture(
+                    "successful completion omitted selected window facts".to_owned(),
+                ));
+            };
+            if let Some(error) = completion.payload_error {
+                return Err(error);
+            }
+            let Some(selected) = entry.selected else {
+                return Err(VisualError::NativeCapture(
+                    "successful completion arrived before admission".to_owned(),
+                ));
+            };
+            validate_identity(&selected, &facts, DriftStage::SelectedWindow)?;
+            let Some(dimensions) = completion.dimensions else {
+                return Err(VisualError::NativeCapture(
+                    "successful completion omitted image dimensions".to_owned(),
+                ));
+            };
+            checked_rgba_len(dimensions.width, dimensions.height, completion.rgba.len())?;
+            Ok(RawFrame {
+                dimensions,
+                rgba: completion.rgba,
+            })
+        }
+    }
+}
+
+pub(crate) fn global() -> &'static CaptureCoordinator {
+    GLOBAL.get_or_init(|| CaptureCoordinator::new(MAX_IN_FLIGHT_CAPTURES))
+}
+
+fn lock_registry(registry: &Mutex<Registry>) -> MutexGuard<'_, Registry> {
+    registry
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+fn lock_signal(signal: &Signal) -> MutexGuard<'_, SignalState> {
+    signal
+        .state
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::geometry::WindowBounds;
+    use std::sync::Barrier;
+    use std::thread;
+
+    fn expected() -> WindowIdentity {
+        WindowIdentity::new(11, 4242, 0, WindowBounds::new(100.0, 580.0, 500.0, 500.0))
+    }
+
+    fn success_completion(width: u32, height: u32) -> NativeCompletion {
+        NativeCompletion {
+            status: CompletionStatus::Success,
+            facts: Some(expected()),
+            dimensions: Some(PixelDimensions { width, height }),
+            rgba: vec![0x41; (width * height * 4) as usize],
+            payload_error: None,
+        }
+    }
+
+    fn reserved(coordinator: &CaptureCoordinator) -> CaptureObservation {
+        coordinator.reserve(expected()).expect("reserve")
+    }
+
+    #[test]
+    fn cancel_before_admission_never_starts_capture_and_releases_on_callback() {
+        let coordinator = CaptureCoordinator::new(2);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        observation.cancel();
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Canceled
+        );
+        assert_eq!(
+            coordinator.complete(id, success_completion(2, 2)),
+            CompletionOutcome::DroppedCanceled
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(
+            coordinator.release_callback(id),
+            CallbackReleaseOutcome::Released
+        );
+        assert_eq!(coordinator.in_flight(), 0);
+        assert_eq!(observation.wait(), Err(VisualError::CaptureCanceled));
+    }
+
+    #[test]
+    fn cancel_after_admission_drops_late_pixels() {
+        let coordinator = CaptureCoordinator::new(2);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        observation.cancel();
+        assert_eq!(
+            coordinator.complete(id, success_completion(2, 2)),
+            CompletionOutcome::DroppedCanceled
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        coordinator.release_callback(id);
+        assert_eq!(observation.wait(), Err(VisualError::CaptureCanceled));
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn observer_drop_before_admission_prevents_capture_start() {
+        let coordinator = CaptureCoordinator::new(1);
+        let id = {
+            let observation = reserved(&coordinator);
+            observation.id()
+        };
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Canceled
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        assert!(matches!(
+            coordinator.reserve(expected()),
+            Err(VisualError::CaptureCapacityExhausted { limit: 1 })
+        ));
+        assert_eq!(
+            coordinator.complete(id, success_completion(2, 2)),
+            CompletionOutcome::DroppedCanceled
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        coordinator.release_callback(id);
+        assert_eq!(coordinator.in_flight(), 0);
+        assert!(coordinator.reserve(expected()).is_ok());
+    }
+
+    #[test]
+    fn observer_drop_after_admission_keeps_slot_until_bridge_release() {
+        let coordinator = CaptureCoordinator::new(1);
+        let id = {
+            let observation = reserved(&coordinator);
+            let id = observation.id();
+            assert_eq!(
+                coordinator.admit(id, expected()),
+                AdmissionDecision::Proceed
+            );
+            id
+        };
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(
+            coordinator.complete(id, success_completion(2, 2)),
+            CompletionOutcome::DroppedCanceled
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        coordinator.release_callback(id);
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn callback_delivery_does_not_release_capacity_before_payload_released() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        assert_eq!(
+            coordinator.complete(id, success_completion(2, 3)),
+            CompletionOutcome::Delivered
+        );
+        // Callback data is delivered, but the Swift bridge may still hold its
+        // bridge-owned pixel storage and borrow. Capacity must remain occupied
+        // until payload_released; this is not a claim about OS callback exit.
+        assert_eq!(coordinator.in_flight(), 1);
+        assert!(matches!(
+            coordinator.reserve(expected()),
+            Err(VisualError::CaptureCapacityExhausted { limit: 1 })
+        ));
+        let raw = observation.wait().expect("raw frame");
+        assert_eq!(raw.rgba.len(), 24);
+        assert_eq!(
+            coordinator.release_callback(id),
+            CallbackReleaseOutcome::Released
+        );
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn duplicate_close_callback_and_release_are_idempotent() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        observation.close();
+        observation.close();
+        assert_eq!(
+            coordinator.complete(id, success_completion(1, 1)),
+            CompletionOutcome::DroppedCanceled
+        );
+        assert_eq!(
+            coordinator.complete(id, success_completion(1, 1)),
+            CompletionOutcome::DuplicateIgnored
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(
+            coordinator.release_callback(id),
+            CallbackReleaseOutcome::Released
+        );
+        assert_eq!(
+            coordinator.release_callback(id),
+            CallbackReleaseOutcome::DuplicateIgnored
+        );
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn capacity_is_bounded_and_released_only_by_payload_released() {
+        let coordinator = CaptureCoordinator::new(2);
+        let first = reserved(&coordinator);
+        let second = reserved(&coordinator);
+        assert!(matches!(
+            coordinator.reserve(expected()),
+            Err(VisualError::CaptureCapacityExhausted { limit: 2 })
+        ));
+        first.cancel();
+        drop(second);
+        assert_eq!(coordinator.in_flight(), 2);
+        assert_eq!(
+            coordinator.complete(first.id(), success_completion(1, 1)),
+            CompletionOutcome::DroppedCanceled
+        );
+        assert_eq!(coordinator.in_flight(), 2);
+        assert_eq!(
+            coordinator.release_callback(first.id()),
+            CallbackReleaseOutcome::Released
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        assert!(coordinator.reserve(expected()).is_ok());
+    }
+
+    #[test]
+    fn selected_drift_is_rejected_and_callback_returns_stored_error() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        let drifted =
+            WindowIdentity::new(11, 9999, 0, WindowBounds::new(100.0, 580.0, 500.0, 500.0));
+        assert_eq!(coordinator.admit(id, drifted), AdmissionDecision::Rejected);
+        let completion = NativeCompletion {
+            status: CompletionStatus::AdmissionRejected,
+            facts: None,
+            dimensions: None,
+            rgba: Vec::new(),
+            payload_error: None,
+        };
+        assert_eq!(
+            coordinator.complete(id, completion),
+            CompletionOutcome::Delivered
+        );
+        coordinator.release_callback(id);
+        assert!(matches!(
+            observation.wait(),
+            Err(VisualError::WindowDrift {
+                stage: DriftStage::SelectedWindow,
+                ..
+            })
+        ));
+    }
+
+    #[test]
+    fn successful_completion_delivers_exact_rgba() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        assert_eq!(
+            coordinator.complete(id, success_completion(2, 3)),
+            CompletionOutcome::Delivered
+        );
+        let raw = observation.wait().expect("raw frame");
+        assert_eq!(raw.dimensions.width, 2);
+        assert_eq!(raw.dimensions.height, 3);
