@@ -0,0 +1,95 @@
+// Read-only development sampler. Never request permission, enumerate titles, or mutate focus/input.
+#import <AppKit/AppKit.h>
+#import <ApplicationServices/ApplicationServices.h>
+#include <libproc.h>
+#include <dlfcn.h>
+#include <stdlib.h>
+#include <time.h>
+typedef struct {
+ int32_t pid, front_pid, ax_pid, ax_error;
+ uint32_t window_id, ax_window_id, window_count, flags_known;
+ uint64_t start_sec, start_usec, keys[4], buttons, flags;
+ double bounds[4];
+ uint32_t ax_trusted, listen_trusted, screen_trusted, on_screen, layer, ax_same, cg_known, process_known;
+ uint64_t sample_micros;
+ uint32_t candidate_window_id; int32_t candidate_pid; double candidate_bounds[4]; uint64_t candidate_start_sec,candidate_start_usec;
+} ZodyFacts;
+typedef struct { AXUIElementRef first; } Owner;
+size_t zody_facts_size(void) {return sizeof(ZodyFacts);}
+void *zody_facts_new(void) { return calloc(1,sizeof(Owner)); }
+void zody_facts_free(void *p) { Owner *o=p; if(o) { if(o->first) CFRelease(o->first); free(o); } }
+void zody_facts_read(void *p, ZodyFacts *f) {
+ @autoreleasepool {
+  struct timespec ts,te; clock_gettime(CLOCK_MONOTONIC,&ts);
+  memset(f,0,sizeof(*f)); f->ax_error=-1;
+  f->ax_trusted=AXIsProcessTrusted(); f->listen_trusted=CGPreflightListenEventAccess();
+  f->screen_trusted=CGPreflightScreenCaptureAccess();
+  f->front_pid=NSWorkspace.sharedWorkspace.frontmostApplication.processIdentifier;
+  f->flags=CGEventSourceFlagsState(kCGEventSourceStateHIDSystemState);
+  for(unsigned k=0;k<256;k++) if(CGEventSourceKeyState(kCGEventSourceStateHIDSystemState,k)) f->keys[k/64]|=1ull<<(k%64);
+  for(unsigned b=0;b<32;b++) if(CGEventSourceButtonState(kCGEventSourceStateHIDSystemState,b)) f->buttons|=1ull<<b;
+  // Preflight is a necessary trust condition, not a guarantee of complete physical attribution.
+  f->flags_known=0; // Native HID completeness/physical attribution remains unvalidated: never authorize live input.
+  AXUIElementRef sys=AXUIElementCreateSystemWide(); CFTypeRef app=NULL,win=NULL;
+  AXUIElementSetMessagingTimeout(sys,0.15f);
+  AXError err=AXUIElementCopyAttributeValue(sys,kAXFocusedApplicationAttribute,&app);
+  if(err==0 && app && CFGetTypeID(app)==AXUIElementGetTypeID()) {
+   AXUIElementGetPid((AXUIElementRef)app,&f->ax_pid);
+   AXUIElementSetMessagingTimeout((AXUIElementRef)app,0.15f);
+   err=AXUIElementCopyAttributeValue((AXUIElementRef)app,kAXFocusedWindowAttribute,&win);
+  }
+  if(err==0 && win && CFGetTypeID(win)==AXUIElementGetTypeID()) {
+   typedef AXError(*WindowFn)(AXUIElementRef,uint32_t*);
+   WindowFn fn=(WindowFn)dlsym(RTLD_DEFAULT,"_AXUIElementGetWindow");
+   err=fn?fn((AXUIElementRef)win,&f->ax_window_id):-25202;
+   Owner *o=p;
+   if(err==0 && o) { if(!o->first) o->first=(AXUIElementRef)CFRetain(win); f->ax_same=CFEqual(o->first,win); }
+  }
+  f->ax_error=err;
+  if(win) CFRelease(win); if(app) CFRelease(app); CFRelease(sys);
+  CFArrayRef list=CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly|kCGWindowListExcludeDesktopElements,kCGNullWindowID);
+  if(list) {
+   f->window_count=(uint32_t)CFArrayGetCount(list);
+   for(CFIndex i=0;i<CFArrayGetCount(list);i++) {
+    NSDictionary *d=(__bridge NSDictionary*)CFArrayGetValueAtIndex(list,i);
+    uint32_t wid=[d[(id)kCGWindowNumber] unsignedIntValue];
+    if(!f->candidate_window_id && [d[(id)kCGWindowOwnerPID] intValue]==f->front_pid && [d[(id)kCGWindowLayer] intValue]==0 && [d[(id)kCGWindowIsOnscreen] boolValue]) {
+     CGRect c; if(CGRectMakeWithDictionaryRepresentation((__bridge CFDictionaryRef)d[(id)kCGWindowBounds],&c)) {f->candidate_window_id=wid;f->candidate_pid=f->front_pid;f->candidate_bounds[0]=c.origin.x;f->candidate_bounds[1]=c.origin.y;f->candidate_bounds[2]=c.size.width;f->candidate_bounds[3]=c.size.height;}
+    }
+    if(wid!=f->ax_window_id || !wid) continue;
+    f->window_id=wid; f->pid=[d[(id)kCGWindowOwnerPID] intValue];
+    f->on_screen=[d[(id)kCGWindowIsOnscreen] boolValue]; f->layer=[d[(id)kCGWindowLayer] unsignedIntValue];
+    CGRect r; if(CGRectMakeWithDictionaryRepresentation((__bridge CFDictionaryRef)d[(id)kCGWindowBounds],&r)) {
+     f->bounds[0]=r.origin.x; f->bounds[1]=r.origin.y; f->bounds[2]=r.size.width; f->bounds[3]=r.size.height; f->cg_known=1;
+    } break;
+   } CFRelease(list);
+  }
+  struct proc_bsdinfo initial_info; if(f->pid>0 && proc_pidinfo(f->pid,PROC_PIDTBSDINFO,0,&initial_info,sizeof(initial_info))==sizeof(initial_info)){f->start_sec=initial_info.pbi_start_tvsec;f->start_usec=initial_info.pbi_start_tvusec;f->process_known=1;}
+  // Detect observed focus changes during this non-atomic compound sample.
+  CFTypeRef app2=NULL,win2=NULL; pid_t pid2=0; uint32_t wid2=0;
+  AXUIElementRef sys2=AXUIElementCreateSystemWide(); AXUIElementSetMessagingTimeout(sys2,0.15f);
+  AXError e2=AXUIElementCopyAttributeValue(sys2,kAXFocusedApplicationAttribute,&app2); CFRelease(sys2);
+  if(e2==0 && app2 && CFGetTypeID(app2)==AXUIElementGetTypeID()) {
+   AXUIElementGetPid((AXUIElementRef)app2,&pid2); AXUIElementSetMessagingTimeout((AXUIElementRef)app2,0.15f);
+   e2=AXUIElementCopyAttributeValue((AXUIElementRef)app2,kAXFocusedWindowAttribute,&win2);
+  }
+  if(e2==0 && win2 && CFGetTypeID(win2)==AXUIElementGetTypeID()) {
+   if(p && ((Owner*)p)->first) f->ax_same &= CFEqual(((Owner*)p)->first,win2);
+   typedef AXError(*WF)(AXUIElementRef,uint32_t*); WF fn=(WF)dlsym(RTLD_DEFAULT,"_AXUIElementGetWindow"); e2=fn?fn((AXUIElementRef)win2,&wid2):-25202;
+  }
+  if(e2!=0 || pid2!=f->ax_pid || wid2!=f->ax_window_id || NSWorkspace.sharedWorkspace.frontmostApplication.processIdentifier!=f->front_pid) f->ax_error=-25204;
+  if(app2) CFRelease(app2); if(win2) CFRelease(win2);
+  CFArrayRef tail=CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly|kCGWindowListExcludeDesktopElements,kCGNullWindowID);
+  bool found=false;
+  if(tail){for(CFIndex i=0;i<CFArrayGetCount(tail);i++){
+   NSDictionary *d=(__bridge NSDictionary*)CFArrayGetValueAtIndex(tail,i);
+   if([d[(id)kCGWindowNumber] unsignedIntValue]!=f->window_id || !f->window_id) continue;
+   CGRect t; bool bounds_ok=CGRectMakeWithDictionaryRepresentation((__bridge CFDictionaryRef)d[(id)kCGWindowBounds],&t);
+   found=bounds_ok && [d[(id)kCGWindowOwnerPID] intValue]==f->pid && [d[(id)kCGWindowLayer] unsignedIntValue]==f->layer && [d[(id)kCGWindowIsOnscreen] boolValue]==f->on_screen && t.origin.x==f->bounds[0] && t.origin.y==f->bounds[1] && t.size.width==f->bounds[2] && t.size.height==f->bounds[3];break;
+  }CFRelease(tail);} f->cg_known &= found;
+  struct proc_bsdinfo info; int n=proc_pidinfo(f->pid,PROC_PIDTBSDINFO,0,&info,sizeof(info));
+  if(!(f->pid>0 && n==sizeof(info) && f->start_sec==info.pbi_start_tvsec && f->start_usec==info.pbi_start_tvusec)) f->process_known=0;
+  struct proc_bsdinfo ci; if(f->candidate_pid>0 && proc_pidinfo(f->candidate_pid,PROC_PIDTBSDINFO,0,&ci,sizeof(ci))==sizeof(ci)){f->candidate_start_sec=ci.pbi_start_tvsec;f->candidate_start_usec=ci.pbi_start_tvusec;}
+  clock_gettime(CLOCK_MONOTONIC,&te); f->sample_micros=(te.tv_sec-ts.tv_sec)*1000000ull+(te.tv_nsec-ts.tv_nsec)/1000;
+ }
+}
