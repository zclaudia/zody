new file mode 100644
index 0000000..9b3ec6c
--- /dev/null
+++ b/crates/cua-driver-core/src/window_lease.rs
@@ -0,0 +1,528 @@
+//! Private, single-worker owner. Snapshots are diagnostics, never admission authority.
+use crate::native_capability::NativeWorkerCapability;
+use serde::Serialize;
+use std::sync::atomic::{AtomicU64, Ordering};
+static NEXT_LEASE: AtomicU64 = AtomicU64::new(1);
+use std::time::{Duration, Instant};
+#[repr(C)]
+#[derive(Default, Clone, Debug, Serialize)]
+struct Facts {
+    pid: i32,
+    front_pid: i32,
+    ax_pid: i32,
+    ax_error: i32,
+    window_id: u32,
+    ax_window_id: u32,
+    window_count: u32,
+    flags_known: u32,
+    start_sec: u64,
+    start_usec: u64,
+    keys: [u64; 4],
+    buttons: u64,
+    flags: u64,
+    bounds: [f64; 4],
+    ax_trusted: u32,
+    listen_trusted: u32,
+    screen_trusted: u32,
+    on_screen: u32,
+    layer: u32,
+    ax_same: u32,
+    cg_known: u32,
+    process_known: u32,
+    sample_micros: u64,
+    candidate_window_id: u32,
+    candidate_pid: i32,
+    candidate_bounds: [f64; 4],
+    candidate_start_sec: u64,
+    candidate_start_usec: u64,
+}
+extern "C" {
+    fn zody_facts_size() -> usize;
+    fn zody_facts_new() -> *mut std::ffi::c_void;
+    fn zody_facts_free(p: *mut std::ffi::c_void);
+    fn zody_facts_read(p: *mut std::ffi::c_void, f: *mut Facts);
+}
+struct Native(*mut std::ffi::c_void);
+impl Native {
+    fn new() -> Result<Self, &'static str> {
+        if unsafe { zody_facts_size() } != std::mem::size_of::<Facts>() {
+            return Err("facts_abi_size_mismatch");
+        }
+        let p = unsafe { zody_facts_new() };
+        if p.is_null() {
+            Err("facts_allocation_failed")
+        } else {
+            Ok(Self(p))
+        }
+    }
+    fn read(&self) -> Facts {
+        let mut f = Facts::default();
+        unsafe { zody_facts_read(self.0, &mut f) };
+        f
+    }
+}
+impl Drop for Native {
+    fn drop(&mut self) {
+        unsafe { zody_facts_free(self.0) }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Serialize)]
+pub enum Change {
+    Stable,
+    FocusPid,
+    FocusWindow,
+    WindowMissing,
+    WindowRebuilt,
+    ProcessReused,
+    Bounds,
+    Offscreen,
+    Layer,
+    UnknownAx,
+    UnknownInput,
+    UserKey,
+    UserModifier,
+    UserButton,
+    Expired,
+    Revoked,
+    FocusAba,
+    RebuildAba,
+    InputAba,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct Scenario {
+    pub change: Change,
+    pub phase: super::native_actuator::Phase,
+    pub ordinal: usize,
+}
+#[derive(Clone, Debug, Serialize)]
+pub struct GuardReport {
+    pub source: String,
+    pub action: u64,
+    pub lease_id: u64,
+    pub checks: usize,
+    pub generation: u64,
+    pub lease_epoch: u64,
+    pub revoked: bool,
+    pub reason: Option<String>,
+}
+struct Lease {
+    target: (i32, u32),
+    baseline: Facts,
+    deadline: Instant,
+    report: GuardReport,
+}
+pub(crate) struct Guard {
+    native: Option<Native>,
+    lease: Lease,
+    scenario: Option<Scenario>,
+    changed: bool,
+    live: bool,
+}
+fn valid(f: &Facts) -> Result<(), &'static str> {
+    if f.sample_micros > 50_000 {
+        return Err("facts_sample_too_slow");
+    }
+    if f.ax_trusted != 1 || f.ax_error != 0 || f.ax_window_id == 0 {
+        return Err("exact_focus_unknown");
+    }
+    if f.cg_known != 1 || f.process_known != 1 || f.ax_same != 1 {
+        return Err("window_identity_unknown");
+    }
+    if f.pid <= 0 || f.pid != f.front_pid || f.pid != f.ax_pid || f.window_id != f.ax_window_id {
+        return Err("exact_focus_mismatch");
+    }
+    if f.on_screen != 1
+        || f.layer != 0
+        || !f.bounds.iter().all(|x| x.is_finite())
+        || f.bounds[2] <= 0.0
+        || f.bounds[3] <= 0.0
+    {
+        return Err("window_not_eligible");
+    }
+    if f.flags_known != 1 || f.listen_trusted != 1 {
+        return Err("input_state_unknown");
+    }
+    Ok(())
+}
+fn held(f: &Facts) -> bool {
+    f.keys.iter().any(|x| *x != 0) || f.buttons != 0 || f.flags & 0x00ff0000 != 0
+}
+impl Guard {
+    pub(crate) fn new(
+        cap: &NativeWorkerCapability,
+        scenario: Option<Scenario>,
+    ) -> Result<Self, &'static str> {
+        let target = (
+            i32::try_from(
+                cap.arguments()["pid"]
+                    .as_i64()
+                    .ok_or("target_pid_missing")?,
+            )
+            .map_err(|_| "target_pid_invalid")?,
+            u32::try_from(
+                cap.arguments()["window_id"]
+                    .as_u64()
+                    .ok_or("target_window_missing")?,
+            )
+            .map_err(|_| "target_window_invalid")?,
+        );
+        if target.0 <= 0 || target.1 == 0 {
+            return Err("target_identity_invalid");
+        }
+        let native = if scenario.is_none() {
+            Some(Native::new()?)
+        } else {
+            None
+        };
+        let baseline = if let Some(n) = &native {
+            n.read()
+        } else {
+            Facts {
+                pid: target.0,
+                front_pid: target.0,
+                ax_pid: target.0,
+                window_id: target.1,
+                ax_window_id: target.1,
+                start_sec: 100,
+                start_usec: 1,
+                bounds: [0.0, 0.0, 240.0, 160.0],
+                ax_trusted: 1,
+                listen_trusted: 1,
+                flags_known: 1,
+                on_screen: 1,
+                ax_same: 1,
+                cg_known: 1,
+                process_known: 1,
+                ..Facts::default()
+            }
+        };
+        valid(&baseline)?;
+        if (baseline.pid, baseline.window_id) != target {
+            return Err("target_not_exact_front_window");
+        }
+        if held(&baseline) {
+            return Err("user_input_held_at_admission");
+        }
+        Ok(Self {
+            live: native.is_some(),
+            native,
+            lease: Lease {
+                target,
+                baseline,
+                deadline: Instant::now() + Duration::from_millis(1500),
+                report: GuardReport {
+                    source: if scenario.is_none() {
+                        "live-read-only"
+                    } else {
+                        "deterministic-replay"
+                    }
+                    .into(),
+                    action: cap.action_id(),
+                    lease_id: NEXT_LEASE
+                        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |x| x.checked_add(1))
+                        .map_err(|_| "lease_id_exhausted")?,
+                    checks: 0,
+                    generation: 1,
+                    lease_epoch: 1,
+                    revoked: false,
+                    reason: None,
+                },
+            },
+            scenario,
+            changed: false,
+        })
+    }
+    fn revoke(&mut self, e: &'static str) -> Result<(), &'static str> {
+        if !self.lease.report.revoked {
+            self.lease.report.generation += 1;
+            self.lease.report.lease_epoch += 1;
+            self.lease.report.reason = Some(e.into());
+            self.lease.report.revoked = true;
+        }
+        Err(e)
+    }
+    pub(crate) fn check(
+        &mut self,
+        p: super::native_actuator::Phase,
+        n: usize,
+        release: bool,
+    ) -> Result<(), &'static str> {
+        self.lease.report.checks += 1;
+        let mut f = if let Some(native) = &self.native {
+            native.read()
+        } else {
+            self.lease.baseline.clone()
+        };
+        if let Some(s) = self.scenario {
+            if s.phase == p && s.ordinal == n {
+                self.changed = true;
+            }
+        }
+        if self.changed {
+            match self.scenario.unwrap().change {
+                Change::Stable => {}
+                Change::FocusPid => f.front_pid += 1,
+                Change::FocusWindow => f.ax_window_id += 1,
+                Change::WindowMissing => f.cg_known = 0,
+                Change::WindowRebuilt => f.ax_same = 0,
+                Change::ProcessReused => f.start_usec += 1,
+                Change::Bounds => f.bounds[0] += 1.0,
+                Change::Offscreen => f.on_screen = 0,
+                Change::Layer => f.layer = 1,
+                Change::UnknownAx => f.ax_error = -25204,
+                Change::UnknownInput => f.flags_known = 0,
+                Change::UserKey => f.keys[0] |= 1,
+                Change::UserModifier => {
+                    f.keys[0] |= 1 << 55;
+                    f.flags |= 1 << 20;
+                }
+                Change::UserButton => f.buttons = 1,
+                Change::Expired => self.lease.deadline = Instant::now(),
+                Change::Revoked => {
+                    let _ = self.revoke("lease_revoked");
+                }
+                // These are explicit observer epoch notifications, not claims that polling catches ABA.
+                Change::FocusAba | Change::RebuildAba | Change::InputAba => {
+                    let _ = self.revoke("observer_epoch_changed");
+                }
+            }
+        }
+        // Releases bypass window lease/focus only. Untrusted/held human input blocks release and leaves debt.
+        // HID query cannot distinguish own injected downs: actual live release is deliberately unapproved.
+        if f.flags_known != 1 || f.listen_trusted != 1 {
+            return self.revoke("input_state_unknown");
+        }
+        if held(&f) {
+            return self.revoke("user_input_interference");
+        }
+        let decision = if self.lease.report.revoked {
+            Err("lease_revoked")
+        } else if Instant::now() >= self.lease.deadline {
+            self.revoke("lease_expired")
+        } else if let Err(e) = valid(&f) {
+            self.revoke(e)
+        } else {
+            let b = &self.lease.baseline;
+            if (f.pid, f.window_id) != self.lease.target
+                || f.start_sec != b.start_sec
+                || f.start_usec != b.start_usec
+                || f.bounds != b.bounds
+            {
+                self.revoke("window_generation_changed")
+            } else {
+                Ok(())
+            }
+        };
+        if release {
+            if self.live {
+                return Err("live_release_attribution_unproven");
+            }
+            return Ok(());
+        }
+        decision?;
+        Ok(())
+    }
+    pub(crate) fn point(&mut self, p: [f64; 2], release: bool) -> Result<(), &'static str> {
+        if release {
+            return Ok(());
+        }
+        let b = self.lease.baseline.bounds;
+        if p.iter().any(|v| !v.is_finite())
+            || p[0] < b[0]
+            || p[1] < b[1]
+            || p[0] >= b[0] + b[2]
+            || p[1] >= b[1] + b[3]
+        {
+            self.revoke("point_outside_bound_window")
+        } else {
+            Ok(())
+        }
+    }
+    /// 域内只检查本地不可续租事实，不调用AX/CG；等待其他handoff不能延长window lease。
+    pub(crate) fn local_fence(&mut self, at: Instant, release: bool) -> Result<(), &'static str> {
+        if at >= self.lease.deadline {
+            let _ = self.revoke("lease_expired");
+        }
+        if release {
+            if self.live {
+                return Err("live_release_attribution_unproven");
+            }
+            return Ok(());
+        }
+        if self.lease.report.revoked {
+            Err("lease_revoked")
+        } else {
+            Ok(())
+        }
+    }
+    pub(crate) fn report(&self) -> GuardReport {
+        self.lease.report.clone()
+    }
+}
+#[cfg(feature = "zody-dev-probe")]
+pub fn sample_development() -> serde_json::Value {
+    match Native::new() {
+        Err(e) => serde_json::json!({"error":e}),
+        Ok(n) => {
+            let start = Instant::now();
+            let f = n.read();
+            let decision = valid(&f).and_then(|_| {
+                if held(&f) {
+                    Err("user_input_held")
+                } else {
+                    Ok(())
+                }
+            });
+            let mut diagnostic = serde_json::to_value(&f).unwrap();
+            diagnostic.as_object_mut().unwrap().remove("keys");
+            diagnostic.as_object_mut().unwrap().remove("flags");
+            diagnostic["any_hid_key_held"] = serde_json::json!(f.keys.iter().any(|x| *x != 0));
+            diagnostic["any_hid_modifier_flag"] = serde_json::json!(f.flags & 0x00ff0000 != 0);
+            serde_json::json!({"facts":diagnostic,"strict_facts_decision":decision,"elapsed_micros":start.elapsed().as_micros(),"formal_acceptance":false,"titles_collected":false,"os_posts":0,"tcc_requested":false,"input_trust_policy":"native queries diagnostic only; flags_known forced false until physical attribution validated","candidate_is_exact_focus":false})
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::native_actuator::Phase;
+    fn fixture(change: Change) -> Guard {
+        let f = Facts {
+            pid: 7,
+            front_pid: 7,
+            ax_pid: 7,
+            window_id: 11,
+            ax_window_id: 11,
+            start_sec: 100,
+            start_usec: 1,
+            bounds: [0., 0., 240., 160.],
+            ax_trusted: 1,
+            listen_trusted: 1,
+            flags_known: 1,
+            on_screen: 1,
+            ax_same: 1,
+            cg_known: 1,
+            process_known: 1,
+            ..Facts::default()
+        };
+        Guard {
+            native: None,
+            live: false,
+            lease: Lease {
+                target: (7, 11),
+                baseline: f,
+                deadline: Instant::now() + Duration::from_millis(1500),
+                report: GuardReport {
+                    source: "unit-replay".into(),
+                    action: 1,
+                    lease_id: 1,
+                    checks: 0,
+                    generation: 1,
+                    lease_epoch: 1,
+                    revoked: false,
+                    reason: None,
+                },
+            },
+            scenario: Some(Scenario {
+                change,
+                phase: Phase::BeforeCreate,
+                ordinal: 1,
+            }),
+            changed: false,
+        }
+    }
+    #[test]
+    fn revocation_never_revives() {
+        for c in [
+            Change::FocusPid,
+            Change::FocusWindow,
+            Change::WindowMissing,
+            Change::WindowRebuilt,
+            Change::ProcessReused,
+            Change::Bounds,
+            Change::Offscreen,
+            Change::Layer,
+            Change::UnknownAx,
+            Change::UnknownInput,
+            Change::UserKey,
+            Change::UserModifier,
+            Change::UserButton,
+            Change::Expired,
+            Change::Revoked,
+            Change::FocusAba,
+            Change::RebuildAba,
+            Change::InputAba,
+        ] {
+            let mut g = fixture(c);
+            assert!(g.check(Phase::BeforeCreate, 1, false).is_err(), "{c:?}");
+            let epoch = g.lease.report.lease_epoch;
+            assert_eq!(epoch, 2, "{c:?}");
+            g.changed = false;
+            g.scenario = None;
+            g.lease.deadline = Instant::now() + Duration::from_secs(1);
+            assert!(g.check(Phase::BeforeDispatch, 2, false).is_err());
+            assert_eq!(g.lease.report.lease_epoch, epoch);
+            assert!(g.lease.report.revoked);
+        }
+    }
+    #[test]
+    fn release_is_narrow_and_input_sensitive() {
+        for c in [
+            Change::FocusPid,
+            Change::WindowMissing,
+            Change::WindowRebuilt,
+            Change::Expired,
+            Change::Revoked,
+        ] {
+            let mut g = fixture(c);
+            assert!(g.check(Phase::BeforeCreate, 1, true).is_ok());
+            assert!(g.lease.report.revoked);
+            assert!(g.check(Phase::BeforeDispatch, 2, false).is_err());
+        }
+        for c in [
+            Change::UnknownInput,
+            Change::UserKey,
+            Change::UserModifier,
+            Change::UserButton,
+        ] {
+            let mut g = fixture(c);
+            assert!(g.check(Phase::BeforeCreate, 1, true).is_err());
+        }
+        let mut g = fixture(Change::Stable);
+        g.live = true;
+        assert_eq!(
+            g.check(Phase::BeforeCreate, 1, true),
+            Err("live_release_attribution_unproven")
+        );
+    }
+    #[test]
+    fn unknown_and_slow_samples_are_not_safe_false() {
+        let mut f = fixture(Change::Stable).lease.baseline;
+        assert!(valid(&f).is_ok());
+        assert!(!held(&f));
+        f.sample_micros = 50_001;
+        assert_eq!(valid(&f), Err("facts_sample_too_slow"));
+        f.sample_micros = 0;
+        f.listen_trusted = 0;
+        assert_eq!(valid(&f), Err("input_state_unknown"));
+        f.listen_trusted = 1;
+        f.keys[3] = 1 << 63;
+        assert!(held(&f));
+        f.keys = [0; 4];
+        f.buttons = 1 << 31;
+        assert!(held(&f));
+    }
+    #[test]
+    fn bound_geometry_and_lease_deadline() {
+        let mut g = fixture(Change::Stable);
+        assert!(g.point([1., 1.], false).is_ok());
+        assert!(g.point([239., 159.], false).is_ok());
+        assert!(g.point([240., 159.], false).is_err());
+        assert!(g.check(Phase::BeforeCreate, 2, false).is_err());
+        let mut g = fixture(Change::Stable);
+        g.lease.deadline = Instant::now();
+        assert_eq!(g.check(Phase::BeforeCreate, 2, false), Err("lease_expired"));
+        assert!(g.lease.report.revoked);
+    }
+}
