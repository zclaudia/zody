--- /dev/null
+++ b/crates/cua-macos-visual/src/capture.rs
@@ -0,0 +1,248 @@
+//! Crate-private single-window ScreenCaptureKit completion bridge.
+//!
+//! The Swift object is derived from the fixed ScreenCaptureKit 8.0.1 bridge,
+//! but this crate does not depend on that wrapper or its Metal/streaming graph.
+//! No cache, lease, retry, timeout, shell/SkyLight fallback or consent bypass
+//! is present. The public capture request remains `HostNotApproved`.
+
+#![allow(dead_code)]
+
+use std::slice;
+
+use crate::error::VisualError;
+use crate::geometry::{
+    CaptureRequest, PixelDimensions, WindowIdentity, MAX_CAPTURE_SIDE, MAX_RGBA_BYTES,
+};
+use crate::observe::{finish_observation, validate_before_identity};
+use crate::png::encode_rgba_to_png;
+use crate::session::{
+    self, AdmissionDecision, CaptureObservation, CompletionStatus, NativeCompletion,
+};
+use crate::window;
+
+const ADMISSION_PROCEED: i32 = 0;
+const ADMISSION_CANCELED: i32 = 1;
+const ADMISSION_REJECTED: i32 = 2;
+
+const COMPLETION_SUCCESS: i32 = 0;
+const COMPLETION_CANCELED: i32 = 1;
+const COMPLETION_ADMISSION_REJECTED: i32 = 2;
+const COMPLETION_WINDOW_NOT_FOUND: i32 = 3;
+
+type AdmissionCallback = unsafe extern "C" fn(u64, u32, i32, i32, f64, f64, f64, f64) -> i32;
+type CompletionCallback =
+    unsafe extern "C" fn(u64, i32, u32, i32, i32, f64, f64, f64, f64, u32, u32, *const u8, usize);
+type PayloadReleasedCallback = unsafe extern "C" fn(u64);
+type CaptureWindowFn = unsafe extern "C" fn(
+    u64,
+    u32,
+    AdmissionCallback,
+    CompletionCallback,
+    PayloadReleasedCallback,
+    u32,
+    u64,
+) -> i32;
+
+extern "C" {
+    fn cua_visual_capture_window(
+        request_id: u64,
+        window_id: u32,
+        admission: AdmissionCallback,
+        completion: CompletionCallback,
+        payload_released: PayloadReleasedCallback,
+        max_side: u32,
+        max_rgba_bytes: u64,
+    ) -> i32;
+}
+
+/// Capture one exact window and return a validated, non-empty PNG frame.
+///
+/// The internal observer never adds a timeout. A missing native callback keeps
+/// its bounded slot and this wait pending. Closing the observer is only result
+/// reception closure, not proof of native stop, fence or drain.
+pub(crate) fn capture_window_png(
+    request: &CaptureRequest,
+) -> Result<crate::CapturedFrame, VisualError> {
+    request.validate()?;
+    let expected = request.expected_identity();
+
+    let before = window::window_identity(request.window_id)?;
+    validate_before_identity(&expected, &before)?;
+
+    let mut observation = start_native_capture(request)?;
+    let raw = observation.wait()?;
+
+    finish_observation(
+        &expected,
+        raw,
+        || window::window_identity(request.window_id),
+        |raw| encode_rgba_to_png(&raw.rgba, raw.dimensions.width, raw.dimensions.height),
+        || observation.ensure_open(),
+    )
+}
+
+/// Start exactly one native request after reserving one bounded callback slot.
+fn start_native_capture(request: &CaptureRequest) -> Result<CaptureObservation, VisualError> {
+    request.validate()?;
+    let coordinator = session::global();
+    let observation = coordinator.reserve(request.expected_identity())?;
+
+    // SAFETY: both callbacks are `extern "C"` functions with fixed layouts.
+    // The Swift side owns no Rust userdata and receives only the never-reused
+    // operation id, scalar bounds and a short-lived pixel pointer.
+    let status = unsafe {
+        cua_visual_capture_window(
+            observation.id(),
+            request.window_id,
+            bridge_admission,
+            bridge_completion,
+            bridge_payload_released,
+            MAX_CAPTURE_SIDE,
+            MAX_RGBA_BYTES as u64,
+        )
+    };
+    if status != 0 {
+        let error = VisualError::NativeCapture(format!(
+            "Swift capture bridge refused request with status {status}"
+        ));
+        let _ = coordinator.abort_before_native(observation.id(), error.clone());
+        return Err(error);
+    }
+    Ok(observation)
+}
+
+unsafe extern "C" fn bridge_admission(
+    request_id: u64,
+    window_id: u32,
+    pid: i32,
+    layer: i32,
+    x: f64,
+    y: f64,
+    width: f64,
+    height: f64,
+) -> i32 {
+    let actual = WindowIdentity::new(
+        window_id,
+        pid,
+        layer,
+        crate::geometry::WindowBounds::new(x, y, width, height),
+    );
+    match session::global().admit(request_id, actual) {
+        AdmissionDecision::Proceed => ADMISSION_PROCEED,
+        AdmissionDecision::Canceled => ADMISSION_CANCELED,
+        AdmissionDecision::Rejected => ADMISSION_REJECTED,
+    }
+}
+
+unsafe extern "C" fn bridge_completion(
+    request_id: u64,
+    status_code: i32,
+    window_id: u32,
+    pid: i32,
+    layer: i32,
+    x: f64,
+    y: f64,
+    width: f64,
+    height: f64,
+    image_width: u32,
+    image_height: u32,
+    rgba: *const u8,
+    rgba_len: usize,
+) {
+    let status = match status_code {
+        COMPLETION_SUCCESS => CompletionStatus::Success,
+        COMPLETION_CANCELED => CompletionStatus::Canceled,
+        COMPLETION_ADMISSION_REJECTED => CompletionStatus::AdmissionRejected,
+        COMPLETION_WINDOW_NOT_FOUND => CompletionStatus::WindowNotFound,
+        other => CompletionStatus::NativeFailure(other),
+    };
+    let facts = Some(WindowIdentity::new(
+        window_id,
+        pid,
+        layer,
+        crate::geometry::WindowBounds::new(x, y, width, height),
+    ));
+    let dimensions = if status == CompletionStatus::Success {
+        Some(PixelDimensions {
+            width: image_width,
+            height: image_height,
+        })
+    } else {
+        None
+    };
+
+    // The pixel pointer is borrowed only for this callback. Validate its length
+    // before creating a slice and copy before returning to Swift.
+    let (pixel_bytes, payload_error) = if status == CompletionStatus::Success {
+        if rgba_len as u64 > MAX_RGBA_BYTES {
+            (
+                Vec::new(),
+                Some(VisualError::NativeCapture(format!(
+                    "native RGBA length {rgba_len} exceeds {MAX_RGBA_BYTES}"
+                ))),
+            )
+        } else if rgba_len == 0 {
+            (Vec::new(), None)
+        } else if rgba.is_null() {
+            (
+                Vec::new(),
+                Some(VisualError::NativeCapture(
+                    "native RGBA pointer was null with non-zero length".to_owned(),
+                )),
+            )
+        } else {
+            (slice::from_raw_parts(rgba, rgba_len).to_vec(), None)
+        }
+    } else {
+        (Vec::new(), None)
+    };
+
+    session::global().complete(
+        request_id,
+        NativeCompletion {
+            status,
+            facts,
+            dimensions,
+            rgba: pixel_bytes,
+            payload_error,
+        },
+    );
+}
+
+pub(crate) fn bridge_symbol_address() -> usize {
+    let function: CaptureWindowFn = cua_visual_capture_window;
+    function as usize
+}
+
+/// Called by Swift only after its bridge-owned pixel buffer was deallocated.
+///
+/// This releases capacity; it does not claim that the OS callback thread or
+/// ScreenCaptureKit has quiesced, and it is not `Fenced` or `Drained` evidence.
+extern "C" fn bridge_payload_released(request_id: u64) {
+    let _ = session::global().release_callback(request_id);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::geometry::{checked_rgba_len, WindowBounds};
+    use crate::observe::RawFrame;
+
+    #[test]
+    fn bridge_symbol_is_non_null_without_call() {
+        assert_ne!(bridge_symbol_address(), 0);
+    }
+
+    #[test]
+    fn completion_payload_is_bounded_before_forming_a_frame() {
+        let raw = RawFrame {
+            dimensions: PixelDimensions {
+                width: 2,
+                height: 2,
+            },
+            rgba: vec![0; 16],
+        };
+        assert_eq!(checked_rgba_len(2, 2, raw.rgba.len()), Ok(16));
+        let _ = WindowBounds::new(0.0, 0.0, 2.0, 2.0);
+    }
+}
