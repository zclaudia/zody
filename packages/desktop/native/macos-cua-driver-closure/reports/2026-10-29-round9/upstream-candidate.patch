index 0000000..5ea806b
--- /dev/null
+++ b/crates/cua-macos-visual/src/window.rs
@@ -0,0 +1,118 @@
+//! Crate-private CGWindowList fact reader.
+//!
+//! Only on-screen layer-0 window id, owning PID, layer and bounds are read.
+//! Every required key stays optional until the pure parser accepts it; missing
+//! values are never replaced with `0`. Off-Space, minimized and accessory
+//! windows are not listed or are rejected, matching this round's support.
+
+#![allow(dead_code)]
+
+use core_foundation::{
+    array::{CFArray, CFArrayRef},
+    base::{CFGetTypeID, CFTypeRef, TCFType},
+    dictionary::CFDictionary,
+    number::CFNumber,
+    string::CFString,
+};
+use std::os::raw::c_void;
+
+use crate::error::VisualError;
+use crate::geometry::{checked_window_id, parse_window_identity, RawWindowFact, WindowIdentity};
+
+const K_CG_WINDOW_LIST_ON_SCREEN_ONLY: u32 = 1;
+const K_CG_WINDOW_LIST_EXCLUDE_DESKTOP_ELEMENTS: u32 = 16;
+const K_CG_NULL_WINDOW_ID: u32 = 0;
+
+#[link(name = "CoreGraphics", kind = "framework")]
+extern "C" {
+    fn CGWindowListCopyWindowInfo(option: u32, relative_to_window: u32) -> CFArrayRef;
+}
+
+/// Read the current on-screen WindowServer identity for exactly `window_id`.
+pub(crate) fn window_identity(window_id: u32) -> Result<WindowIdentity, VisualError> {
+    let options = K_CG_WINDOW_LIST_ON_SCREEN_ONLY | K_CG_WINDOW_LIST_EXCLUDE_DESKTOP_ELEMENTS;
+    let raw = unsafe { CGWindowListCopyWindowInfo(options, K_CG_NULL_WINDOW_ID) };
+    if raw.is_null() {
+        return Err(VisualError::WindowNotFound { window_id });
+    }
+    let windows: CFArray<CFTypeRef> = unsafe { CFArray::wrap_under_create_rule(raw as _) };
+    for item in windows.iter() {
+        let item = *item;
+        let dict_type = CFDictionary::<*const c_void, *const c_void>::type_id();
+        if unsafe { CFGetTypeID(item) } != dict_type {
+            continue;
+        }
+        let dict: CFDictionary<*const c_void, *const c_void> =
+            unsafe { CFDictionary::wrap_under_get_rule(item as _) };
+        let fact = raw_fact(&dict);
+        // 先做 checked id；无法表示或为 0 的条目不匹配，也不截断。
+        let Some(id) = checked_window_id(fact.window_id) else {
+            continue;
+        };
+        if id != window_id {
+            continue;
+        }
+        return parse_window_identity(&fact);
+    }
+    Err(VisualError::WindowNotFound { window_id })
+}
+
+fn raw_fact(dict: &CFDictionary<*const c_void, *const c_void>) -> RawWindowFact {
+    let [x, y, width, height] = raw_bounds(dict);
+    RawWindowFact {
+        window_id: number(dict, "kCGWindowNumber"),
+        pid: number(dict, "kCGWindowOwnerPID"),
+        layer: number(dict, "kCGWindowLayer"),
+        x,
+        y,
+        width,
+        height,
+    }
+}
+
+fn number(dict: &CFDictionary<*const c_void, *const c_void>, key: &str) -> Option<i64> {
+    let key = CFString::new(key);
+    dict.find(key.as_concrete_TypeRef() as *const c_void)
+        .and_then(|value| unsafe {
+            let value = *value;
+            if CFGetTypeID(value) == CFNumber::type_id() {
+                CFNumber::wrap_under_get_rule(value as _).to_i64()
+            } else {
+                None
+            }
+        })
+}
+
+fn raw_bounds(dict: &CFDictionary<*const c_void, *const c_void>) -> [Option<f64>; 4] {
+    let key = CFString::new("kCGWindowBounds");
+    let Some(value) = dict.find(key.as_concrete_TypeRef() as *const c_void) else {
+        return [None; 4];
+    };
+    unsafe {
+        let value = *value;
+        if CFGetTypeID(value) != CFDictionary::<*const c_void, *const c_void>::type_id() {
+            return [None; 4];
+        }
+        let bounds: CFDictionary<*const c_void, *const c_void> =
+            CFDictionary::wrap_under_get_rule(value as _);
+        [
+            real_number(&bounds, "X"),
+            real_number(&bounds, "Y"),
+            real_number(&bounds, "Width"),
+            real_number(&bounds, "Height"),
+        ]
+    }
+}
+
+fn real_number(dict: &CFDictionary<*const c_void, *const c_void>, key: &str) -> Option<f64> {
+    let key = CFString::new(key);
+    dict.find(key.as_concrete_TypeRef() as *const c_void)
+        .and_then(|value| unsafe {
+            let value = *value;
+            if CFGetTypeID(value) == CFNumber::type_id() {
+                CFNumber::wrap_under_get_rule(value as _).to_f64()
+            } else {
+                None
+            }
+        })
+}
diff --git b/crates/cua-macos-visual/tests/pure_visual.rs b/crates/cua-macos-visual/tests/pure_visual.rs
