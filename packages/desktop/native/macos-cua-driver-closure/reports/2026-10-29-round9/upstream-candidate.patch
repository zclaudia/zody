+mod native_lifecycle_tests {
+    use super::*;
+    fn fixture() -> (
+        Arc<SessionAuthorizationRegistry>,
+        Arc<EffectiveAuthorizationContext>,
+    ) {
+        let r = Arc::new(SessionAuthorizationRegistry::with_ceiling(
+            SessionModeCeiling::for_trusted_sessions(
+                [PermissionMode::Bounded, PermissionMode::Standard],
+                false,
+                Duration::from_secs(3600),
+                Duration::from_secs(1800),
+            )
+            .unwrap(),
+        ));
+        let d = tempfile::tempdir().unwrap();
+        let p = d.path().join("manifest.yaml");
+        std::fs::write(&p,"version: 1\nmode: bounded\nexpires_after: 1h\nidle_timeout: 30m\nresources: {}\nallow:\n  tools: [click]\n").unwrap();
+        let m = Arc::new(crate::session_manifest::load_manifest(&p).unwrap());
+        let (h, c) = r.trusted_in_process_binding();
+        r.bind_delegated_session(
+            &h,
+            &c,
+            DelegatedSessionRequest {
+                public_session: "native-unit".into(),
+                transport_session: "native-unit-transport".into(),
+                mode: PermissionMode::Bounded,
+                ttl: Duration::from_secs(3600),
+                idle_ttl: Duration::from_secs(1800),
+                capability_manifest: Some(m),
+            },
+        )
+        .unwrap();
+        let ctx = r
+            .resolve_delegated(&c, "native-unit", "native-unit-transport")
+            .unwrap();
+        (r, ctx)
+    }
+    #[test]
+    fn clone_expiry_latches_survive_clock_rollback() {
+        for seconds in [1801, 3601] {
+            let (_r, c) = fixture();
+            let clone = (*c).clone();
+            clone.development_advance_lifetime(Duration::from_secs(seconds));
+            assert!(c.is_expired());
+            crate::native_domain::with(|_| {
+                c.native_clock_offset.store(0, Ordering::Release);
+            });
+            assert!(clone.is_expired());
+            assert!(c.commit_authorized_dispatch().is_err());
+        }
+        for seconds in [1801, 3601] {
+            let (_r, c) = fixture();
+            let m = c.capability_manifest().unwrap();
+            let clone = m.clone();
+            clone.development_advance_lifetime(Duration::from_secs(seconds));
+            assert!(m.check_lifetime().is_err());
+            m.development_test_rollback_clock();
+            assert!(clone.check_lifetime().is_err());
+            assert!(c.commit_authorized_dispatch().is_err());
+        }
+    }
+    #[test]
+    fn failed_manifest_commit_never_refreshes_context() {
+        let (_r, c) = fixture();
+        let before = c.development_lifetime_stamp();
+        c.capability_manifest()
+            .unwrap()
+            .development_advance_lifetime(Duration::from_secs(1801));
+        assert!(c.commit_authorized_dispatch().is_err());
+        assert_eq!(before, c.development_lifetime_stamp());
+        assert!(!c.is_expired());
+    }
+    #[test]
+    fn runtime_close_and_drop_revoke_retained_contexts() {
+        let (r, c) = fixture();
+        let compatibility = r
+            .compatibility_context(PermissionMode::Standard, None)
+            .unwrap();
+        let clone = (*c).clone();
+        r.close_runtime();
+        assert!(c.is_revoked() && clone.is_revoked() && compatibility.is_revoked());
+        assert!(r
+            .compatibility_context(PermissionMode::Standard, None)
+            .is_err());
+        let (r, c) = fixture();
+        let compatibility = r
+            .compatibility_context(PermissionMode::Standard, None)
+            .unwrap();
+        drop(r);
+        assert!(c.is_expired() && compatibility.is_expired());
+    }
+    #[test]
+    fn native_lifetime_checks_never_refresh_idle() {
+        let (_r, c) = fixture();
+        let before = c.development_lifetime_stamp();
+        for _ in 0..8 {
+            crate::native_domain::with(|t| c.native_check_under(t)).unwrap();
+        }
+        assert_eq!(before, c.development_lifetime_stamp());
+    }
+}
