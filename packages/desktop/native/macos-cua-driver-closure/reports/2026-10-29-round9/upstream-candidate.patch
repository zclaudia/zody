+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn bad_payload_error_is_terminal_and_releases_on_payload_released() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        let completion = NativeCompletion {
+            status: CompletionStatus::Success,
+            facts: Some(expected()),
+            dimensions: Some(PixelDimensions {
+                width: 2,
+                height: 2,
+            }),
+            rgba: vec![0; 15],
+            payload_error: None,
+        };
+        assert_eq!(
+            coordinator.complete(id, completion),
+            CompletionOutcome::Delivered
+        );
+        coordinator.release_callback(id);
+        assert!(matches!(
+            observation.wait(),
+            Err(VisualError::RgbaLengthMismatch { .. })
+        ));
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn wait_is_one_shot_and_final_check_observes_late_cancel() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        assert_eq!(
+            coordinator.complete(id, success_completion(2, 2)),
+            CompletionOutcome::Delivered
+        );
+        observation.wait().expect("first consume");
+        assert_eq!(observation.wait(), Err(VisualError::CaptureAlreadyConsumed));
+        observation.cancel();
+        assert_eq!(observation.ensure_open(), Err(VisualError::CaptureCanceled));
+        coordinator.release_callback(id);
+    }
+
+    #[test]
+    fn release_before_completion_is_a_terminal_protocol_error() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        assert_eq!(
+            coordinator.release_callback(id),
+            CallbackReleaseOutcome::Released
+        );
+        assert!(matches!(
+            observation.wait(),
+            Err(VisualError::NativeCapture(_))
+        ));
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn duplicate_admission_is_rejected_without_releasing_the_first_capture() {
+        // 竞态依据：框架重复 enumeration callback 不能第二次进入 admission，
+        // 也不能因为第二个 Rejected 提前结束仍在途的第一次 capture。Rust 侧
+        // 用 phase 拒绝重复 admission，slot 仍由第一个 completion 的
+        // payload_released 释放。
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Rejected
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(
+            coordinator.complete(id, success_completion(1, 1)),
+            CompletionOutcome::Delivered
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(observation.wait().expect("first completion").rgba.len(), 4);
+        assert_eq!(
+            coordinator.release_callback(id),
+            CallbackReleaseOutcome::Released
+        );
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+
+    #[test]
+    fn cancel_handle_wakes_a_thread_blocked_in_wait_and_keeps_the_slot() {
+        let coordinator = CaptureCoordinator::new(1);
+        let mut observation = reserved(&coordinator);
+        let id = observation.id();
+        assert_eq!(
+            coordinator.admit(id, expected()),
+            AdmissionDecision::Proceed
+        );
+        let cancel = observation.cancel_handle();
+        let coordinator_for_waiter = coordinator.clone();
+        let barrier = Arc::new(Barrier::new(2));
+        let waiter_barrier = Arc::clone(&barrier);
+        let waiter = thread::spawn(move || {
+            waiter_barrier.wait();
+            observation.wait()
+        });
+
+        barrier.wait();
+        let mut spins = 0_u32;
+        while coordinator_for_waiter.waiters(id) == 0 {
+            assert!(spins < 100_000, "wait did not become blocked");
+            spins += 1;
+            thread::yield_now();
+        }
+        cancel.cancel();
+        assert_eq!(
+            waiter.join().expect("wait thread"),
+            Err(VisualError::CaptureCanceled)
+        );
+
+        // Cancellation wakes the receiver but does not release in-flight
+        // capacity; only the Swift payload_released notification may do that.
+        assert_eq!(coordinator.in_flight(), 1);
+        assert_eq!(
+            coordinator.complete(id, success_completion(1, 1)),
+            CompletionOutcome::DroppedCanceled
+        );
+        assert_eq!(coordinator.in_flight(), 1);
+        coordinator.release_callback(id);
+        assert_eq!(coordinator.in_flight(), 0);
+    }
+}
diff --git b/crates/cua-macos-visual/src/swift_link.rs b/crates/cua-macos-visual/src/swift_link.rs
new file mode 100644
index 0000000..237e96b
--- /dev/null
+++ b/crates/cua-macos-visual/src/swift_link.rs
@@ -0,0 +1,165 @@
+//! Pure helpers for locating the active toolchain's Swift compatibility libs.
+//!
+//! This file is shared by `build.rs` (with `#[path]`) and the crate's pure unit
+//! tests. Filesystem existence is checked separately by the build script.
+
+use std::path::{Path, PathBuf};
+
+/// Parse the single absolute compiler path returned by
+/// `/usr/bin/xcrun --find swiftc`.
+pub(crate) fn parse_xcrun_swiftc(stdout: &[u8]) -> Result<PathBuf, &'static str> {
+    let compiler = parse_xcrun_path(stdout)?;
+    if compiler.file_name() != Some(std::ffi::OsStr::new("swiftc")) {
+        return Err("compiler path does not end in swiftc");
+    }
+    swift_lib_dir_from_compiler(&compiler)
+        .ok_or("compiler path is not <toolchain>/usr/bin/swiftc")?;
+    Ok(compiler)
+}
+
+/// Parse one absolute path returned by `xcrun`, with no shell or fallback.
+pub(crate) fn parse_xcrun_path(stdout: &[u8]) -> Result<PathBuf, &'static str> {
+    let value = std::str::from_utf8(stdout).map_err(|_| "output is not UTF-8")?;
+    let value = value.trim();
+    if value.is_empty() {
+        return Err("output is empty");
+    }
+    let mut lines = value.lines();
+    let line = lines.next().ok_or("output is empty")?;
+    if lines.next().is_some() {
+        return Err("output contains more than one line");
+    }
+    let path = Path::new(line);
+    if !path.is_absolute() {
+        return Err("path is not absolute");
+    }
+    Ok(path.to_path_buf())
+}
+
+/// Match the Cargo target architecture to the fixed macOS 14.2 Swift triple.
+pub(crate) fn swift_target_triple(arch: &str) -> Option<&'static str> {
+    match arch {
+        "aarch64" => Some("arm64-apple-macos14.2"),
+        "x86_64" => Some("x86_64-apple-macos14.2"),
+        _ => None,
+    }
+}
+
+/// Derive `usr/lib/swift/macosx` from `<toolchain>/usr/bin/swiftc`.
+pub(crate) fn swift_lib_dir_from_compiler(compiler: &Path) -> Option<PathBuf> {
+    if !compiler.is_absolute() || compiler.file_name()? != "swiftc" {
+        return None;
+    }
+    let bin = compiler.parent()?;
+    if bin.file_name()? != "bin" {
+        return None;
+    }
+    let usr = bin.parent()?;
+    if usr.file_name()? != "usr" {
+        return None;
+    }
+    Some(usr.join("lib/swift/macosx"))
+}
+
+/// Both libraries are required before the directory is trusted for linking.
+#[allow(dead_code)]
+pub(crate) fn has_required_compat_libs(directory: &Path) -> bool {
+    directory.join("libswiftCompatibility56.a").is_file()
+        && directory.join("libswiftCompatibilityPacks.a").is_file()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_clt_swiftc() {
+        assert_eq!(
+            parse_xcrun_swiftc(b"/Library/Developer/CommandLineTools/usr/bin/swiftc\n"),
+            Ok(PathBuf::from(
+                "/Library/Developer/CommandLineTools/usr/bin/swiftc"
+            ))
+        );
+        assert_eq!(
+            swift_lib_dir_from_compiler(Path::new(
+                "/Library/Developer/CommandLineTools/usr/bin/swiftc"
+            )),
+            Some(PathBuf::from(
+                "/Library/Developer/CommandLineTools/usr/lib/swift/macosx"
+            ))
+        );
+    }
+
+    #[test]
+    fn parses_xcode_toolchain_swiftc() {
+        let compiler = b"/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swiftc\n";
+        assert_eq!(
+            parse_xcrun_swiftc(compiler),
+            Ok(PathBuf::from(
+                "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swiftc"
+            ))
+        );
+        assert_eq!(
+            swift_lib_dir_from_compiler(Path::new(
+                "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swiftc",
+            )),
+            Some(PathBuf::from(
+                "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/macosx"
+            ))
+        );
+    }
+
+    #[test]
+    fn rejects_relative_wrong_layout_and_wrong_file_name() {
+        for output in [
+            b"usr/bin/swiftc\n".as_slice(),
+            b"/Library/Developer/CommandLineTools/bin/swiftc\n".as_slice(),
+            b"/Library/Developer/CommandLineTools/usr/lib/swiftc\n".as_slice(),
+            b"/Library/Developer/CommandLineTools/usr/bin/clang\n".as_slice(),
+        ] {
+            assert!(parse_xcrun_swiftc(output).is_err(), "{output:?}");
+        }
+        assert_eq!(
+            swift_lib_dir_from_compiler(Path::new("usr/bin/swiftc")),
+            None
+        );
+        assert_eq!(
+            swift_lib_dir_from_compiler(Path::new(
+                "/Library/Developer/CommandLineTools/bin/swiftc"
+            )),
+            None
+        );
+    }
+
+    #[test]
+    fn rejects_empty_multiline_and_non_utf8_output_without_fallback() {
+        assert!(parse_xcrun_swiftc(b"").is_err());
+        assert!(parse_xcrun_swiftc(b"\n").is_err());
+        assert!(parse_xcrun_swiftc(
+            b"/Library/Developer/CommandLineTools/usr/bin/swiftc\n/tmp/swiftc\n"
+        )
+        .is_err());
+        assert!(parse_xcrun_swiftc(&[0xFF]).is_err());
+    }
+
+    #[test]
+    fn parses_sdk_path_and_fixed_swift_triples() {
+        assert_eq!(
+            parse_xcrun_path(b"/Library/Developer/CommandLineTools/SDKs/MacOSX15.2.sdk\n"),
+            Ok(PathBuf::from(
+                "/Library/Developer/CommandLineTools/SDKs/MacOSX15.2.sdk"
+            ))
+        );
+        assert!(parse_xcrun_path(b"relative/SDK\n").is_err());
+        assert!(parse_xcrun_path(b"/one\n/two\n").is_err());
+        assert_eq!(
+            swift_target_triple("aarch64"),
+            Some("arm64-apple-macos14.2")
+        );
+        assert_eq!(
+            swift_target_triple("x86_64"),
+            Some("x86_64-apple-macos14.2")
+        );
+        assert_eq!(swift_target_triple("riscv64"), None);
+    }
+}
diff --git b/crates/cua-macos-visual/src/window.rs b/crates/cua-macos-visual/src/window.rs
