+fn checkpoint(b: &dyn Boundary, p: Phase, n: usize, release: bool) -> Result<(), Failure> {
+    catch_unwind(AssertUnwindSafe(|| b.checkpoint(p, n, release))).unwrap_or(Err(Failure::Unknown))
