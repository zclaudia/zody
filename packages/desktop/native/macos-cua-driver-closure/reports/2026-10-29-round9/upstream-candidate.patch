+#[cfg(test)]
+mod handoff_tests {
+    use super::*;
+    #[test]
+    fn cancellation_and_handoff_are_serialized() {
+        use std::sync::mpsc::{channel, TryRecvError};
+        let cell = Arc::new(NativeActionCell::new());
+        assert!(cell.commit());
+        let (entered, rx) = channel();
+        let (release, wait) = channel();
+        let c = cell.clone();
+        let worker = std::thread::spawn(move || {
+            c.handoff(false, || {
+                entered.send(()).unwrap();
+                wait.recv().unwrap();
+            })
+        });
+        rx.recv().unwrap();
+        let (attempt, at) = channel();
+        let (done, result) = channel();
+        let c = cell.clone();
+        let cancel = std::thread::spawn(move || {
+            attempt.send(()).unwrap();
+            done.send(c.cancel()).unwrap();
+        });
+        at.recv().unwrap();
+        assert_eq!(result.try_recv(), Err(TryRecvError::Empty));
+        release.send(()).unwrap();
+        assert_eq!(worker.join().unwrap(), Ok(()));
+        assert_eq!(result.recv().unwrap(), NativeActionState::UnknownAfterGate);
+        cancel.join().unwrap();
+        let count = std::sync::atomic::AtomicUsize::new(0);
+        assert!(cell
+            .handoff(false, || {
+                count.fetch_add(1, Ordering::SeqCst);
+            })
+            .is_err());
+        assert_eq!(count.load(Ordering::SeqCst), 0);
+    }
+    #[test]
+    fn cancel_wins_before_handoff_and_release_is_separate() {
+        let c = NativeActionCell::new();
+        assert!(c.commit());
+        assert_eq!(c.cancel(), NativeActionState::UnknownAfterGate);
+        assert!(c
+            .handoff(false, || panic!("ordinary callback escaped"))
+            .is_err());
+        let mut n = 0;
+        assert!(c.handoff(true, || n += 1).is_ok());
+        assert_eq!(n, 1);
+    }
+}
