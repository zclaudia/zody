+pub fn copy_window_info(
+    option: CGWindowListOption,
+    relative_to_window: CGWindowID,
+) -> Option<CFArray> {
+    unsafe {
+        let array = CGWindowListCopyWindowInfo(option, relative_to_window);
+        if array.is_null() {
+            None
+        } else {
+            Some(TCFType::wrap_under_create_rule(array))
+        }
+    }
