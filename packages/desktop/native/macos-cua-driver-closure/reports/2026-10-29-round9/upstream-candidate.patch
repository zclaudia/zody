+
+        let mut actual_count: u32 = 0;
+
+        let result =
+            unsafe { CGGetActiveDisplayList(expected_count, buf.as_mut_ptr(), &mut actual_count) };
+        if result == 0 {
+            buf.truncate(actual_count as usize);
+            Ok(buf)
+        } else {
+            Err(result)
+        }
+    }
