+// Pure upstream foreground interpolation, copied with fixed revision provenance; no platform dependency cycle.
+fn foreground_drag_plan(from: [f64; 2], to: [f64; 2], steps: usize) -> Vec<(String, [f64; 2])> {
+    let mut v = vec![("Move".into(), from), ("Down".into(), from)];
+    for i in 1..=steps {
+        let t = i as f64 / steps as f64;
+        v.push((
+            "Dragged".into(),
+            [
+                from[0] + (to[0] - from[0]) * t,
+                from[1] + (to[1] - from[1]) * t,
+            ],
+        ));
+    }
+    v.push(("Up".into(), to));
+    v
+}
+/// Receipt authority is private and already settled; Report is never accepted as completion input.
+pub struct NativeTerminalReceipt {
+    report: Report,
+    terminal: crate::native_capability::NativeActionState,
+    _single: std::marker::PhantomData<std::cell::Cell<()>>,
+}
+impl NativeTerminalReceipt {
+    pub fn report(&self) -> &Report {
+        &self.report
+    }
+    pub fn terminal(&self) -> crate::native_capability::NativeActionState {
+        self.terminal
+    }
+}
+fn execute_owned(
+    cap: NativeWorkerCapability,
+    b: &dyn Boundary,
+    scenario: Option<Scenario>,
+) -> NativeTerminalReceipt {
+    // cap Drop retains failclosed custody if an unexpected unwind escapes; no host finish callback.
+    let mut report = execute_inner(&cap, b, scenario);
+    if checkpoint(b, Phase::BeforeSettle, 0, false).is_err() {
+        report.ledger_verified = false;
+        report.error = Some("before_settle_failed".into());
+    }
+
+    cap.node.tree.custody.settle(
+        report.ledger_verified,
+        !report.cleanup_debt.is_empty(),
+        "ledger_verified_single_hid_transport",
+    );
+    let terminal = cap.node.tree.custody.cell.get();
+    if terminal != crate::native_capability::NativeActionState::Completed && report.ledger_verified
+    {
+        report.ledger_verified = false;
+        report.cancelled = true;
+        report
+            .error
+            .get_or_insert_with(|| "authorization_or_owner_closed_before_terminal".into());
+    }
+    let _ = checkpoint(b, Phase::AfterSettle, 0, false);
+    NativeTerminalReceipt {
+        report,
+        terminal,
+        _single: std::marker::PhantomData,
+    }
+}
+struct Binding {
+    tag: unsafe extern "C" fn(u64, u64, u32),
+}
+extern "C" {
+    fn CGEventPost(
+        tap: core_graphics::event::CGEventTapLocation,
+        event: core_graphics::sys::CGEventRef,
