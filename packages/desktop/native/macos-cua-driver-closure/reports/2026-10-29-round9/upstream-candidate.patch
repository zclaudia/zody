new file mode 100644
index 0000000..efadfd5
--- /dev/null
+++ b/crates/cua-driver-core/src/native_capability.rs
@@ -0,0 +1,898 @@
+//! Candidate native capability tree; no serialization, raw constructor, Clone or JSON authority.
+use crate::protocol::ToolResult;
+use serde_json::{json, Value};
+use std::{
+    future::Future,
+    sync::{
+        atomic::{AtomicBool, AtomicU8, Ordering},
+        Arc, Mutex, OnceLock,
+    },
+};
+pub trait NativeActionFence: Send + Sync {
+    fn active(&self) -> bool;
+    fn reserve_event(&self) -> bool;
+    fn action_id(&self) -> u64;
+    fn action_cell(&self) -> Arc<NativeActionCell>;
+}
+#[derive(Clone, Copy, Debug, PartialEq, serde::Serialize)]
+#[repr(u8)]
+pub enum NativeActionState {
+    Pending,
+    Committed,
+    NotSentAfterGate,
+    CancelledBeforeGate,
+    UnknownAfterGate,
+    Completed,
+    RefusedBeforeGate,
+}
+/// Control与custody共用的唯一动作事实，不调用外部terminal回调。
+pub struct NativeActionCell(
+    AtomicU8,
+    std::sync::atomic::AtomicU64,
+    Mutex<()>,
+    std::sync::atomic::AtomicUsize,
+);
+static NEXT_TERMINAL: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+impl NativeActionCell {
+    pub fn new() -> Self {
+        Self(
+            AtomicU8::new(NativeActionState::Pending as u8),
+            std::sync::atomic::AtomicU64::new(0),
+            Mutex::new(()),
+            std::sync::atomic::AtomicUsize::new(0),
+        )
+    }
+    /// 只读真实custody存活事实；terminal/observer结束不能代替所有权释放。
+    pub fn custody_quiescent(&self) -> bool {
+        self.3.load(Ordering::Acquire) == 0
+    }
+    fn mark_terminal(&self) {
+        let rank = NEXT_TERMINAL.fetch_add(1, Ordering::SeqCst);
+        let _ = self
+            .1
+            .compare_exchange(0, rank, Ordering::SeqCst, Ordering::SeqCst);
+    }
+    pub fn terminal_rank(&self) -> u64 {
+        self.1.load(Ordering::SeqCst)
+    }
+    pub fn is_terminal(&self) -> bool {
+        self.terminal_rank() != 0
+    }
+    pub fn get(&self) -> NativeActionState {
+        use NativeActionState::*;
+        match self.0.load(Ordering::SeqCst) {
+            0 => Pending,
+            1 => Committed,
+            2 => NotSentAfterGate,
+            3 => CancelledBeforeGate,
+            4 => UnknownAfterGate,
+            5 => Completed,
+            _ => RefusedBeforeGate,
+        }
+    }
+    pub fn commit(&self) -> bool {
+        self.0
+            .compare_exchange(
+                NativeActionState::Pending as u8,
+                NativeActionState::Committed as u8,
+                Ordering::SeqCst,
+                Ordering::SeqCst,
+            )
+            .is_ok()
+    }
+    fn update<F: Fn(NativeActionState) -> NativeActionState>(&self, f: F) -> NativeActionState {
+        loop {
+            let old = self.get();
+            let new = f(old);
+            if self
+                .0
+                .compare_exchange(old as u8, new as u8, Ordering::SeqCst, Ordering::SeqCst)
+                .is_ok()
+            {
+                return new;
+            }
+        }
+    }
+    pub fn cancel(&self) -> NativeActionState {
+        let _handoff = self.2.lock().unwrap_or_else(|p| p.into_inner());
+        use NativeActionState::*;
+        self.update(|v| match v {
+            Pending => CancelledBeforeGate,
+            Committed => UnknownAfterGate,
+            other => other,
+        })
+    }
+    pub fn refuse_pending(&self) {
+        use NativeActionState::*;
+        let state = self.update(|v| if v == Pending { RefusedBeforeGate } else { v });
+        if matches!(state, RefusedBeforeGate | CancelledBeforeGate) {
+            self.mark_terminal();
+        }
+    }
+    #[cfg(test)]
+    fn handoff(&self, release: bool, post: impl FnOnce()) -> Result<(), &'static str> {
+        self.handoff_checked(release, |_| true, post)
+    }
+    fn handoff_checked(
+        &self,
+        release: bool,
+        valid_owner: impl FnOnce(&crate::native_domain::Token<'_>) -> bool,
+        post: impl FnOnce(),
+    ) -> Result<(), &'static str> {
+        crate::native_domain::with(|token| {
+            let _handoff = self.2.lock().unwrap_or_else(|p| p.into_inner());
+            if process_quarantined()
+                || self.is_terminal()
+                || (!release && self.get() != NativeActionState::Committed)
+            {
+                return Err("handoff_cancelled_or_terminal");
+            }
+            if !valid_owner(token) {
+                return Err("handoff_owner_or_authorization_invalid");
+            }
+            post();
+            Ok(())
+        })
+    }
+    fn finish(&self, started: bool, completed: bool, owner_fault: bool) {
+        let _handoff = self.2.lock().unwrap_or_else(|p| p.into_inner());
+        use NativeActionState::*;
+        self.update(|v| match v {
+            Pending => RefusedBeforeGate,
+            Committed | UnknownAfterGate if owner_fault => UnknownAfterGate,
+            Committed => {
+                if completed {
+                    Completed
+                } else if started {
+                    UnknownAfterGate
+                } else {
+                    NotSentAfterGate
+                }
+            }
+            UnknownAfterGate if !started => NotSentAfterGate,
+            other => other,
+        });
+        self.mark_terminal();
+    }
+}
+// 稳定隔离只保留原生lane和脱敏记录，不保留Engine/Bridge/context，且无reset。
+struct Debt {
+    _lane: Option<tokio::sync::OwnedMutexGuard<()>>,
+}
+struct ProcessState {
+    debts: Vec<Debt>,
+    records: Vec<Value>,
+}
+static PROCESS: OnceLock<Mutex<ProcessState>> = OnceLock::new();
+static POISON: OnceLock<tokio::sync::watch::Sender<bool>> = OnceLock::new();
+static NEXT_CUSTODY: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+fn process() -> &'static Mutex<ProcessState> {
+    PROCESS.get_or_init(|| {
+        Mutex::new(ProcessState {
+            debts: vec![],
+            records: vec![],
+        })
+    })
+}
+fn poison() -> &'static tokio::sync::watch::Sender<bool> {
+    POISON.get_or_init(|| tokio::sync::watch::channel(false).0)
+}
+pub(crate) fn quarantine_watch() -> tokio::sync::watch::Receiver<bool> {
+    poison().subscribe()
+}
+/// 仅供可信gate的最终短提交段；不能在闭包内等待frame/capture/lane。
+pub fn with_process_admission<T>(
+    f: impl FnOnce() -> Result<T, ToolResult>,
+) -> Result<Result<T, ToolResult>, &'static str> {
+    let context = crate::tool::current_dispatch_authorization_context()
+        .ok_or("native_admission_context_missing")?;
+    crate::native_domain::with(|t| {
+        if process_quarantined() {
+            return Err("native_process_quarantined");
+        }
+        context
+            .native_check_under(t)
+            .map_err(|_| "native_admission_context_closed")?;
+        let admitted = f();
+        if admitted.is_ok() {
+            context
+                .commit_under(t)
+                .map_err(|_| "native_admission_context_closed")?;
+        }
+        Ok(admitted)
+    })
+}
+pub fn process_quarantined() -> bool {
+    *poison().borrow()
+}
+#[cfg(feature = "zody-dev-probe")]
+pub fn development_process_snapshot() -> Value {
+    let p = process().lock().unwrap_or_else(|e| e.into_inner());
+    json!({"quarantined":process_quarantined(),"retained_guards":p.debts.iter().filter(|d|d._lane.is_some()).count(),"debt_records":p.debts.len(),"record_capacity":128,"records":p.records})
+}
+struct CustodyState {
+    actuator_claimed: bool,
+    worker_taken: bool,
+    lifetime_issued: bool,
+    started: bool,
+    finished: bool,
+    lane: Option<tokio::sync::OwnedMutexGuard<()>>,
+}
+pub(crate) struct Custody {
+    id: u64,
+    fence: Arc<dyn NativeActionFence>,
+    action_id: u64,
+    pub(crate) cell: Arc<NativeActionCell>,
+    context: Option<Arc<crate::session_authorization::EffectiveAuthorizationContext>>,
+    state: Mutex<CustodyState>,
+}
+impl Drop for Custody {
+    fn drop(&mut self) {
+        // 修复依据：只有最后一个真实custody Arc释放才允许Helper物理回收。
+        let previous = self.cell.3.fetch_sub(1, Ordering::AcqRel);
+        assert!(previous > 0, "custody liveness underflow");
+    }
+}
+impl Custody {
+    pub(crate) fn settle(&self, completed: bool, debt: bool, reason: &str) {
+        self.settle_inner(completed, debt, reason, false);
+    }
+    fn close_unfinished_return(&self) {
+        let unfinished = {
+            let s = self.state.lock().unwrap_or_else(|e| e.into_inner());
+            s.worker_taken && !s.finished
+        };
+        if unfinished {
+            self.settle_inner(
+                false,
+                true,
+                "dispatch_returned_without_worker_terminal",
+                true,
+            );
+        }
+    }
+    fn settle_inner(&self, completed: bool, debt: bool, reason: &str, owner_fault: bool) {
+        // 修复依据：finished/lane、terminal与poison一起在域中线性化，不能先移走lane再等待其他cell。
+        crate::native_domain::with(|token| {
+            let (lane, started) = {
+                let mut s = self.state.lock().unwrap_or_else(|e| e.into_inner());
+                if s.finished {
+                    return;
+                }
+                s.finished = true;
+                (s.lane.take(), s.started)
+            };
+            let ledger_completed = completed;
+            let completed = completed
+                && !process_quarantined()
+                && self
+                    .context
+                    .as_ref()
+                    .is_some_and(|c| c.native_check_under(token).is_ok());
+            self.cell.finish(started, completed, owner_fault);
+            let terminal = self.cell.get();
+            let record = json!({"custody_id":self.id,"action_id":self.action_id,"started":started,"completed":terminal==NativeActionState::Completed,"sink_completed":ledger_completed,"terminal":terminal,"owner_protocol_fault":owner_fault,"quarantined":debt,"reason":reason});
+            let clean_lane = {
+                let mut p = process().lock().unwrap_or_else(|e| e.into_inner());
+                if p.records.len() == 128 {
+                    p.records.remove(0);
+                }
+                p.records.push(record);
+                if debt {
+                    p.debts.push(Debt { _lane: lane });
+                    // 实际guard已进入稳定owner后才发布poison；排队者醒来拒绝，不等待隔离lane。
+                    poison().send_replace(true);
+                    None
+                } else {
+                    lane
+                }
+            };
+            // 权威终态是同一cell上的受控CAS；析构/结束阶段不再执行host callback。
+            // 干净lane也要在账本终态之后才释放。
+            drop(clean_lane);
+        });
+    }
+    fn abandon_worker(&self) {
+        let started = self.state.lock().unwrap_or_else(|e| e.into_inner()).started;
+        self.settle(
+            false,
+            started,
+            if started {
+                "worker_owner_dropped_after_start"
+            } else {
+                "worker_owner_dropped_before_start"
+            },
+        );
+    }
+}
+/// 从final gate之前持有；不能通过公开构造器或JSON创建。
+pub(crate) struct DispatchCustody {
+    inner: Arc<Custody>,
+}
+impl DispatchCustody {
+    pub(crate) fn new(
+        fence: Arc<dyn NativeActionFence>,
+        lane: Option<tokio::sync::OwnedMutexGuard<()>>,
+    ) -> Result<Self, &'static str> {
+        // 两个trait方法只在commit前调用一次；panic转为拒绝，不在settle里重入。
+        let (action_id, cell) = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            (fence.action_id(), fence.action_cell())
+        }))
+        .map_err(|_| "invalid_native_fence_identity")?;
+        let context = crate::tool::current_dispatch_authorization_context();
+        #[cfg(not(test))]
+        if context.is_none() {
+            return Err("native_custody_context_missing");
+        }
+        cell.3.fetch_add(1, Ordering::AcqRel);
+        Ok(Self {
+            inner: Arc::new(Custody {
+                id: NEXT_CUSTODY.fetch_add(1, Ordering::SeqCst),
+                fence,
+                action_id,
+                cell,
+                context,
+                state: Mutex::new(CustodyState {
+                    actuator_claimed: false,
+                    worker_taken: false,
+                    lifetime_issued: false,
+                    started: false,
+                    finished: false,
+                    lane,
+                }),
+            }),
+        })
+    }
+}
+impl Drop for DispatchCustody {
+    fn drop(&mut self) {
+        let claimed = self
+            .inner
+            .state
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .worker_taken;
+        if !claimed {
+            self.inner
+                .settle(false, false, "dispatch_owner_dropped_before_worker");
+        }
+    }
+}
+struct Budget {
+    delegated: bool,
+    worker_taken: bool,
+    events: u32,
+}
+pub(crate) struct Tree {
+    fence: Option<Arc<dyn NativeActionFence>>,
+    budget: Mutex<Budget>,
+    pub(crate) custody: Arc<Custody>,
+}
+pub(crate) struct Node {
+    name: String,
+    args: Value,
+    depth: u8,
+    entered: AtomicBool,
+    admitted: AtomicBool,
+    delegated: AtomicBool,
+    pub(crate) tree: Arc<Tree>,
+}
+tokio::task_local! {static CURRENT:Arc<Node>;}
+#[cfg(test)]
+pub(crate) async fn scope_root<F: Future>(
+    name: &str,
+    args: Value,
+    fence: Option<Arc<dyn NativeActionFence>>,
+    native_lane: Option<tokio::sync::OwnedMutexGuard<()>>,
+    f: F,
+) -> F::Output {
+    let custody = DispatchCustody::new(fence.expect("trusted fence"), native_lane).unwrap();
+    scope_root_owned(name, args, custody, f).await
+}
+pub(crate) async fn scope_root_owned<F: Future>(
+    name: &str,
+    args: Value,
+    custody: DispatchCustody,
+    f: F,
+) -> F::Output {
+    let tree = Arc::new(Tree {
+        fence: Some(custody.inner.fence.clone()),
+        custody: custody.inner.clone(),
+        budget: Mutex::new(Budget {
+            delegated: false,
+            worker_taken: false,
+            events: 0,
+        }),
+    });
+    let result = CURRENT
+        .scope(
+            Arc::new(Node {
+                name: name.into(),
+                args,
+                depth: 0,
+                entered: AtomicBool::new(false),
+                admitted: AtomicBool::new(false),
+                delegated: AtomicBool::new(false),
+                tree,
+            }),
+            f,
+        )
+        .await;
+    // 正常返回承诺worker已终结；缺失终态先fence/隔离。observer Drop不走这里。
+    custody.inner.close_unfinished_return();
+    drop(custody);
+    result
+}
+fn refusal(code: &str) -> ToolResult {
+    ToolResult::error(code).with_structured(json!({"code":code}))
+}
+pub fn require_platform_dispatch(name: &str, args: &Value) -> Result<(), ToolResult> {
+    if CURRENT
+        .try_with(|p| {
+            let fresh = !p.entered.swap(true, Ordering::SeqCst);
+            let valid = fresh && p.name == name && p.args == *args;
+            if valid {
+                p.admitted.store(true, Ordering::SeqCst);
+            }
+            valid
+        })
+        .unwrap_or(false)
+    {
+        Ok(())
+    } else {
+        Err(refusal("canonical_platform_proof_required"))
+    }
+}
+#[derive(Clone, Copy)]
+pub enum ChildEdge {
+    ClickLeaf,
+    DragRecursion,
+}
+/// Opaque one-shot child, minted only under the current canonical scope.
+pub struct NativeChildCapability {
+    node: Arc<Node>,
+}
+pub fn derive_native_child(
+    edge: ChildEdge,
+    name: &str,
+    args: &Value,
+) -> Result<NativeChildCapability, ToolResult> {
+    let p = CURRENT
+        .try_with(Arc::clone)
+        .map_err(|_| refusal("no_parent_capability"))?;
+    let allowed = match edge {
+        ChildEdge::ClickLeaf => p.name == "click" && name == "click",
+        ChildEdge::DragRecursion => p.name == "drag" && name == "drag",
+    };
+    let mut b = p.tree.budget.lock().unwrap();
+    if !allowed
+        || p.args != *args
+        || p.depth != 0
+        || !p.admitted.load(Ordering::SeqCst)
+        || b.delegated
+        || b.worker_taken
+        || b.events != 0
+        || !p.tree.fence.as_ref().is_some_and(|f| f.active())
+    {
+        return Err(refusal("native_child_not_admitted"));
+    }
+    // 委派消耗父节点的执行权；不允许父子各发一次，也不承认后台已发动作后的前台重试。
+    b.delegated = true;
+    p.delegated.store(true, Ordering::SeqCst);
+    Ok(NativeChildCapability {
+        node: Arc::new(Node {
+            name: name.into(),
+            args: args.clone(),
+            depth: p.depth + 1,
+            entered: AtomicBool::new(false),
+            admitted: AtomicBool::new(false),
+            delegated: AtomicBool::new(false),
+            tree: p.tree.clone(),
+        }),
+    })
+}
+pub async fn scope_native_child<F: Future>(
+    child: NativeChildCapability,
+    f: F,
+) -> Result<F::Output, ToolResult> {
+    let valid = CURRENT
+        .try_with(|p| {
+            Arc::ptr_eq(&p.tree, &child.node.tree)
+                && p.depth + 1 == child.node.depth
+                && p.delegated.load(Ordering::SeqCst)
+        })
+        .unwrap_or(false);
+    if !valid {
+        return Err(refusal("foreign_parent_capability"));
+    }
+    Ok(CURRENT.scope(child.node, f).await)
+}
+/// Explicit Send capability moved into spawn_blocking; never relies on task-local there.
+pub struct NativeWorkerCapability {
+    pub(crate) node: Arc<Node>,
+    single_owner: std::marker::PhantomData<std::cell::Cell<()>>,
+}
+pub fn take_native_worker(name: &str, args: &Value) -> Result<NativeWorkerCapability, ToolResult> {
+    let p = CURRENT
+        .try_with(Arc::clone)
+        .map_err(|_| refusal("no_worker_capability"))?;
+    let mut b = p.tree.budget.lock().unwrap();
+    if p.name != name
+        || p.args != *args
+        || !p.admitted.load(Ordering::SeqCst)
+        || p.delegated.load(Ordering::SeqCst)
+        || b.worker_taken
+        || !p.tree.fence.as_ref().is_some_and(|f| f.active())
+    {
+        return Err(refusal("native_worker_not_admitted"));
+    }
+    let mut custody = p.tree.custody.state.lock().unwrap();
+    if custody.finished || custody.worker_taken {
+        return Err(refusal("worker_custody_already_taken"));
+    }
+    custody.worker_taken = true;
+    b.worker_taken = true;
+    Ok(NativeWorkerCapability {
+        node: p.clone(),
+        single_owner: std::marker::PhantomData,
+    })
+}
+impl Drop for NativeWorkerCapability {
+    fn drop(&mut self) {
+        self.node.tree.custody.abandon_worker();
+    }
+}
+/// 不可Clone的实际blocking闭包存活guard；在闭包退出前保留原custody/context/registry。
+pub struct NativeWorkerLifetime {
+    _custody: Arc<Custody>,
+}
+impl NativeWorkerCapability {
+    pub fn take_worker_lifetime(&self) -> Result<NativeWorkerLifetime, &'static str> {
+        let mut s = self
+            .node
+            .tree
+            .custody
+            .state
+            .lock()
+            .unwrap_or_else(|e| e.into_inner());
+        if s.finished || s.lifetime_issued {
+            return Err("worker_lifetime_already_issued_or_finished");
+        }
+        s.lifetime_issued = true;
+        Ok(NativeWorkerLifetime {
+            _custody: self.node.tree.custody.clone(),
+        })
+    }
+    pub fn start_worker(&self) -> Result<(), &'static str> {
+        if process_quarantined() {
+            return Err("native_process_quarantined");
+        }
+        let mut s = self.node.tree.custody.state.lock().unwrap();
+        if s.finished || s.started {
+            return Err("worker_custody_not_startable");
+        }
+        s.started = true;
+        Ok(())
+    }
+    /// One platform executor per worker, before any source/event object is created.
+    pub(crate) fn claim_actuator(&self) -> Result<(), &'static str> {
+        if process_quarantined() {
+            return Err("native_process_quarantined");
+        }
+        let mut s = self.node.tree.custody.state.lock().unwrap();
+        if !s.started || s.finished || s.actuator_claimed {
+            return Err("actuator_already_claimed_or_not_running");
+        }
+        s.actuator_claimed = true;
+        Ok(())
+    }
+
+    pub fn active(&self) -> bool {
+        let finished = self.node.tree.custody.state.lock().unwrap().finished;
+        if process_quarantined()
+            || finished
+            || !self.node.tree.fence.as_ref().is_some_and(|f| f.active())
+        {
+            return false;
+        }
+        // 修复依据：最后一个普通event之后manifest也可能失效，不能只看context自身TTL。
+        crate::native_domain::with(|t| {
+            self.node
+                .tree
+                .custody
+                .context
+                .as_ref()
+                .is_some_and(|c| c.native_check_under(t).is_ok())
+        })
+    }
+    /// 私有最终派发临界区：查询/host callback/延时在锁外；cancel 与 ABI 先后由同一 cell 线性化。
+    pub(crate) fn native_handoff(
+        &self,
+        release: bool,
+        window_live: impl FnOnce(&crate::native_domain::Token<'_>) -> bool,
+        post: impl FnOnce(),
+    ) -> Result<(), &'static str> {
+        self.node.tree.custody.cell.handoff_checked(
+            release,
+            |token| {
+                let s = self.node.tree.custody.state.lock().unwrap();
+                s.started
+                    && !s.finished
+                    && s.actuator_claimed
+                    && self
+                        .node
+                        .tree
+                        .custody
+                        .context
+                        .as_ref()
+                        .is_some_and(|c| release || c.native_check_under(token).is_ok())
+                    && window_live(token)
+            },
+            post,
+        )
+    }
+    pub fn action_id(&self) -> u64 {
+        self.node.tree.custody.action_id
+    }
+    pub fn name(&self) -> &str {
+        &self.node.name
+    }
+    pub fn arguments(&self) -> &Value {
+        &self.node.args
+    }
+    pub fn depth(&self) -> u8 {
+        self.node.depth
+    }
+    pub(crate) fn reserve_event(&self) -> Result<u32, &'static str> {
+        if process_quarantined() {
+            return Err("native_process_quarantined");
+        }
+        let mut b = self.node.tree.budget.lock().unwrap();
+        {
+            let s = self.node.tree.custody.state.lock().unwrap();
+            if s.finished || !s.started {
+                return Err("worker_custody_not_running");
+            }
+        }
+        if b.events >= 64 {
+            return Err("native_event_budget_exhausted");
+        }
+        if !self
+            .node
+            .tree
+            .fence
+            .as_ref()
+            .is_some_and(|f| f.reserve_event())
+        {
+            return Err("native_event_fenced");
+        }
+        b.events += 1;
+        Ok(b.events)
+    }
+}
+
+pub fn current_depth() -> u8 {
+    CURRENT.try_with(|p| p.depth).unwrap_or(255)
+}
