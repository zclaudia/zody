+}
+impl Binding {
+    fn bind() -> Result<Self, &'static str> {
+        #[cfg(not(feature = "zody-dev-probe"))]
+        {
+            return Err("native_transport_not_approved");
+        }
+        #[cfg(feature = "zody-dev-probe")]
+        unsafe {
+            let marker = libc::dlsym(libc::RTLD_DEFAULT, c"zody_probe_transport_v1".as_ptr());
+            let tag = libc::dlsym(libc::RTLD_DEFAULT, c"zody_probe_tag".as_ptr());
+            if marker.is_null() || tag.is_null() {
+                return Err("transport_interceptor_missing");
+            }
+            let marker: unsafe extern "C" fn() -> *const std::ffi::c_void =
+                std::mem::transmute(marker);
+            if marker() != CGEventPost as *const std::ffi::c_void {
+                return Err("transport_binding_mismatch");
+            }
+            Ok(Self {
+                tag: std::mem::transmute(tag),
+            })
+        }
+    }
+    fn handoff(
+        &self,
+        b: &dyn Boundary,
+        event: &CGEvent,
+        obs: &Observation,
+        guard: &mut Guard,
+        cap: &NativeWorkerCapability,
+    ) -> Result<(), Failure> {
+        b.observe_attempt(obs);
+        let injection = b.injection(obs.ordinal);
+        if injection == Injection::NotSent {
+            return Err(Failure::NotSent);
+        }
+        if injection == Injection::PanicBefore {
+            panic!("synthetic pre-ABI panic");
+        }
+        // 修复依据：观察/故障 callback 之后必须重读，避免 callback 位于最终窗口 fence 与 ABI 之间。
+        checkpoint(b, Phase::Transport, obs.ordinal, obs.release)?;
+        guard
+            .check(Phase::Transport, obs.ordinal, obs.release)
+            .map_err(|_| Failure::NotSent)?;
+        if !obs.release && !cap.active() {
+            return Err(Failure::NotSent);
+        }
+        checkpoint(b, Phase::HandoffReady, obs.ordinal, obs.release)?;
+        cap.native_handoff(
+            obs.release,
+            |token| guard.local_fence(token.now(), obs.release).is_ok(),
+            || unsafe {
+                (self.tag)(obs.action, obs.ordinal as u64, obs.release as u32);
+                CGEventPost(
+                    core_graphics::event::CGEventTapLocation::HID,
+                    event.as_ptr(),
+                );
+            },
+        )
+        .map_err(|_| Failure::NotSent)?;
+        if injection == Injection::PanicAfter {
+            panic!("synthetic post-ABI panic");
+        }
+        if injection == Injection::UnknownAfter {
+            Err(Failure::Unknown)
+        } else {
+            Ok(())
+        }
+    }
+}
+
+struct NoFault;
+impl Boundary for NoFault {
+    fn checkpoint(&self, _: Phase, _: usize, _: bool) -> Result<(), Failure> {
+        Ok(())
+    }
+}
+pub fn execute(cap: NativeWorkerCapability) -> NativeTerminalReceipt {
+    execute_owned(cap, &NoFault, None)
+}
+#[cfg(feature = "zody-dev-probe")]
+pub fn execute_development(cap: NativeWorkerCapability, b: &dyn Boundary) -> NativeTerminalReceipt {
+    execute_owned(cap, b, None)
+}
+
+#[cfg(feature = "zody-dev-probe")]
+pub fn verify_binding_development() -> Result<(), &'static str> {
+    Binding::bind().map(|_| ())
+}
+
+#[cfg(feature = "zody-dev-probe")]
+pub fn execute_window_development(
+    cap: NativeWorkerCapability,
+    boundary: &dyn Boundary,
+    scenario: Scenario,
+) -> NativeTerminalReceipt {
+    execute_owned(cap, boundary, Some(scenario))
+}
+
+fn window_fence(
+    g: &mut Guard,
+    b: &dyn Boundary,
+    p: Phase,
+    n: usize,
+    release: bool,
+) -> Result<(), &'static str> {
+    checkpoint(b, Phase::FactsBefore, n, release).map_err(|_| "facts_before_failed")?;
+    let result = g.check(p, n, release);
+    checkpoint(b, Phase::FactsAfter, n, release).map_err(|_| "facts_after_failed")?;
+    result
+}
