+// Only this private function can construct an object. A failure before dispatch is definite not-sent.
+fn create(
+    source: &CGEventSource,
+    step: &Step,
+    b: &dyn Boundary,
+    n: usize,
+    release: bool,
+) -> Result<CGEvent, Failure> {
+    if b.fail_constructor(false, n, release) {
+        return Err(Failure::NotSent);
+    }
+    let point = CGPoint::new(step.point[0], step.point[1]);
+    let event = match &step.kind {
+        Kind::ModifierDown(k) | Kind::ModifierUp(k) => CGEvent::new_keyboard_event(
+            source.clone(),
+            modifier(k).unwrap().0,
+            matches!(step.kind, Kind::ModifierDown(_)),
+        ),
+        Kind::Tick => CGEvent::new_scroll_event(
+            source.clone(),
+            ScrollEventUnit::LINE,
+            2,
+            step.delta[0],
+            step.delta[1],
+            0,
+        ),
+        k => CGEvent::new_mouse_event(
+            source.clone(),
+            match k {
+                Kind::Move => CGEventType::MouseMoved,
+                Kind::Down => CGEventType::LeftMouseDown,
+                Kind::Dragged => CGEventType::LeftMouseDragged,
+                Kind::Up => CGEventType::LeftMouseUp,
+                _ => unreachable!(),
+            },
+            point,
+            CGMouseButton::Left,
+        ),
+    }
+    .map_err(|_| Failure::NotSent)?;
+    event.set_flags(step.flags);
+    if matches!(step.kind, Kind::Down | Kind::Up) {
+        event.set_integer_value_field(EventField::MOUSE_EVENT_CLICK_STATE, 1);
+    }
+    // Quartz scroll constructor has no location argument. Stamp without warping a real cursor.
+    if matches!(step.kind, Kind::Tick) {
+        unsafe {
+            CGEventSetLocation(event.as_ptr(), point);
+        }
+    }
+    Ok(event)
+}
