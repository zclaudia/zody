diff --git b/crates/cua-driver-core/build.rs b/crates/cua-driver-core/build.rs
new file mode 100644
index 0000000..cbcf505
--- /dev/null
+++ b/crates/cua-driver-core/build.rs
@@ -0,0 +1,26 @@
+fn main() {
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("macos") {
+        return;
+    }
+    println!("cargo:rerun-if-changed=src/window_facts.m");
+    let out = std::path::PathBuf::from(std::env::var_os("OUT_DIR").unwrap());
+    let obj = out.join("window_facts.o");
+    let lib = out.join("libzody_window_facts.a");
+    assert!(std::process::Command::new("/usr/bin/clang")
+        .args(["-fobjc-arc", "-c", "src/window_facts.m", "-o"])
+        .arg(&obj)
+        .status()
+        .unwrap()
+        .success());
+    assert!(std::process::Command::new("/usr/bin/ar")
+        .arg("rcs")
+        .arg(&lib)
+        .arg(&obj)
+        .status()
+        .unwrap()
+        .success());
+    println!("cargo:rustc-link-search=native={}", out.display());
+    println!("cargo:rustc-link-lib=static=zody_window_facts");
+    println!("cargo:rustc-link-lib=framework=AppKit");
+    println!("cargo:rustc-link-lib=framework=ApplicationServices");
+}
