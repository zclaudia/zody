+//! One process-local linearization domain. Never put queries, sleeps or host callbacks here.
+use std::sync::{Mutex, MutexGuard, OnceLock};
+static DOMAIN: OnceLock<Mutex<()>> = OnceLock::new();
+pub(crate) struct Token<'a> {
+    _held: &'a MutexGuard<'static, ()>,
+    at: std::time::Instant,
+    _thread: std::marker::PhantomData<std::rc::Rc<()>>,
+}
+pub(crate) fn with<T>(f: impl FnOnce(&Token<'_>) -> T) -> T {
+    #[cfg(feature = "zody-dev-probe")]
+    waiting(1);
+    let guard = DOMAIN
+        .get_or_init(|| Mutex::new(()))
+        .lock()
+        .unwrap_or_else(|p| p.into_inner());
+    #[cfg(feature = "zody-dev-probe")]
+    waiting(-1);
+    f(&Token {
+        _held: &guard,
+        at: std::time::Instant::now(),
+        _thread: std::marker::PhantomData,
+    })
+}
+#[cfg(feature = "zody-dev-probe")]
+fn metrics() -> &'static (
+    Mutex<std::collections::HashSet<std::thread::ThreadId>>,
+    std::sync::Condvar,
+) {
+    static M: OnceLock<(
+        Mutex<std::collections::HashSet<std::thread::ThreadId>>,
+        std::sync::Condvar,
+    )> = OnceLock::new();
+    M.get_or_init(|| {
+        (
+            Mutex::new(std::collections::HashSet::new()),
+            std::sync::Condvar::new(),
+        )
+    })
+}
+#[cfg(feature = "zody-dev-probe")]
+fn waiting(delta: i32) {
+    let (m, c) = metrics();
+    let mut waiters = m.lock().unwrap();
+    let id = std::thread::current().id();
+    if delta > 0 {
+        assert!(waiters.insert(id));
+    } else {
+        assert!(waiters.remove(&id));
+    }
+    c.notify_all();
+}
+#[cfg(feature = "zody-dev-probe")]
+pub fn development_wait_for_contender(id: std::thread::ThreadId) {
+    let (m, c) = metrics();
+    let mut waiters = m.lock().unwrap();
+    while !waiters.contains(&id) {
+        waiters = c.wait(waiters).unwrap();
+    }
+}
+impl Token<'_> {
+    pub(crate) fn now(&self) -> std::time::Instant {
+        self.at
+    }
+}
