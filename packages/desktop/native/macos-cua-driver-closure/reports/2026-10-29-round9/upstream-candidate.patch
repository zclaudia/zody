+fn modifier(k: &str) -> Option<(u16, CGEventFlags)> {
+    match k {
+        "cmd" => Some((55, CGEventFlags::CGEventFlagCommand)),
+        "shift" => Some((56, CGEventFlags::CGEventFlagShift)),
+        "option" => Some((58, CGEventFlags::CGEventFlagAlternate)),
+        _ => None,
+    }
+}
+fn flags(keys: &[String]) -> CGEventFlags {
+    keys.iter().fold(CGEventFlags::CGEventFlagNull, |f, k| {
+        f | modifier(k).unwrap().1
+    })
