+    expect(() => parseHelperProofRequestLine(`{${authority.slice(1, -1)},"extra":1}`)).toThrow();
+    expect(() => parseHelperProofRequestLine("{}")).toThrow();
+    expect(() => parseHelperProofRequestLine("[]")).toThrow();
+    expect(() =>
