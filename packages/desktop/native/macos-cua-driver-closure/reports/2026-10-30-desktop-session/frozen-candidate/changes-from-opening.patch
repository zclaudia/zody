+      const bytes = estimateNodeHostBridgeFrameBytes(frame);
+      try {
+        assertSendQueueWithinBound(queue.length + 1, queuedBytes + bytes);
+      } catch (error) {
+        fail(error instanceof Error ? error : new Error(String(error)));
+        return;
+      }
