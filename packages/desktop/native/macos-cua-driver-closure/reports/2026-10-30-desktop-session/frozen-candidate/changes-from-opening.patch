+import { resolve } from "node:path";
+import { describe, expect, it } from "vitest";
+import type {
+  McpCallToolRequest,
+  McpConnectionSnapshot,
+  McpPort,
+  McpToolCallResult,
+} from "@zcode/contracts";
+import {
+  createCuaNodeReplMcpPort,
