+    const line = before.split("\n").length;
+    const lineStart = before.lastIndexOf("\n") + 1;
+    const lineEnd = text.indexOf("\n", match.index);
+    const snippet = text
+      .slice(lineStart, lineEnd < 0 ? Math.min(text.length, match.index + 120) : lineEnd)
