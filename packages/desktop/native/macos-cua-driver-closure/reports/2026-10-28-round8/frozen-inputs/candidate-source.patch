new file mode 100644
index 0000000..069365d
--- /dev/null
+++ b/crates/cua-macos-visual/build.rs
@@ -0,0 +1,65 @@
+//! Add the active toolchain's Swift compatibility library directory to the
+//! native link search path. The upstream SwiftPM build scripts only know the
+//! full-Xcode `Toolchains/XcodeDefault.xctoolchain` layout; a Command Line
+//! Tools-only host installs the same libraries under `usr/lib/swift/macosx`.
+//!
+//! This script emits the compatibility-library search path and the fixed system
+//! Swift runtime rpath. It does not copy a library, force-link an unrelated
+//! framework, change the SDK, or lower the deployment target. The Swift object
+//! files carry the actual autolink directives, so the linker can resolve them
+//! after the verified directory is on its search path.
+
+use std::path::PathBuf;
+use std::process::Command;
+
+#[path = "src/swift_link.rs"]
+mod swift_link;
+
+fn main() {
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-changed=src/swift_link.rs");
+    println!("cargo:rerun-if-env-changed=DEVELOPER_DIR");
+    println!("cargo:rerun-if-env-changed=TOOLCHAINS");
+
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("macos") {
+        return;
+    }
+
+    let compiler = xcrun_find_swiftc();
+    if !compiler.is_file() {
+        panic!(
+            "xcrun returned {}, but it is not a regular compiler file",
+            compiler.display()
+        );
+    }
+    let directory = swift_link::swift_lib_dir_from_compiler(&compiler).unwrap_or_else(|| {
+        panic!(
+            "xcrun returned {}, which is not <toolchain>/usr/bin/swiftc",
+            compiler.display()
+        )
+    });
+    if !swift_link::has_required_compat_libs(&directory) {
+        panic!(
+            "{} is missing libswiftCompatibility56.a or \
+             libswiftCompatibilityPacks.a",
+            directory.display()
+        );
+    }
+    println!("cargo:rustc-link-search=native={}", directory.display());
+
+    // 上游 Swift 对象带 @rpath 依赖；compat 库搜索路径不能替代运行期 rpath。
+    // 这里只补标准系统运行时目录，供本 crate 的测试/最终可执行文件解析。
+    println!("cargo:rustc-link-arg=-Wl,-rpath,/usr/lib/swift");
+}
+
+fn xcrun_find_swiftc() -> PathBuf {
+    let output = Command::new("/usr/bin/xcrun")
+        .args(["--find", "swiftc"])
+        .output()
+        .unwrap_or_else(|error| panic!("failed to run /usr/bin/xcrun: {error}"));
+    if !output.status.success() {
+        panic!("/usr/bin/xcrun --find swiftc failed with {}", output.status);
+    }
+    swift_link::parse_xcrun_swiftc(&output.stdout)
+        .unwrap_or_else(|error| panic!("invalid /usr/bin/xcrun --find swiftc output: {error}"))
+}
