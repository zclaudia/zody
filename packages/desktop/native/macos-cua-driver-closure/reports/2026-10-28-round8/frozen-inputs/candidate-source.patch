+[package]
+name = "cua-macos-visual"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+description = "Narrow macOS visual observation candidate: CGWindow facts, one-window ScreenCaptureKit frame and PNG encoding"
+publish = false
+
+[lib]
+crate-type = ["rlib"]
+
+[dependencies]
+# 只开 PNG，显式绕开 workspace 的 image features（png+jpeg），避免 JPEG 编码器进入新图。
+image = { version = "0.25", default-features = false, features = ["png"] }
+
+[target.'cfg(target_os = "macos")'.dependencies]
+core-foundation = "0.10"
+# 默认 feature 为空。macos_14_2 是读取 content_rect 的最小 feature，
+# 同时保留 macos_14_0 的 SCScreenshotManager/point_pixel_scale API。
+screencapturekit = { version = "8.0.1", features = ["macos_14_2"] }
