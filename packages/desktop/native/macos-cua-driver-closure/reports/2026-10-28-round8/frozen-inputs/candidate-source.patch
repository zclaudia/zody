@@ -0,0 +1,152 @@
+//! Crate-private single-window ScreenCaptureKit capture.
+//!
+//! No cache, lease, retry, timeout, shell/SkyLight fallback or consent
+//! bypass. Identity order and drift rejection live in [`crate::observe`]; this
+//! module only reads CG facts and turns the exact SCK window into RGBA.
+
+#![allow(dead_code)]
+
+use screencapturekit::prelude::{SCContentFilter, SCShareableContent, SCStreamConfiguration};
+use screencapturekit::screenshot_manager::{CGImageExt, SCScreenshotManager};
+
+use crate::error::VisualError;
+use crate::geometry::{
+    checked_pixel_dimensions, checked_pixel_extent, CaptureRequest, PixelDimensions, WindowBounds,
+    WindowIdentity, MAX_CAPTURE_SIDE,
+};
+use crate::observe::{observe_once, RawFrame};
+use crate::png::encode_rgba_to_png;
+use crate::window;
+
+struct CapturePlan {
+    filter: SCContentFilter,
+    config: SCStreamConfiguration,
+    output: PixelDimensions,
+}
+
+/// Capture one exact window and return a validated, non-empty PNG frame.
+///
+/// `SCScreenshotManager::capture_image` waits on a one-shot completion with no
+/// timeout. If the system never invokes that callback, this synchronous call
+/// can remain pending indefinitely; this candidate deliberately adds no fake
+/// timeout or cancellation. A trusted host must own that lifecycle before this
+/// path can be exposed.
+#[allow(dead_code)]
+pub(crate) fn capture_window_png(
+    request: &CaptureRequest,
+) -> Result<crate::CapturedFrame, VisualError> {
+    request.validate()?;
+    let expected = request.expected_identity();
+    observe_once(
+        &expected,
+        || window::window_identity(request.window_id),
+        || build_plan(request),
+        capture_frame,
+        || window::window_identity(request.window_id),
+        |raw| encode_rgba_to_png(&raw.rgba, raw.dimensions.width, raw.dimensions.height),
+    )
+}
+
+/// Select the one exact shareable window and build its fixed output plan.
+///
+/// The returned identity is checked by [`observe_once`] before capture, so a
+/// changed or substituted SCK window is rejected without reselection.
+fn build_plan(request: &CaptureRequest) -> Result<(WindowIdentity, CapturePlan), VisualError> {
+    let content = SCShareableContent::get()
+        .map_err(|error| native(format!("SCShareableContent::get failed: {error}")))?;
+    let window = content
+        .windows()
+        .into_iter()
+        .find(|window| window.window_id() == request.window_id)
+        .ok_or(VisualError::WindowNotFound {
+            window_id: request.window_id,
+        })?;
+
+    let frame = window.frame();
+    let pid = window
+        .owning_application()
+        .map(|application| application.process_id())
+        .ok_or_else(|| native("selected SCK window has no owning application"))?;
+    let selected = WindowIdentity::new(
+        request.window_id,
+        pid,
+        window.window_layer(),
+        WindowBounds::new(
+            frame.origin.x,
+            frame.origin.y,
+            frame.size.width,
+            frame.size.height,
+        ),
+    );
+
+    let filter = SCContentFilter::create().with_window(&window).build();
+    let scale = f64::from(filter.point_pixel_scale());
+    let rect = filter.content_rect();
+    let (points_width, points_height) = if content_rect_usable(rect) {
+        (rect.size.width, rect.size.height)
+    } else {
+        (frame.size.width, frame.size.height)
+    };
+    let output_width = checked_pixel_extent(points_width * scale, "SCK output width")?;
+    let output_height = checked_pixel_extent(points_height * scale, "SCK output height")?;
+    let output = checked_pixel_dimensions(output_width, output_height)?;
+
+    let config = SCStreamConfiguration::new()
+        .with_width(output_width)
+        .with_height(output_height)
+        .with_shows_cursor(false);
+    Ok((
+        selected,
+        CapturePlan {
+            filter,
+            config,
+            output,
+        },
+    ))
+}
+
+fn capture_frame(plan: CapturePlan) -> Result<RawFrame, VisualError> {
+    let image =
+        SCScreenshotManager::capture_image(&plan.filter, &plan.config).map_err(|error| {
+            native(format!(
+                "SCScreenshotManager::capture_image failed: {error}"
+            ))
+        })?;
+    let width = image_dim(image.width(), "CGImage width")?;
+    let height = image_dim(image.height(), "CGImage height")?;
+    let dimensions = checked_pixel_dimensions(width, height)?;
+    if dimensions != plan.output {
+        return Err(native(format!(
+            "SCK returned {width}x{height}, configured {}x{}",
+            plan.output.width, plan.output.height
+        )));
+    }
+    let rgba = image
+        .rgba_data()
+        .map_err(|error| native(format!("CGImage::rgba_data failed: {error}")))?;
+    Ok(RawFrame { dimensions, rgba })
+}
+
+fn content_rect_usable(rect: screencapturekit::cg::CGRect) -> bool {
+    rect.size.width.is_finite()
+        && rect.size.height.is_finite()
+        && rect.size.width > 0.0
+        && rect.size.height > 0.0
+}
+
+fn image_dim(value: usize, label: &'static str) -> Result<u32, VisualError> {
+    if value == 0 || value > MAX_CAPTURE_SIDE as usize {
+        return Err(VisualError::DimensionRejected {
+            label,
+            value: value as f64,
+        });
+    }
+    u32::try_from(value).map_err(|_| VisualError::DimensionRejected {
+        label,
+        value: value as f64,
+    })
+}
+
+fn native(message: impl Into<String>) -> VisualError {
+    VisualError::NativeCapture(message.into())
+}
