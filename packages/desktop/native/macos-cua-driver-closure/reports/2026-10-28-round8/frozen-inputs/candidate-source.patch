index 0000000..baeeec3
--- /dev/null
+++ b/crates/cua-macos-visual/src/swift_link.rs
@@ -0,0 +1,129 @@
+//! Pure helpers for locating the active toolchain's Swift compatibility libs.
+//!
+//! This file is shared by `build.rs` (with `#[path]`) and the crate's pure unit
+//! tests. Filesystem existence is checked separately by the build script.
+
+use std::path::{Path, PathBuf};
+
+/// Parse the single absolute compiler path returned by
+/// `/usr/bin/xcrun --find swiftc`.
+pub(crate) fn parse_xcrun_swiftc(stdout: &[u8]) -> Result<PathBuf, &'static str> {
+    let value = std::str::from_utf8(stdout).map_err(|_| "output is not UTF-8")?;
+    let value = value.trim();
+    if value.is_empty() {
+        return Err("output is empty");
+    }
+    let mut lines = value.lines();
+    let line = lines.next().ok_or("output is empty")?;
+    if lines.next().is_some() {
+        return Err("output contains more than one line");
+    }
+    let compiler = Path::new(line);
+    if !compiler.is_absolute() {
+        return Err("compiler path is not absolute");
+    }
+    if compiler.file_name() != Some(std::ffi::OsStr::new("swiftc")) {
+        return Err("compiler path does not end in swiftc");
+    }
+    swift_lib_dir_from_compiler(compiler)
+        .ok_or("compiler path is not <toolchain>/usr/bin/swiftc")?;
+    Ok(compiler.to_path_buf())
+}
+
+/// Derive `usr/lib/swift/macosx` from `<toolchain>/usr/bin/swiftc`.
+pub(crate) fn swift_lib_dir_from_compiler(compiler: &Path) -> Option<PathBuf> {
+    if !compiler.is_absolute() || compiler.file_name()? != "swiftc" {
+        return None;
+    }
+    let bin = compiler.parent()?;
+    if bin.file_name()? != "bin" {
+        return None;
+    }
+    let usr = bin.parent()?;
+    if usr.file_name()? != "usr" {
+        return None;
+    }
+    Some(usr.join("lib/swift/macosx"))
+}
+
+/// Both libraries are required before the directory is trusted for linking.
+#[allow(dead_code)]
+pub(crate) fn has_required_compat_libs(directory: &Path) -> bool {
+    directory.join("libswiftCompatibility56.a").is_file()
+        && directory.join("libswiftCompatibilityPacks.a").is_file()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_clt_swiftc() {
+        assert_eq!(
+            parse_xcrun_swiftc(b"/Library/Developer/CommandLineTools/usr/bin/swiftc\n"),
+            Ok(PathBuf::from(
+                "/Library/Developer/CommandLineTools/usr/bin/swiftc"
+            ))
+        );
+        assert_eq!(
+            swift_lib_dir_from_compiler(Path::new(
+                "/Library/Developer/CommandLineTools/usr/bin/swiftc"
+            )),
+            Some(PathBuf::from(
+                "/Library/Developer/CommandLineTools/usr/lib/swift/macosx"
+            ))
+        );
+    }
+
+    #[test]
+    fn parses_xcode_toolchain_swiftc() {
+        let compiler = b"/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swiftc\n";
+        assert_eq!(
+            parse_xcrun_swiftc(compiler),
+            Ok(PathBuf::from(
+                "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swiftc"
+            ))
+        );
+        assert_eq!(
+            swift_lib_dir_from_compiler(Path::new(
+                "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swiftc",
+            )),
+            Some(PathBuf::from(
+                "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/macosx"
+            ))
+        );
+    }
+
+    #[test]
+    fn rejects_relative_wrong_layout_and_wrong_file_name() {
+        for output in [
+            b"usr/bin/swiftc\n".as_slice(),
+            b"/Library/Developer/CommandLineTools/bin/swiftc\n".as_slice(),
+            b"/Library/Developer/CommandLineTools/usr/lib/swiftc\n".as_slice(),
+            b"/Library/Developer/CommandLineTools/usr/bin/clang\n".as_slice(),
+        ] {
+            assert!(parse_xcrun_swiftc(output).is_err(), "{output:?}");
+        }
+        assert_eq!(
+            swift_lib_dir_from_compiler(Path::new("usr/bin/swiftc")),
+            None
+        );
+        assert_eq!(
+            swift_lib_dir_from_compiler(Path::new(
+                "/Library/Developer/CommandLineTools/bin/swiftc"
+            )),
+            None
+        );
+    }
+
+    #[test]
+    fn rejects_empty_multiline_and_non_utf8_output_without_fallback() {
+        assert!(parse_xcrun_swiftc(b"").is_err());
+        assert!(parse_xcrun_swiftc(b"\n").is_err());
+        assert!(parse_xcrun_swiftc(
+            b"/Library/Developer/CommandLineTools/usr/bin/swiftc\n/tmp/swiftc\n"
+        )
+        .is_err());
+        assert!(parse_xcrun_swiftc(&[0xFF]).is_err());
+    }
+}
diff --git a/crates/cua-macos-visual/src/window.rs b/crates/cua-macos-visual/src/window.rs
new file mode 100644
index 0000000..5ea806b
--- /dev/null
+++ b/crates/cua-macos-visual/src/window.rs
@@ -0,0 +1,118 @@
+//! Crate-private CGWindowList fact reader.
+//!
+//! Only on-screen layer-0 window id, owning PID, layer and bounds are read.
+//! Every required key stays optional until the pure parser accepts it; missing
+//! values are never replaced with `0`. Off-Space, minimized and accessory
+//! windows are not listed or are rejected, matching this round's support.
+
+#![allow(dead_code)]
+
+use core_foundation::{
+    array::{CFArray, CFArrayRef},
+    base::{CFGetTypeID, CFTypeRef, TCFType},
+    dictionary::CFDictionary,
+    number::CFNumber,
+    string::CFString,
+};
+use std::os::raw::c_void;
+
+use crate::error::VisualError;
+use crate::geometry::{checked_window_id, parse_window_identity, RawWindowFact, WindowIdentity};
+
+const K_CG_WINDOW_LIST_ON_SCREEN_ONLY: u32 = 1;
+const K_CG_WINDOW_LIST_EXCLUDE_DESKTOP_ELEMENTS: u32 = 16;
+const K_CG_NULL_WINDOW_ID: u32 = 0;
+
+#[link(name = "CoreGraphics", kind = "framework")]
+extern "C" {
+    fn CGWindowListCopyWindowInfo(option: u32, relative_to_window: u32) -> CFArrayRef;
+}
+
+/// Read the current on-screen WindowServer identity for exactly `window_id`.
+pub(crate) fn window_identity(window_id: u32) -> Result<WindowIdentity, VisualError> {
+    let options = K_CG_WINDOW_LIST_ON_SCREEN_ONLY | K_CG_WINDOW_LIST_EXCLUDE_DESKTOP_ELEMENTS;
+    let raw = unsafe { CGWindowListCopyWindowInfo(options, K_CG_NULL_WINDOW_ID) };
+    if raw.is_null() {
+        return Err(VisualError::WindowNotFound { window_id });
+    }
+    let windows: CFArray<CFTypeRef> = unsafe { CFArray::wrap_under_create_rule(raw as _) };
+    for item in windows.iter() {
+        let item = *item;
+        let dict_type = CFDictionary::<*const c_void, *const c_void>::type_id();
+        if unsafe { CFGetTypeID(item) } != dict_type {
+            continue;
+        }
+        let dict: CFDictionary<*const c_void, *const c_void> =
+            unsafe { CFDictionary::wrap_under_get_rule(item as _) };
+        let fact = raw_fact(&dict);
+        // 先做 checked id；无法表示或为 0 的条目不匹配，也不截断。
+        let Some(id) = checked_window_id(fact.window_id) else {
+            continue;
+        };
+        if id != window_id {
+            continue;
+        }
+        return parse_window_identity(&fact);
+    }
+    Err(VisualError::WindowNotFound { window_id })
+}
+
+fn raw_fact(dict: &CFDictionary<*const c_void, *const c_void>) -> RawWindowFact {
+    let [x, y, width, height] = raw_bounds(dict);
+    RawWindowFact {
+        window_id: number(dict, "kCGWindowNumber"),
+        pid: number(dict, "kCGWindowOwnerPID"),
+        layer: number(dict, "kCGWindowLayer"),
+        x,
+        y,
+        width,
+        height,
+    }
+}
+
+fn number(dict: &CFDictionary<*const c_void, *const c_void>, key: &str) -> Option<i64> {
+    let key = CFString::new(key);
+    dict.find(key.as_concrete_TypeRef() as *const c_void)
+        .and_then(|value| unsafe {
+            let value = *value;
+            if CFGetTypeID(value) == CFNumber::type_id() {
+                CFNumber::wrap_under_get_rule(value as _).to_i64()
+            } else {
+                None
+            }
+        })
+}
+
+fn raw_bounds(dict: &CFDictionary<*const c_void, *const c_void>) -> [Option<f64>; 4] {
+    let key = CFString::new("kCGWindowBounds");
+    let Some(value) = dict.find(key.as_concrete_TypeRef() as *const c_void) else {
+        return [None; 4];
+    };
+    unsafe {
+        let value = *value;
+        if CFGetTypeID(value) != CFDictionary::<*const c_void, *const c_void>::type_id() {
+            return [None; 4];
+        }
+        let bounds: CFDictionary<*const c_void, *const c_void> =
+            CFDictionary::wrap_under_get_rule(value as _);
+        [
+            real_number(&bounds, "X"),
+            real_number(&bounds, "Y"),
+            real_number(&bounds, "Width"),
+            real_number(&bounds, "Height"),
+        ]
+    }
+}
+
+fn real_number(dict: &CFDictionary<*const c_void, *const c_void>, key: &str) -> Option<f64> {
+    let key = CFString::new(key);
+    dict.find(key.as_concrete_TypeRef() as *const c_void)
+        .and_then(|value| unsafe {
+            let value = *value;
+            if CFGetTypeID(value) == CFNumber::type_id() {
+                CFNumber::wrap_under_get_rule(value as _).to_f64()
+            } else {
+                None
+            }
+        })
+}
diff --git a/crates/cua-macos-visual/tests/pure_visual.rs b/crates/cua-macos-visual/tests/pure_visual.rs
new file mode 100644
index 0000000..f6d720e
--- /dev/null
+++ b/crates/cua-macos-visual/tests/pure_visual.rs
@@ -0,0 +1,272 @@
+use cua_macos_visual::{
+    checked_pixel_dimensions, checked_pixel_extent, checked_rgba_len, encode_rgba_to_png,
+    png_dimensions, request_window_capture, validate_capture_frame, validate_identity,
+    verify_png_matches_dimensions, CaptureRequest, DriftStage, VisualError, WindowBounds,
+    WindowIdentity, MAX_CAPTURE_PIXELS, MAX_CAPTURE_SIDE, MAX_RGBA_BYTES,
+};
+
+fn request() -> CaptureRequest {
+    CaptureRequest::new(11, 4242, 0, WindowBounds::new(100.0, 580.0, 500.0, 500.0))
+}
+
+fn fake_png_header(width: u32, height: u32) -> Vec<u8> {
+    let mut bytes = vec![137, 80, 78, 71, 13, 10, 26, 10];
+    bytes.extend_from_slice(&13_u32.to_be_bytes());
+    bytes.extend_from_slice(b"IHDR");
+    bytes.extend_from_slice(&width.to_be_bytes());
+    bytes.extend_from_slice(&height.to_be_bytes());
+    assert_eq!(bytes.len(), 24);
+    bytes
+}
+
+#[test]
+fn valid_request_is_refused_without_host_approval() {
+    assert_eq!(
+        request_window_capture(&request()),
+        Err(VisualError::HostNotApproved)
+    );
+}
+
+#[test]
+fn structurally_invalid_requests_fail_before_any_native_call() {
+    let zero_window = CaptureRequest::new(0, 4242, 0, WindowBounds::new(0.0, 0.0, 10.0, 10.0));
+    assert!(matches!(
+        request_window_capture(&zero_window),
+        Err(VisualError::InvalidRequest(_))
+    ));
+
+    for pid in [0, -1] {
+        let bad = CaptureRequest::new(11, pid, 0, WindowBounds::new(0.0, 0.0, 10.0, 10.0));
+        assert!(matches!(
+            request_window_capture(&bad),
+            Err(VisualError::InvalidRequest(_))
+        ));
+    }
+
+    for layer in [1, -1] {
+        let bad = CaptureRequest::new(11, 4242, layer, WindowBounds::new(0.0, 0.0, 10.0, 10.0));
+        assert!(matches!(
+            request_window_capture(&bad),
+            Err(VisualError::InvalidRequest(_))
+        ));
+    }
+
+    for bounds in [
+        WindowBounds::new(0.0, 0.0, 0.0, 10.0),
+        WindowBounds::new(0.0, 0.0, 10.0, -1.0),
+        WindowBounds::new(f64::NAN, 0.0, 10.0, 10.0),
+        WindowBounds::new(0.0, 0.0, f64::INFINITY, 10.0),
+    ] {
+        let bad = CaptureRequest::new(11, 4242, 0, bounds);
+        assert!(matches!(
+            request_window_capture(&bad),
+            Err(VisualError::InvalidRequest(_))
+        ));
+    }
+}
+
+#[test]
+fn capture_frame_accepts_coherent_1x_and_2x() {
+    let bounds = WindowBounds::new(100.0, 580.0, 500.0, 500.0);
+    assert_eq!(validate_capture_frame(11, &bounds, 500, 500), Ok(1.0));
+    assert_eq!(validate_capture_frame(11, &bounds, 1000, 1000), Ok(2.0));
+    assert_eq!(validate_capture_frame(11, &bounds, 1000, 1001), Ok(2.0));
+}
+
+#[test]
+fn capture_frame_rejects_missing_or_degenerate_bounds() {
+    for bounds in [
+        WindowBounds::new(0.0, 0.0, 0.0, 0.0),
+        WindowBounds::new(0.0, 0.0, -1.0, 10.0),
+        WindowBounds::new(f64::NAN, 0.0, 10.0, 10.0),
+    ] {
+        assert_eq!(
+            validate_capture_frame(11, &bounds, 1000, 1000),
+            Err(VisualError::WindowNotFound { window_id: 11 })
+        );
+    }
+}
+
+#[test]
+fn capture_frame_rejects_wrong_surface_scale() {
+    let bounds = WindowBounds::new(72.0, 88.0, 880.0, 448.0);
+    assert!(matches!(
+        validate_capture_frame(55, &bounds, 1920, 960),
+        Err(VisualError::FrameMismatch { .. })
+    ));
+    let point_bounds = WindowBounds::new(0.0, 0.0, 500.0, 500.0);
+    assert!(matches!(
+        validate_capture_frame(11, &point_bounds, 250, 250),
+        Err(VisualError::FrameMismatch { .. })
+    ));
+}
+
+#[test]
+fn identity_drift_is_rejected_at_every_stage() {
+    let expected = request().expected_identity();
+    let stages = [
+        DriftStage::BeforeCapture,
+        DriftStage::SelectedWindow,
+        DriftStage::AfterCapture,
+    ];
+    for stage in stages {
+        for actual in [
+            WindowIdentity::new(12, 4242, 0, expected.bounds),
+            WindowIdentity::new(11, 9999, 0, expected.bounds),
+            WindowIdentity::new(11, 4242, 0, WindowBounds::new(100.0, 580.0, 501.0, 500.0)),
+        ] {
+            assert_eq!(
+                validate_identity(&expected, &actual, stage),
+                Err(VisualError::WindowDrift {
+                    window_id: 11,
+                    stage
+                })
+            );
+        }
+        // A non-zero layer is not drift: the actual identity is invalid before
+        // comparison, matching the validation-first order in `validate_identity`.
+        let wrong_layer = WindowIdentity::new(11, 4242, 1, expected.bounds);
+        assert_eq!(
+            validate_identity(&expected, &wrong_layer, stage),
+            Err(VisualError::InvalidIdentity { field: "layer" })
+        );
+        assert_eq!(validate_identity(&expected, &expected, stage), Ok(()));
+    }
+}
+
+#[test]
+fn invalid_identities_are_rejected_even_when_equal() {
+    let invalid = [
+        WindowIdentity::new(0, 4242, 0, WindowBounds::new(0.0, 0.0, 10.0, 10.0)),
+        WindowIdentity::new(11, 0, 0, WindowBounds::new(0.0, 0.0, 10.0, 10.0)),
+        WindowIdentity::new(11, 4242, 1, WindowBounds::new(0.0, 0.0, 10.0, 10.0)),
+        WindowIdentity::new(11, 4242, 0, WindowBounds::new(0.0, 0.0, 0.0, 10.0)),
+        WindowIdentity::new(11, 4242, 0, WindowBounds::new(f64::NAN, 0.0, 10.0, 10.0)),
+    ];
+    for identity in invalid {
+        assert!(matches!(
+            validate_identity(&identity, &identity, DriftStage::BeforeCapture),
+            Err(VisualError::InvalidIdentity { .. })
+        ));
+    }
+}
+
+#[test]
+fn bounds_compare_by_bits_and_reject_negative_zero_drift() {
+    let expected = WindowIdentity::new(11, 4242, 0, WindowBounds::new(0.0, 10.0, 100.0, 100.0));
+    let actual = WindowIdentity::new(11, 4242, 0, WindowBounds::new(-0.0, 10.0, 100.0, 100.0));
+    assert_eq!(
+        validate_identity(&expected, &actual, DriftStage::AfterCapture),
+        Err(VisualError::WindowDrift {
+            window_id: 11,
+            stage: DriftStage::AfterCapture
+        })
+    );
+}
+
+#[test]
+fn pixel_dimensions_bound_side_and_aggregate_memory() {
+    assert_eq!(checked_pixel_dimensions(1, 1).unwrap().width, 1);
+    assert!(checked_pixel_dimensions(0, 1).is_err());
+    assert!(checked_pixel_dimensions(MAX_CAPTURE_SIDE + 1, 1).is_err());
+    assert!(checked_pixel_dimensions(MAX_CAPTURE_SIDE, 4096).is_ok());
+
+    let over = checked_pixel_dimensions(MAX_CAPTURE_SIDE, MAX_CAPTURE_SIDE);
+    assert!(matches!(
+        over,
+        Err(VisualError::PixelBudgetExceeded {
+            pixels,
+            max_pixels: MAX_CAPTURE_PIXELS,
+            ..
+        }) if pixels > MAX_CAPTURE_PIXELS
+    ));
+    assert_eq!(MAX_RGBA_BYTES, MAX_CAPTURE_PIXELS * 4);
+}
+
+#[test]
+fn pixel_extent_rejects_non_finite_zero_and_oversized_values() {
+    assert_eq!(checked_pixel_extent(500.4, "width"), Ok(500));
+    for value in [0.0, -1.0, f64::NAN, f64::INFINITY, 8193.0] {
+        assert!(checked_pixel_extent(value, "width").is_err(), "{value}");
+    }
+}
+
+#[test]
+fn rgba_length_must_equal_width_height_and_four() {
+    assert_eq!(checked_rgba_len(2, 2, 16), Ok(16));
+    assert!(matches!(
+        checked_rgba_len(2, 2, 15),
+        Err(VisualError::RgbaLengthMismatch {
+            expected: 16,
+            actual: 15,
+            ..
+        })
+    ));
+    assert!(matches!(
+        checked_rgba_len(2, 2, 17),
+        Err(VisualError::RgbaLengthMismatch {
+            expected: 16,
+            actual: 17,
+            ..
+        })
+    ));
+    assert!(matches!(
+        checked_rgba_len(MAX_CAPTURE_SIDE, MAX_CAPTURE_SIDE, 16),
+        Err(VisualError::PixelBudgetExceeded { .. })
+    ));
+}
+
+#[test]
+fn header_parser_accepts_a_fake_while_verifier_requires_a_full_png() {
+    let fake = fake_png_header(1, 1);
+    assert_eq!(png_dimensions(&fake), Ok((1, 1)));
+    assert!(verify_png_matches_dimensions(&fake, 1, 1).is_err());
+}
+
+#[test]
+fn png_round_trip_has_matching_dimensions_and_non_empty_bytes() {
+    let rgba = vec![0x7Fu8; 3 * 2 * 4];
+    let png = encode_rgba_to_png(&rgba, 3, 2).expect("encode");
+    assert!(!png.is_empty());
+    assert_eq!(png_dimensions(&png), Ok((3, 2)));
+    assert_eq!(verify_png_matches_dimensions(&png, 3, 2), Ok(()));
+}
+
+#[test]
+fn png_rejects_empty_truncated_non_png_and_dimension_mismatch() {
+    assert!(png_dimensions(&[]).is_err());
+    assert!(png_dimensions(b"not a PNG file at all").is_err());
+    assert!(verify_png_matches_dimensions(&[], 1, 1).is_err());
+
+    let png = encode_rgba_to_png(&vec![0u8; 2 * 2 * 4], 2, 2).expect("encode");
+    assert!(matches!(
+        verify_png_matches_dimensions(&png, 3, 2),
+        Err(VisualError::PngMismatch { .. })
+    ));
+    assert!(verify_png_matches_dimensions(&png[..12], 2, 2).is_err());
+}
+
+#[test]
+fn png_verifier_rejects_crc_corruption_and_aggregate_budget() {
+    let png = encode_rgba_to_png(&vec![0u8; 8 * 8 * 4], 8, 8).expect("encode");
+    let position = png
+        .windows(4)
+        .position(|window| window == b"IDAT")
+        .expect("IDAT");
+    let mut corrupted = png.clone();
+    corrupted[position + 4 + 2] ^= 0xFF;
+    assert!(verify_png_matches_dimensions(&corrupted, 8, 8).is_err());
+
+    let big = fake_png_header(MAX_CAPTURE_SIDE, MAX_CAPTURE_SIDE);
+    assert!(matches!(
+        verify_png_matches_dimensions(&big, MAX_CAPTURE_SIDE, MAX_CAPTURE_SIDE),
+        Err(VisualError::PixelBudgetExceeded { .. })
+    ));
+}
+
+#[test]
+fn encoder_rejects_zero_dimensions_and_wrong_buffer_lengths() {
+    assert!(encode_rgba_to_png(&[], 0, 0).is_err());
+    assert!(encode_rgba_to_png(&[0u8; 15], 2, 2).is_err());
+    assert!(encode_rgba_to_png(&[0u8; 17], 2, 2).is_err());
+}
