@@ -0,0 +1,173 @@
+use crate::error::VisualError;
+use crate::geometry::{
+    checked_window_id, parse_window_identity, RawWindowFact, WindowBounds, WindowIdentity,
+};
+
+fn valid_fact() -> RawWindowFact {
+    RawWindowFact {
+        window_id: Some(11),
+        pid: Some(4242),
+        layer: Some(0),
+        x: Some(100.0),
+        y: Some(580.0),
+        width: Some(500.0),
+        height: Some(500.0),
+    }
+}
+
+#[test]
+fn parse_requires_every_field_and_rejects_missing_values() {
+    assert_eq!(
+        parse_window_identity(&valid_fact()),
+        Ok(WindowIdentity::new(
+            11,
+            4242,
+            0,
+            WindowBounds::new(100.0, 580.0, 500.0, 500.0)
+        ))
+    );
+
+    let fields: [(&str, RawWindowFact); 7] = [
+        (
+            "window_id",
+            RawWindowFact {
+                window_id: None,
+                ..valid_fact()
+            },
+        ),
+        (
+            "pid",
+            RawWindowFact {
+                pid: None,
+                ..valid_fact()
+            },
+        ),
+        (
+            "layer",
+            RawWindowFact {
+                layer: None,
+                ..valid_fact()
+            },
+        ),
+        (
+            "x",
+            RawWindowFact {
+                x: None,
+                ..valid_fact()
+            },
+        ),
+        (
+            "y",
+            RawWindowFact {
+                y: None,
+                ..valid_fact()
+            },
+        ),
+        (
+            "width",
+            RawWindowFact {
+                width: None,
+                ..valid_fact()
+            },
+        ),
+        (
+            "height",
+            RawWindowFact {
+                height: None,
+                ..valid_fact()
+            },
+        ),
+    ];
+    for (field, fact) in fields {
+        assert_eq!(
+            parse_window_identity(&fact),
+            Err(VisualError::InvalidWindowFact { field })
+        );
+    }
+}
+
+#[test]
+fn parse_rejects_overflow_non_layer_zero_and_invalid_bounds() {
+    for (field, fact) in [
+        (
+            "window_id",
+            RawWindowFact {
+                window_id: Some(0),
+                ..valid_fact()
+            },
+        ),
+        (
+            "window_id",
+            RawWindowFact {
+                window_id: Some(i64::from(u32::MAX) + 1),
+                ..valid_fact()
+            },
+        ),
+        (
+            "pid",
+            RawWindowFact {
+                pid: Some(0),
+                ..valid_fact()
+            },
+        ),
+        (
+            "pid",
+            RawWindowFact {
+                pid: Some(i64::from(i32::MAX) + 1),
+                ..valid_fact()
+            },
+        ),
+        (
+            "layer",
+            RawWindowFact {
+                layer: Some(1),
+                ..valid_fact()
+            },
+        ),
+        (
+            "layer",
+            RawWindowFact {
+                layer: Some(i64::from(i32::MAX) + 1),
+                ..valid_fact()
+            },
+        ),
+        (
+            "width",
+            RawWindowFact {
+                width: Some(0.0),
+                ..valid_fact()
+            },
+        ),
+        (
+            "width",
+            RawWindowFact {
+                width: Some(f64::NAN),
+                ..valid_fact()
+            },
+        ),
+        (
+            "height",
+            RawWindowFact {
+                height: Some(f64::INFINITY),
+                ..valid_fact()
+            },
+        ),
+    ] {
+        assert!(
+            matches!(
+                parse_window_identity(&fact),
+                Err(VisualError::InvalidWindowFact { field: got }) if got == field
+            ),
+            "{field}"
+        );
+    }
+}
+
+#[test]
+fn checked_window_id_rejects_zero_negative_and_overflow() {
+    assert_eq!(checked_window_id(None), None);
+    assert_eq!(checked_window_id(Some(0)), None);
+    assert_eq!(checked_window_id(Some(-1)), None);
+    assert_eq!(checked_window_id(Some(u32::MAX.into())), Some(u32::MAX));
+    assert_eq!(checked_window_id(Some(i64::from(u32::MAX) + 1)), None);
+}
