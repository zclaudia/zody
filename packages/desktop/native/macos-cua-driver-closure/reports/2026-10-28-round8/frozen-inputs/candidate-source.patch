@@ -0,0 +1,42 @@
+//! Narrow macOS visual observation candidate.
+//!
+//! This crate owns one observation's window facts, pixels and conversion
+//! checks. It does not own submission, leases, frame publication or input
+//! permission. The public capture entry stays closed until a trusted Helper
+//! approval integration exists; the native CG/SCK path is crate-private and
+//! must not be reachable from the public API.
+
+mod error;
+mod geometry;
+#[cfg(test)]
+mod geometry_tests;
+mod observe;
+mod png;
+#[cfg(test)]
+#[path = "swift_link.rs"]
+mod swift_link;
+
+#[cfg(target_os = "macos")]
+mod capture;
+#[cfg(target_os = "macos")]
+mod window;
+
+pub use error::{DriftStage, VisualError};
+pub use geometry::{
+    checked_pixel_dimensions, checked_pixel_extent, checked_rgba_len, validate_capture_frame,
+    validate_identity, CaptureRequest, CapturedFrame, PixelDimensions, WindowBounds,
+    WindowIdentity, MAX_CAPTURE_PIXELS, MAX_CAPTURE_SIDE, MAX_RGBA_BYTES,
+};
+pub use png::{encode_rgba_to_png, png_dimensions, verify_png_matches_dimensions};
+
+/// Public capture request entry.
+///
+/// The request is validated purely, then refused with
+/// [`VisualError::HostNotApproved`]. There is deliberately no boolean/env
+/// approval, no success stub and no fallback to native enumeration: the CG
+/// window facts and ScreenCaptureKit capture remain `pub(crate)` until a
+/// trusted Helper approval owner is wired in.
+pub fn request_window_capture(request: &CaptureRequest) -> Result<CapturedFrame, VisualError> {
+    request.validate()?;
+    Err(VisualError::HostNotApproved)
+}
diff --git a/crates/cua-macos-visual/src/observe.rs b/crates/cua-macos-visual/src/observe.rs
new file mode 100644
index 0000000..e4072e8
--- /dev/null
+++ b/crates/cua-macos-visual/src/observe.rs
@@ -0,0 +1,214 @@
+//! Pure observation orchestration shared by the crate-private native path.
+//!
+//! The caller injects every fact read and the capture step. This module owns
+//! the order of validation, so tests can prove that drift stops the pipeline
+//! before later stages or reselection run.
+
+use crate::error::{DriftStage, VisualError};
+use crate::geometry::{
+    checked_rgba_len, validate_capture_frame, validate_identity, validate_window_identity,
+    CapturedFrame, PixelDimensions, WindowIdentity,
+};
+use crate::png::verify_png_matches_dimensions;
+
+/// Pixel bytes returned by one capture step.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct RawFrame {
+    pub dimensions: PixelDimensions,
+    pub rgba: Vec<u8>,
+}
+
+/// Run one observation in a fixed order with injected facts.
+///
+/// Order: validate expected -> before identity -> select exact window ->
+/// capture -> RGBA length/geometry -> after identity -> encode -> bounded PNG
+/// decode -> form non-empty [`CapturedFrame`]. A failure never falls through to
+/// a later stage and never selects another window.
+pub(crate) fn observe_once<Before, Select, Capture, After, Encode, Token>(
+    expected: &WindowIdentity,
+    before: Before,
+    select: Select,
+    capture: Capture,
+    after: After,
+    encode: Encode,
+) -> Result<CapturedFrame, VisualError>
+where
+    Before: FnOnce() -> Result<WindowIdentity, VisualError>,
+    Select: FnOnce() -> Result<(WindowIdentity, Token), VisualError>,
+    Capture: FnOnce(Token) -> Result<RawFrame, VisualError>,
+    After: FnOnce() -> Result<WindowIdentity, VisualError>,
+    Encode: FnOnce(&RawFrame) -> Result<Vec<u8>, VisualError>,
+{
+    validate_window_identity(expected)?;
+
+    let before_identity = before()?;
+    validate_identity(expected, &before_identity, DriftStage::BeforeCapture)?;
+
+    let (selected_identity, token) = select()?;
+    validate_identity(expected, &selected_identity, DriftStage::SelectedWindow)?;
+
+    let raw = capture(token)?;
+    checked_rgba_len(raw.dimensions.width, raw.dimensions.height, raw.rgba.len())?;
+    validate_capture_frame(
+        expected.window_id,
+        &expected.bounds,
+        raw.dimensions.width,
+        raw.dimensions.height,
+    )?;
+
+    let after_identity = after()?;
+    validate_identity(expected, &after_identity, DriftStage::AfterCapture)?;
+
+    let png = encode(&raw)?;
+    verify_png_matches_dimensions(&png, raw.dimensions.width, raw.dimensions.height)?;
+    CapturedFrame::new(expected.window_id, raw.dimensions, png)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::geometry::{PixelDimensions, WindowBounds};
+    use crate::png::encode_rgba_to_png;
+    use std::cell::RefCell;
+
+    fn expected_for(width: u32, height: u32) -> WindowIdentity {
+        WindowIdentity::new(
+            11,
+            4242,
+            0,
+            WindowBounds::new(0.0, 0.0, f64::from(width), f64::from(height)),
+        )
+    }
+
+    fn raw_frame(width: u32, height: u32) -> RawFrame {
+        RawFrame {
+            dimensions: PixelDimensions { width, height },
+            rgba: vec![0x40; (width * height * 4) as usize],
+        }
+    }
+
+    fn run(
+        expected: WindowIdentity,
+        before: WindowIdentity,
+        selected: WindowIdentity,
+        after: WindowIdentity,
+        raw: RawFrame,
+        encode_empty: bool,
+    ) -> (Result<(), VisualError>, Vec<&'static str>) {
+        let log = RefCell::new(Vec::new());
+        let result = observe_once(
+            &expected,
+            || {
+                log.borrow_mut().push("before");
+                Ok(before)
+            },
+            || {
+                log.borrow_mut().push("select");
+                Ok((selected, ()))
+            },
+            |()| {
+                log.borrow_mut().push("capture");
+                Ok(raw)
+            },
+            || {
+                log.borrow_mut().push("after");
+                Ok(after)
+            },
+            |raw| {
+                log.borrow_mut().push("encode");
+                if encode_empty {
+                    Ok(Vec::new())
+                } else {
+                    encode_rgba_to_png(&raw.rgba, raw.dimensions.width, raw.dimensions.height)
+                }
+            },
+        )
+        .map(|frame| assert!(!frame.png().is_empty()));
+        (result, log.into_inner())
+    }
+
+    #[test]
+    fn stops_before_later_stages_on_before_or_selected_drift() {
+        let expected = expected_for(2, 2);
+        let bad = WindowIdentity::new(11, 9999, 0, expected.bounds);
+
+        let (result, log) = run(expected, bad, expected, expected, raw_frame(2, 2), false);
+        assert!(matches!(
+            result,
+            Err(VisualError::WindowDrift {
+                stage: DriftStage::BeforeCapture,
+                ..
+            })
+        ));
+        assert_eq!(log, vec!["before"]);
+
+        let (result, log) = run(expected, expected, bad, expected, raw_frame(2, 2), false);
+        assert!(matches!(
+            result,
+            Err(VisualError::WindowDrift {
+                stage: DriftStage::SelectedWindow,
+                ..
+            })
+        ));
+        assert_eq!(log, vec!["before", "select"]);
+    }
+
+    #[test]
+    fn stops_before_encode_on_after_drift() {
+        let expected = expected_for(2, 2);
+        let bad = WindowIdentity::new(11, 9999, 0, expected.bounds);
+        let (result, log) = run(expected, expected, expected, bad, raw_frame(2, 2), false);
+        assert!(matches!(
+            result,
+            Err(VisualError::WindowDrift {
+                stage: DriftStage::AfterCapture,
+                ..
+            })
+        ));
+        assert_eq!(log, vec!["before", "select", "capture", "after"]);
+    }
+
+    #[test]
+    fn bad_rgba_or_empty_png_never_forms_a_success_frame() {
+        let expected = expected_for(2, 2);
+        let bad_raw = RawFrame {
+            dimensions: PixelDimensions {
+                width: 2,
+                height: 2,
+            },
+            rgba: vec![0; 15],
+        };
+        let (result, log) = run(expected, expected, expected, expected, bad_raw, false);
+        assert!(matches!(
+            result,
+            Err(VisualError::RgbaLengthMismatch { .. })
+        ));
+        assert_eq!(log, vec!["before", "select", "capture"]);
+
+        let (result, log) = run(
+            expected,
+            expected,
+            expected,
+            expected,
+            raw_frame(2, 2),
+            true,
+        );
+        assert!(matches!(result, Err(VisualError::PngEncoding(_))));
+        assert_eq!(log, vec!["before", "select", "capture", "after", "encode"]);
+    }
+
+    #[test]
+    fn success_forms_a_non_empty_frame() {
+        let expected = expected_for(2, 2);
+        let (result, log) = run(
+            expected,
+            expected,
+            expected,
+            expected,
+            raw_frame(2, 2),
+            false,
+        );
+        assert_eq!(result, Ok(()));
+        assert_eq!(log, vec!["before", "select", "capture", "after", "encode"]);
+    }
+}
