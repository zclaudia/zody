index 0000000..8b07932
--- /dev/null
+++ b/crates/cua-macos-visual/src/png.rs
@@ -0,0 +1,355 @@
+//! PNG-only encoding, IHDR header parsing and bounded full-frame verification.
+
+use image::codecs::png::{PngDecoder, PngEncoder};
+use image::{ColorType, ImageDecoder, ImageEncoder, Limits};
+
+use crate::error::VisualError;
+use crate::geometry::{checked_pixel_dimensions, MAX_CAPTURE_SIDE, MAX_RGBA_BYTES};
+
+const PNG_SIGNATURE: [u8; 8] = [137, 80, 78, 71, 13, 10, 26, 10];
+/// Input PNG byte bound checked before the decoder reads any header/metadata.
+pub const MAX_PNG_BYTES: usize = MAX_RGBA_BYTES as usize + 4 * 1024 * 1024;
+const PNG_CHUNK_OVERHEAD: usize = 12;
+const PNG_IHDR_DATA_LEN: u32 = 13;
+const PNG_MAX_CHUNK_LEN: u32 = 0x7FFF_FFFF;
+
+const CRC_TABLE: [u32; 256] = make_crc_table();
+
+const fn make_crc_table() -> [u32; 256] {
+    let mut table = [0_u32; 256];
+    let mut index = 0;
+    while index < 256 {
+        let mut crc = index as u32;
+        let mut bit = 0;
+        while bit < 8 {
+            crc = if crc & 1 == 0 {
+                crc >> 1
+            } else {
+                0xEDB8_8320 ^ (crc >> 1)
+            };
+            bit += 1;
+        }
+        table[index] = crc;
+        index += 1;
+    }
+    table
+}
+
+fn crc32(bytes: &[u8]) -> u32 {
+    let mut crc = 0xFFFF_FFFF_u32;
+    for &byte in bytes {
+        let index = ((crc ^ u32::from(byte)) & 0xFF) as usize;
+        crc = CRC_TABLE[index] ^ (crc >> 8);
+    }
+    !crc
+}
+
+/// Parse width/height from the IHDR chunk only.
+///
+/// This is deliberately a header parser: 24 bytes are enough. It does not
+/// verify IDAT, CRC or pixel content. Use
+/// [`verify_png_matches_dimensions`] before accepting a frame.
+pub fn png_dimensions(data: &[u8]) -> Result<(u32, u32), VisualError> {
+    if data.len() < 24 {
+        return Err(VisualError::PngEncoding("PNG data too small".into()));
+    }
+    if data[..8] != PNG_SIGNATURE {
+        return Err(VisualError::PngEncoding("PNG signature mismatch".into()));
+    }
+    if &data[12..16] != b"IHDR" {
+        return Err(VisualError::PngEncoding("PNG missing IHDR chunk".into()));
+    }
+    let width = u32::from_be_bytes([data[16], data[17], data[18], data[19]]);
+    let height = u32::from_be_bytes([data[20], data[21], data[22], data[23]]);
+    if width == 0 || height == 0 || width > MAX_CAPTURE_SIDE || height > MAX_CAPTURE_SIDE {
+        return Err(VisualError::DimensionRejected {
+            label: "PNG dimensions",
+            value: f64::from(width.max(height)),
+        });
+    }
+    Ok((width, height))
+}
+
+/// Encode top-down, row-major RGBA bytes as a PNG.
+///
+/// `PngEncoder` writes directly from the caller's slice, avoiding an extra
+/// `rgba.to_vec()` clone. The encoded bytes are then fully decoded once by
+/// [`verify_png_matches_dimensions`] before being returned.
+pub fn encode_rgba_to_png(rgba: &[u8], width: u32, height: u32) -> Result<Vec<u8>, VisualError> {
+    let dims = checked_pixel_dimensions(width, height)?;
+    let expected = u64::from(dims.width) * u64::from(dims.height) * 4;
+    if rgba.len() as u64 != expected {
+        return Err(VisualError::RgbaLengthMismatch {
+            width,
+            height,
+            expected,
+            actual: rgba.len() as u64,
+        });
+    }
+    let mut output = Vec::new();
+    PngEncoder::new(&mut output)
+        .write_image(rgba, width, height, ColorType::Rgba8.into())
+        .map_err(|error| VisualError::PngEncoding(error.to_string()))?;
+    if output.is_empty() {
+        return Err(VisualError::PngEncoding(
+            "PNG encoder produced no bytes".into(),
+        ));
+    }
+    verify_png_matches_dimensions(&output, width, height)?;
+    Ok(output)
+}
+
+/// Verify one PNG's complete chunk container and then fully decode its pixels.
+///
+/// The input length is bounded before any decoder read. A bounded chunk walker
+/// verifies every chunk CRC, requires IHDR first, at least one IDAT, and a final
+/// zero-length IEND with no trailing bytes. Only then does `image` decode pixels
+/// under `Limits`; a 24-byte IHDR-only fake, truncation, bad chunk CRC, non-RGBA8
+/// colour type or wrong pixel byte count is rejected.
+pub fn verify_png_matches_dimensions(
+    png: &[u8],
+    width: u32,
+    height: u32,
+) -> Result<(), VisualError> {
+    decode_png_with_limits(png, width, height, png_limits(), MAX_PNG_BYTES)
+}
+
+fn png_limits() -> Limits {
+    // Limits is non-exhaustive; start from its default and tighten every field.
+    let mut limits = Limits::default();
+    limits.max_image_width = Some(MAX_CAPTURE_SIDE);
+    limits.max_image_height = Some(MAX_CAPTURE_SIDE);
+    limits.max_alloc = Some(MAX_RGBA_BYTES + 4 * 1024 * 1024);
+    limits
+}
+
+fn decode_png_with_limits(
+    png: &[u8],
+    width: u32,
+    height: u32,
+    limits: Limits,
+    max_input_bytes: usize,
+) -> Result<(), VisualError> {
+    checked_png_input(png, max_input_bytes)?;
+    checked_pixel_dimensions(width, height)?;
+    verify_png_container(png, max_input_bytes)?;
+
+    // image 0.25.10's PngDecoder::new uses Limits::no_limits(). Use with_limits
+    // so width/height/allocation budgets are set before read_info and metadata.
+    let decoder = PngDecoder::with_limits(std::io::Cursor::new(png), limits)
+        .map_err(|error| VisualError::PngEncoding(format!("PNG header rejected: {error}")))?;
+    let (actual_width, actual_height) = decoder.dimensions();
+    if actual_width != width || actual_height != height {
+        return Err(VisualError::PngMismatch {
+            expected_width: width,
+            expected_height: height,
+            actual_width,
+            actual_height,
+        });
+    }
+    let color = decoder.color_type();
+    if color != ColorType::Rgba8 {
+        return Err(VisualError::PngEncoding(format!(
+            "PNG colour type {color:?} is not RGBA8"
+        )));
+    }
+    let total_bytes = decoder.total_bytes();
+    let expected = u64::from(width) * u64::from(height) * 4;
+    if total_bytes != expected {
+        return Err(VisualError::PngEncoding(format!(
+            "PNG pixel payload {total_bytes} bytes != {expected}"
+        )));
+    }
+    if total_bytes > MAX_RGBA_BYTES {
+        return Err(VisualError::PixelBudgetExceeded {
+            width,
+            height,
+            pixels: u64::from(width) * u64::from(height),
+            max_pixels: MAX_RGBA_BYTES / 4,
+        });
+    }
+    let mut buffer = vec![0_u8; total_bytes as usize];
+    decoder
+        .read_image(&mut buffer)
+        .map_err(|error| VisualError::PngEncoding(format!("PNG pixel decode rejected: {error}")))?;
+    Ok(())
+}
+
+/// Walk the PNG chunk container under a byte bound before pixel decoding.
+///
+/// This is deliberately a closure check, not another image decoder: `image`
+/// still owns inflate/pixel decode. The walker rejects malformed lengths, bad
+/// chunk CRCs, a missing/early IEND, and any bytes after IEND. In particular,
+/// `image` may stop at the last IDAT and never observe IEND, so this check makes
+/// container truncation and trailing garbage explicit.
+fn verify_png_container(png: &[u8], max_input_bytes: usize) -> Result<(), VisualError> {
+    checked_png_input(png, max_input_bytes)?;
+
+    let mut offset = PNG_SIGNATURE.len();
+    let mut saw_ihdr = false;
+    let mut saw_idat = false;
+    let mut saw_iend = false;
+    while offset < png.len() {
+        if png.len() - offset < PNG_CHUNK_OVERHEAD {
+            return Err(png_container_error("truncated chunk header or CRC"));
+        }
+        let length = u32::from_be_bytes([
+            png[offset],
+            png[offset + 1],
+            png[offset + 2],
+            png[offset + 3],
+        ]);
+        if length > PNG_MAX_CHUNK_LEN {
+            return Err(png_container_error("chunk length exceeds the PNG limit"));
+        }
+        let chunk_len = length as usize;
+        let data_start = offset + 8;
+        let data_end = data_start
+            .checked_add(chunk_len)
+            .ok_or_else(|| png_container_error("chunk length overflow"))?;
+        let crc_end = data_end
+            .checked_add(4)
+            .ok_or_else(|| png_container_error("chunk CRC offset overflow"))?;
+        if crc_end > png.len() {
+            return Err(png_container_error("chunk extends past the input"));
+        }
+        let chunk_type = &png[offset + 4..data_start];
+        let stored_crc = u32::from_be_bytes([
+            png[data_end],
+            png[data_end + 1],
+            png[data_end + 2],
+            png[data_end + 3],
+        ]);
+        let actual_crc = crc32(&png[offset + 4..data_end]);
+        if stored_crc != actual_crc {
+            return Err(png_container_error("chunk CRC mismatch"));
+        }
+
+        if chunk_type == b"IHDR" {
+            if saw_ihdr || offset != PNG_SIGNATURE.len() {
+                return Err(png_container_error("IHDR must be the first chunk once"));
+            }
+            if length != PNG_IHDR_DATA_LEN {
+                return Err(png_container_error("IHDR has the wrong length"));
+            }
+            saw_ihdr = true;
+        } else if chunk_type == b"IDAT" {
+            if !saw_ihdr {
+                return Err(png_container_error("IDAT before IHDR"));
+            }
+            saw_idat = true;
+        } else if chunk_type == b"IEND" {
+            if length != 0 {
+                return Err(png_container_error("IEND has a non-zero length"));
+            }
+            if !saw_idat {
+                return Err(png_container_error("IEND before any IDAT"));
+            }
+            saw_iend = true;
+            offset = crc_end;
+            if offset != png.len() {
+                return Err(png_container_error("trailing bytes after IEND"));
+            }
+            break;
+        }
+        offset = crc_end;
+    }
+
+    if !saw_ihdr || !saw_idat || !saw_iend {
+        return Err(png_container_error("missing IHDR, IDAT or IEND"));
+    }
+    if offset != png.len() {
+        return Err(png_container_error("container ends before the input ends"));
+    }
+    Ok(())
+}
+
+fn checked_png_input(png: &[u8], max_input_bytes: usize) -> Result<(), VisualError> {
+    if png.is_empty() {
+        return Err(VisualError::PngEncoding(
+            "refusing to accept an empty PNG".into(),
+        ));
+    }
+    if png.len() > max_input_bytes {
+        return Err(VisualError::PngEncoding(format!(
+            "PNG input {} bytes over the {max_input_bytes} byte bound",
+            png.len()
+        )));
+    }
+    if png.len() < PNG_SIGNATURE.len() + PNG_CHUNK_OVERHEAD {
+        return Err(png_container_error("PNG is too short for a chunk"));
+    }
+    if png[..PNG_SIGNATURE.len()] != PNG_SIGNATURE {
+        return Err(png_container_error("signature mismatch"));
+    }
+    Ok(())
+}
+
+fn png_container_error(message: &'static str) -> VisualError {
+    VisualError::PngEncoding(format!("PNG container rejected: {message}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn input_length_is_bounded_before_the_decoder() {
+        let bytes = vec![0_u8; 32];
+        assert!(matches!(
+            decode_png_with_limits(&bytes, 1, 1, png_limits(), 16),
+            Err(VisualError::PngEncoding(_))
+        ));
+    }
+
+    #[test]
+    fn decoder_dimension_limit_applies_before_pixel_use() {
+        let png = encode_rgba_to_png(&vec![0_u8; 2 * 2 * 4], 2, 2).expect("encode");
+        let mut limits = png_limits();
+        limits.max_image_width = Some(1);
+        limits.max_image_height = Some(1);
+        assert!(decode_png_with_limits(&png, 2, 2, limits, MAX_PNG_BYTES).is_err());
+    }
+
+    #[test]
+    fn decoder_allocation_limit_is_enforced() {
+        let png = encode_rgba_to_png(&vec![0_u8; 8 * 8 * 4], 8, 8).expect("encode");
+        let mut limits = png_limits();
+        limits.max_alloc = Some(16);
+        assert!(decode_png_with_limits(&png, 8, 8, limits, MAX_PNG_BYTES).is_err());
+    }
+
+    #[test]
+    fn container_rejects_missing_iend_bad_iend_crc_and_trailing_bytes() {
+        let png = encode_rgba_to_png(&vec![0_u8; 2 * 2 * 4], 2, 2).expect("encode");
+        let iend = png
+            .windows(4)
+            .rposition(|window| window == b"IEND")
+            .expect("IEND");
+        assert_eq!(&png[iend..iend + 4], b"IEND");
+        assert_eq!(&png[iend - 4..iend], &[0_u8; 4], "IEND length zero");
+
+        let without_iend = &png[..png.len() - PNG_CHUNK_OVERHEAD];
+        assert!(verify_png_matches_dimensions(without_iend, 2, 2).is_err());
+
+        let mut bad_iend_crc = png.clone();
+        bad_iend_crc[iend + 4] ^= 0xFF;
+        assert!(verify_png_matches_dimensions(&bad_iend_crc, 2, 2).is_err());
+
+        let mut trailing = png.clone();
+        trailing.extend_from_slice(b"trailing");
+        assert!(verify_png_matches_dimensions(&trailing, 2, 2).is_err());
+    }
+
+    #[test]
+    fn every_truncation_of_a_real_png_is_rejected() {
+        let png = encode_rgba_to_png(&vec![0_u8; 2 * 2 * 4], 2, 2).expect("encode");
+        for cut in 0..png.len() {
+            assert!(
+                verify_png_matches_dimensions(&png[..cut], 2, 2).is_err(),
+                "truncation at {cut} was accepted"
+            );
+        }
+        assert_eq!(verify_png_matches_dimensions(&png, 2, 2), Ok(()));
+    }
+}
