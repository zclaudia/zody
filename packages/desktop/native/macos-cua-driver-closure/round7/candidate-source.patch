diff --git a/crates/cua-driver-core/tests/round7_dependency_boundaries.rs b/crates/cua-driver-core/tests/round7_dependency_boundaries.rs
new file mode 100644
index 00000000..2240b0e1
--- /dev/null
+++ b/crates/cua-driver-core/tests/round7_dependency_boundaries.rs
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: MIT
+// Round 7 uses this isolated, pure regression target only. It never dispatches
+// a native tool and never starts the upstream application.
+
+#![cfg(feature = "yaml")]
+
+use std::fs;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use cua_driver_core::policy::{PolicyDecision, PolicyEngine};
+use cua_driver_core::tool::ToolRegistry;
+
+static TEMP_COUNTER: AtomicU64 = AtomicU64::new(0);
+
+struct TempPolicy(PathBuf);
+
+impl TempPolicy {
+    fn new(extension: &str, contents: &str) -> Self {
+        let serial = TEMP_COUNTER.fetch_add(1, Ordering::Relaxed);
+        let path = std::env::temp_dir().join(format!(
+            "zody-cua-round7-{}-{}-{}.{}",
+            std::process::id(),
+            std::thread::current().name().unwrap_or("test"),
+            serial,
+            extension
+        ));
+        fs::write(&path, contents).expect("write temporary policy");
+        Self(path)
+    }
+
+    fn path(&self) -> &std::path::Path {
+        &self.0
+    }
+}
+
+impl Drop for TempPolicy {
+    fn drop(&mut self) {
+        let _ = fs::remove_file(&self.0);
+    }
+}
+
+#[cfg(not(feature = "rego"))]
+#[test]
+fn explicit_rego_policy_is_rejected_without_rego_feature() {
+    let policy = TempPolicy::new(
+        "rego",
+        "package cua.policy\n\ndefault allow := false\nallow := true\n",
+    );
+    let error = PolicyEngine::load(policy.path())
+        .expect_err("Rego must not load when the feature is disabled")
+        .to_string();
+    assert!(error.contains("Rego policy support is not enabled"), "{error}");
+}
+
+#[test]
+fn yaml_explicit_deny_stays_deny() {
+    let policy = TempPolicy::new(
+        "yaml",
+        "allow:\n  tools: [screenshot]\ndeny:\n  tools: [click]\n",
+    );
+    let engine = PolicyEngine::load(policy.path())
+        .expect("YAML policy loads")
+        .expect("YAML policy is enabled");
+    assert!(matches!(
+        engine.evaluate("click", &serde_json::json!({})),
+        PolicyDecision::Deny(_)
+    ));
+}
+
+#[cfg(not(feature = "script"))]
+#[test]
+fn disabled_script_feature_does_not_register_run_script() {
+    // Registration only constructs in-process values; it invokes no tool and
+    // crosses no native or system input boundary.
+    let mut registry = ToolRegistry::new();
+    registry.register_session_tools();
+    let names = registry.tool_names().collect::<Vec<_>>();
+    assert!(!names.contains(&"run_script"), "{names:?}");
+    assert!(names.contains(&"run_steps"), "{names:?}");
+}
