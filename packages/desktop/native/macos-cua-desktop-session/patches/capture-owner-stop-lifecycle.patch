+stop_visual::AuthorityStopFact classify_authority_close(const std::string& reason) {
+  return reason == "authority-eof" ? stop_visual::AuthorityStopFact::AuthorityEof
+                                   : stop_visual::AuthorityStopFact::AuthorityError;
+}
+
+// 事实只做审计；唯一取消锁存仍是 revoked。三种停止事实都必须 fail-closed。
+void record_authority_stop(CheckpointContext& context, stop_visual::AuthorityStopFact fact) {
+  int expected = static_cast<int>(stop_visual::AuthorityStopFact::None);
+  (void)context.authority_stop.compare_exchange_strong(expected, static_cast<int>(fact));
+  context.revoked.store(true);
+}
+
+void log_json_event(const char* name, NSDictionary* payload) {
+  NSError* error = nil;
+  NSData* data = [NSJSONSerialization dataWithJSONObject:payload options:0 error:&error];
+  if (data == nil || data.length == 0) {
+    std::fprintf(stderr, "[cua-native] %s {\"serializationError\":true}\n", name);
+    std::fflush(stderr);
+    return;
+  }
+  const std::string json(static_cast<const char*>(data.bytes), data.length);
+  std::fprintf(stderr, "[cua-native] %s %s\n", name, json.c_str());
+  std::fflush(stderr);
+}
+
+void log_stop_facts(const CheckpointContext& context, const CaptureOutcome& outcome) {
+  log_json_event(
+      "visual-stop-facts",
+      @{
+        @"traceId" : context.trace_id == nil ? @"" : context.trace_id,
+        @"operationId" : @(static_cast<unsigned long long>(context.observed_operation.load())),
+        @"authorityStop" :
+            [NSString stringWithUTF8String:stop_visual::authority_stop_name(outcome.authority_stop)],
+        @"visualStarted" : @(outcome.visual_started),
+        @"visualWaitReturned" : @(outcome.visual_wait_returned),
+        @"osSubmitted" : @(outcome.os_submitted),
+        @"callbackRelease" : [NSString
+            stringWithUTF8String:stop_visual::callback_release_name(outcome.callback_release)],
+        @"lateFrameDropped" : @(outcome.late_frame_dropped),
+        @"resourcesReleased" : @(outcome.resources_released),
+        @"actualCallbackReleased" :
+            @(stop_visual::actual_callback_released(outcome.callback_release)),
+        @"reason" : [NSString stringWithUTF8String:outcome.reason.c_str()] ?: @"",
+      });
+}
