+    /// Publish the real Swift submit-return fact without re-entering admission.
+    /// The notifier is selected by the session observation id and invokes the
+    /// native callback with the separate helper operation id it captured.
+    pub(crate) fn notify_submit(&self, id: u64, actual: WindowIdentity) -> bool {
+        let notifier = {
+            let registry = lock_registry(&self.registry);
+            let Some(entry) = registry.entries.get(&id) else {
+                return false;
+            };
+            if entry.phase != Phase::Capturing || entry.selected != Some(actual) {
+                return false;
