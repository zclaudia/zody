+        id: u64,
+        timeout: Duration,
+    ) -> DiagnosticGateWait {
+        let signal = {
+            let registry = lock_registry(&self.registry);
+            let Some(entry) = registry.entries.get(&id) else {
+                return DiagnosticGateWait::Missing;
+            };
+            Arc::clone(&entry.signal)
+        };
+        let mut state = lock_signal(&signal);
+        if state.canceled {
+            return DiagnosticGateWait::Stopped;
+        }
+        let (next, _) = signal
+            .changed
+            .wait_timeout_while(state, timeout, |state| !state.canceled)
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        state = next;
+        if state.canceled {
+            DiagnosticGateWait::Stopped
+        } else {
+            DiagnosticGateWait::TimedOut
         }
