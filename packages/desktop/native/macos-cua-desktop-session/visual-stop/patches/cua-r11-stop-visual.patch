+          let rgba = renderRGBA(image: image, maxSide: maxSide, maxBytes: maxBytes) else {
+        return CuaPreparedCompletion(status: .imageInvalid, width: 0, height: 0, rgba: nil)
+    }
+    return CuaPreparedCompletion(
+        status: .success,
+        width: outputWidth,
+        height: outputHeight,
+        rgba: rgba
+    )
