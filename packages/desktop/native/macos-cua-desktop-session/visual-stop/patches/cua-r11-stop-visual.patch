+// OS completion may arrive before captureImage returns. Store exactly one real
+// image/error without rendering, and let a separate consumer wait for both the
+// submit-return publication and completion. This keeps the framework callback
+// thread from blocking on Stop/diagnostic state.
+private final class CompletionMailbox {
+    private let condition = NSCondition()
+    private var submitted = false
+    private var stored = false
+    private var consumed = false
+    private var discarded = false
+    private var image: CGImage?
+    private var error: Error?
+
+    func store(image: CGImage?, error: Error?) {
+        condition.lock()
+        defer { condition.unlock() }
+        guard !stored, !discarded else { return }
+        self.image = image
+        self.error = error
+        self.stored = true
+        condition.broadcast()
+    }
+
+    func publishSubmit() {
+        condition.lock()
+        submitted = true
+        condition.broadcast()
+        condition.unlock()
+    }
+
+    /// Wait for both the real completion and submit-return publication without
+    /// taking or clearing the held image/error.
+    func waitReadyAfterSubmit() {
+        condition.lock()
+        defer { condition.unlock() }
+        while !submitted || !stored {
+            condition.wait()
+        }
+    }
+
+    /// Consume-and-clear exactly once for the normal render path.
+    func takeHeldCompletion() -> (CGImage?, Error?) {
+        condition.lock()
+        defer { condition.unlock() }
+        guard !consumed, !discarded else { return (nil, nil) }
+        consumed = true
+        let result = (image, error)
+        image = nil
+        error = nil
+        return result
+    }
+
+    /// Drop held bridge-owned image/error without rendering or success. A late
+    /// store after discard is ignored so no new reference is retained.
+    func discard() {
+        condition.lock()
+        defer { condition.unlock() }
+        discarded = true
+        consumed = true
+        image = nil
+        error = nil
+    }
+}
