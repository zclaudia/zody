{
  "manifest_version": 3,
  "name": "Zody Browser Bridge",
  "version": "0.1.0",
  "description": "Connects this Chrome profile to Zody so the agent can control tabs you authorize.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "storage", "offscreen"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Zody Browser Bridge",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*"
  }
}
