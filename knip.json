{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-lintignore"
  ],
  "workspaces": {
    ".": {},
    "packages/desktop": {
      // T0.1 只引入依赖与 tsup 内联配置，还没有 import；gateway-backend/protocol 由 T3.2、
      // gateway-client 由桌面 E2E 里的手机端用例消费。对应代码落码后移除本 ignore。
      "ignoreDependencies": [
        "@zclaudia/gateway-backend",
        "@zclaudia/gateway-protocol",
        "@zclaudia/gateway-client"
      ]
    },
    "packages/web": {
      // 同上：由 T3.4 的 GatewayTerminalTransport 消费。
      "ignoreDependencies": ["@zclaudia/gateway-client"],
      // 手机入口由 mobile.html 引用（HTML 入口，不是 TS import），显式声明为 entry（T1.2）。
      "entry": ["src/mobile-remote/main.tsx"]
    }
  },
  "ignore": [".agents/**", ".claude/**", "docs/**", "packages/ui/src/components/**"]
}
