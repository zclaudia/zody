{
  "name": "@zody/node-repl-host",
  "version": "0.6.1",
  "private": true,
  "description": "Shared node_repl MCP host. Owns the JS execution surface and the domain bridges (Browser Use, Computer Use) that ride on it; the official plugins contribute only their own skills, docs and runtime assets.",
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./cua-bridge": "./src/cua-bridge.ts",
    "./browser-bridge": "./src/browser-bridge.ts",
    "./cua-broker": "./src/cua-broker.ts",
    "./cua-capture-runtime": "./src/cua-capture-runtime.ts",
    "./cua-node-repl-mcp-port": "./src/cua-node-repl-mcp-port.ts",
    "./sealed-resource": "./src/sealed-resource.ts",
    "./result": "./src/result.ts",
    "./tool-contract": "./src/tool-contract.ts",
    "./runtime-bridge": "./src/runtime-bridge.ts",
    "./subprocess-executor": "./src/subprocess-executor.ts"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "d06:diagnostic": "node --import tsx scripts/d06-diagnostic.ts",
    "d06:round5": "node --import tsx scripts/d06-round5.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test",
    "lint": "oxlint src --no-ignore"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@zody/contracts": "workspace:*",
    "@zody/core": "workspace:*",
    "@zody/shared": "workspace:*",
    "@zody/zody-cua": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  }
}
