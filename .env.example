# Zody: optional local overrides. Copy to .env or .env.local; never commit credentials.
# Existing ZCODE_* names are internal compatibility interfaces.

# Explicit release environment; dev scripts select their own mode.
# ZCODE_ENV=production

# Optional self-hosted product endpoint; empty disables endpoint-dependent features.
# ZCODE_BASE_URL=https://service.example.com

# User data parent directory; Zody stores data in its .zody subdirectory.
# ZCODE_DATA_BASE_DIR=/path/to/isolated-home
# ZCODE_SERVER_WORKSPACE=/path/to/workspace
# Non-loopback HTTP listeners require a token. Do not commit its actual value.
# ZCODE_SERVER_AUTH_TOKEN=

# Optional local provider configuration; empty uses bundled configuration.
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# Optional font mirror for document skills. No upstream CDN fallback.
# ZCODE_OFFICE_FONTS_BASE_URL=https://fonts.example.com/office-skill/fonts

# Legacy manual binary preparation overrides, not required by build:zody.
# ZCODE_DEPS_BASE_URL=https://assets.example.com/deps
# GLM_BINARY_DOWNLOAD_BASE_URL=https://assets.example.com/agent-runtime
# INTRANET_MACHINE_HOST=

# SSH/WSL uses bundled local assets; no CDN override. CLI archives need no download base URL.
# Automatic updates, ARMS/event reporting, and packaged Agent OTEL are disabled.
